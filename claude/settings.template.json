{
  "plansDirectory": ".agent-harness/plans",
  "useAutoModeDuringPlan": true,
  "showThinkingSummaries": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" }
      ]
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gh"],
      "allowWrite": []
    }
  },
  "permissions": {
    "allow": [
      "Read(~/**)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Bash(jq *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(uname *)",
      "Bash(sw_vers *)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(type *)",
      "Bash(command -v *)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npm outdated *)",
      "Bash(pnpm ls *)",
      "Bash(cargo metadata *)",
      "Bash(cargo tree *)",
      "Bash(uv pip list *)",
      "Bash(uv tree *)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:opensource.org)",
      "WebFetch(domain:spdx.org)",
      "WebFetch(domain:choosealicense.com)"
    ]
  }
}
