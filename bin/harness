# --------------------------------------------------------------------------- io helpers


def read_json(path: Path) -> Optional[Dict[str, Any]]:
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{path} is not valid JSON ({exc}); fix it or remove it and re-run")


def write_json_atomic(path: Path, data: Dict[str, Any], expect_mtime: Optional[float] = None, backup: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if expect_mtime is not None and path.exists() and abs(path.stat().st_mtime - expect_mtime) > 1e-6:
        raise SystemExit(f"{path} changed while harness was running; nothing written. Re-run.")
    if backup and path.exists():
        shutil.copy2(path, path.with_suffix(path.suffix + ".bak"))
    tmp = path.with_name(path.name + ".harness-tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


def say(msg: str) -> None:
    if os.environ.get("HARNESS_QUIET"):
        return
    print(msg)


# --------------------------------------------------------------------------- config


# The environment a session scopes its own selection with; sync projects user defaults without it.
SESSION_SCOPED = ("HARNESS_PROJECT_CONFIG", "HARNESS_SESSION_CONFIG", "HARNESS_MODE", "HARNESS_PERMISSIONS")


def user_defaults_env(env: Optional[Dict[str, str]] = None) -> Dict[str, str]:
    """`env` without the layers a session scopes to itself, which is what a sync projects.

    The resolver still decides precedence; this only chooses which layers it is handed, so a
    session override never rewrites the user's global selection.
    """
    env = os.environ if env is None else env
    return {key: value for key, value in env.items()
            if not key.startswith(("HARNESS_STANCE_", "HARNESS_IDENTITY_")) and key not in SESSION_SCOPED}


def selection_override(env: Optional[Dict[str, str]] = None) -> bool:
    """Whether a project or session layer changes a stance here, which a sync never links.

    Asks the resolver for the stances with and without those layers, so a blank variable, an
    identity override or a config that names no stance does not count.
    """
    env = os.environ if env is None else env
    module = load_posture()
    if module is None:
        return False
    user = read_json(config_path()) or {}
    try:
        full = module.selection(env, strict=False, config=user, root=REPO)["stances"]
        base = module.selection(user_defaults_env(env), strict=False, config=user, root=REPO)["stances"]
    except (OSError, ValueError, KeyError):
        return False
    return full != base


def load_config(env: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
    env = os.environ if env is None else env
    base = read_json(REPO / "config.example.json") or {}
    user = read_json(config_path()) or {}
    cfg = deepcopy(base)
    for key, value in user.items():
        if key == "integrations":
            cfg[key] = integrations.merge_slots(cfg.get(key, {}), value)
        elif isinstance(value, dict) and isinstance(cfg.get(key), dict):
            cfg[key].update(value)
        else:
            cfg[key] = value
    cfg.setdefault("identity", {})
    # The stances in force are the resolver's answer and nothing else: no layer is merged here,
    # so the CLI and the hooks cannot hold two answers for one selection (AD-2).
    cfg["stances"] = {name: value for name, value in load_selection(env, user)["stances"].items()
                      if value is not None}
    for key, value in env.items():
        if key.startswith("HARNESS_IDENTITY_"):
            cfg["identity"][key[len("HARNESS_IDENTITY_"):].lower()] = value
        elif key == "HARNESS_PERMISSIONS":
            cfg["permissions"] = value
        elif key == "HARNESS_MANAGE_VSCODE":
            cfg.setdefault("vscode", {})["manage"] = value not in ("0", "false", "no")
        elif key == "HARNESS_MANAGE_CODEX":
            cfg.setdefault("codex", {})["manage"] = value not in ("0", "false", "no")
    return cfg


def load_selection(env: Optional[Dict[str, str]] = None, user: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """Every unit of every kind with its value and source, from `posture.selection`.

    `user` is the user configuration when the caller has read it; the resolver reads it
    otherwise. Strict, because a command that acts on a selection must not act on part of one.
    """
    env = os.environ if env is None else env
    module = load_posture()
    if module is None:
        raise SystemExit("this checkout has no selection resolver (policy/hooks/posture.py)")
    try:
        user = (read_json(config_path()) or {}) if user is None else user
        return module.selection(env, strict=True, config=user, root=REPO)
    except (OSError, ValueError) as exc:
        raise SystemExit(str(exc))


def example_config() -> Dict[str, Any]:
    return read_json(REPO / "config.example.json") or {}


def stance_variants(name: str) -> List[str]:
    return sorted(p.stem for p in (REPO / "primitives" / "stances" / name).glob("*.md"))


def placeholder_identity(cfg: Dict[str, Any]) -> List[str]:
    """Identity fields still carrying the example file's value.

    `load_config` falls back to `config.example.json` for anything the user's config omits, and
    `render_personal` writes whatever it resolves into `~/.claude/CLAUDE.personal.md`, which is
    always-loaded context. An unedited config therefore has the agent address you by a
    placeholder name and believe a placeholder role, with nothing on screen to say so.
    """
    example = example_config().get("identity", {})
    resolved = cfg.get("identity", {})
    return [k for k in PLACEHOLDER_IDENTITY_KEYS
            if k in example and str(resolved.get(k, example[k])).strip() == str(example[k]).strip()]


def resolve_stances(cfg: Dict[str, Any], strict: bool = True) -> Dict[str, Path]:
    try:
        return primitive_catalog.resolve_stances(REPO, cfg, strict=strict)
    except ValueError as exc:
        raise SystemExit(str(exc))


def stance_conflicts(cfg: Dict[str, Any]) -> List[str]:
    """Which shipped constraints this selection violates; a sync still refuses to run on one."""
    try:
        return primitive_catalog.stance_conflicts(REPO, cfg)
    except ValueError as exc:
        return ["stance constraints unreadable: " + str(exc)]


def cost_table(cfg: Dict[str, Any]) -> Dict[str, Any]:
    """The configured cost variant's resolved table, never a reason for a sync to fail.

    Built from the loaded configuration rather than the environment directly, because a sync
    projects user defaults and a session's `HARNESS_STANCE_*` stays in the session.
    """
    return primitive_catalog.cost_table(REPO, cfg)


def agent_row(table: Dict[str, Any], role: str) -> Optional[Dict[str, Any]]:
    """The cost row that governs one role, band rows included; the resolver decides which."""
    return primitive_catalog.cost_row(REPO, table, role)


def agent_overrides(cfg: Dict[str, Any], table: Dict[str, Any], runtime: str, role: str) -> Dict[str, Any]:
    """The overrides one role's native definition is rendered with, for either runtime."""
    return primitive_catalog.cost_overrides(REPO, cfg, table, runtime, role)


def _agent_change(table: Dict[str, Any], role: str, content: str) -> str:
    """How a rendered agent definition differs from the committed one, in one phrase.

    The committed projection is the `balanced` rendering, so this line appears only when the
    active variant, or a `role_bindings` entry, actually moved the role.
    """
    fields = {k.strip(): v.strip() for k, _, v in
              (line.partition(":") for line in content.split("---", 2)[1].strip().splitlines())}
    klass = (agent_row(table, role) or {}).get("class")
    model = (klass + " -> " if klass and table.get("class_applies") else "") + fields.get("model", "inherit")
    return model + ", effort " + fields.get("effort", "")


def posture(cfg: Dict[str, Any]) -> str:
    value = cfg.get("permissions", "inherit")
    if value not in ("inherit",) and value not in POSTURES:
        raise SystemExit(f"permissions must be inherit, bypass, auto or manual; got '{value}'")
    if value == "bypass" and cfg.get("permissions_bypass_acknowledged") is not True:
        raise SystemExit(
            "permissions=bypass turns off every permission prompt in Claude Code and VS Code and puts "
            "Codex in danger-full-access with no sandbox. Never use it on a machine that touches "
            "regulated or customer data. To confirm you mean it, set "
            "\"permissions_bypass_acknowledged\": true in ~/.config/agent-harness/config.json."
        )
    return value


