# Which hook entries are the harness's own is decided once, in the reconciler, because
# the ownership journal needs the same answer at sync, drift and uninstall.
_hook_marker = reconcile.hook_marker
_is_harness_entry = reconcile.is_harness_hook_entry


# Claude Code's own output styles a `voice` variant selects by name; no style text is copied.
BUILTIN_OUTPUT_STYLES = {"concise": "Concise"}


def harness_output_styles() -> Dict[str, str]:
    """The output styles this checkout ships, as voice variant -> the style's own name.

    `claude/output-styles/<variant>.md` is the file-backed registry: a `voice` variant gets an
    output style when a file is named after it. A variant may instead select one of Claude Code's
    built-in styles through `BUILTIN_OUTPUT_STYLES`; those are kept out of this function because
    the unrecorded-journal strip removes every name it returns, and a user's own built-in choice
    must survive that. A variant with neither imposes its shape through its stance text alone;
    `scannable` is the only variant with presentation material on Codex, and the Codex
    projection names it explicitly in `render_codex_agents`.
    """
    styles: Dict[str, str] = {}
    for path in sorted((REPO / "claude" / "output-styles").glob("*.md")):
        name, fence = path.stem, 0
        for line in path.read_text(encoding="utf-8").splitlines():
            if line.strip() == "---":
                fence += 1
                if fence == 2:
                    break
            elif fence == 1 and line.startswith("name:"):
                name = line.split(":", 1)[1].strip().strip("\"'") or path.stem
        styles[path.stem] = name
    return styles


def voice_output_style(cfg: Dict[str, Any]) -> Optional[str]:
    """The output style the configured `voice` selects, or `None` when it selects none."""
    variant = (cfg.get("stances") or {}).get("voice")
    if not variant:
        return None
    return harness_output_styles().get(variant) or BUILTIN_OUTPUT_STYLES.get(variant)


OUTPUT_STYLE_PATH = json.dumps(["outputStyle"])
UNRECORDED = object()  # "nobody read the journal", distinct from "the journal records nothing"


def installed_output_style(held: Optional[Dict[str, Any]] = None) -> Optional[str]:
    """The style `harness sync` recorded writing, or `None` if it never wrote one.

    Ownership of `outputStyle` is what the reconciliation journal says the harness installed,
    never what the value is called: a user who chose `Scannable` themselves before ever
    installing the harness owns that value, and no sync or uninstall may take it away.
    `held` is the journal's key record for the settings file; read from the store when omitted.
    """
    if held is None:
        settings_file = claude_dir() / "settings.json"
        record = reconcile.Store(state_dir(), dry=True).data["files"].get(str(settings_file), {})
        held = record.get("keys", {})
    applied = (held.get(OUTPUT_STYLE_PATH) or {}).get("applied") or {}
    return applied.get("value") if applied.get("present") else None


def merge_claude_settings(live: Dict[str, Any], template: Dict[str, Any], cfg: Dict[str, Any],
                          retired: Iterable[str] = (), installed: Optional[str] = None) -> Dict[str, Any]:
    """`retired` names allow rules an earlier template added that this one no longer carries;
    they are removed so a rule withdrawn upstream does not outlive it in a user's settings.
    `installed` is the output style the journal says a previous sync wrote, the only value a
    variant that installs none is allowed to remove."""
    out = deepcopy(live) if live else {}
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    owned = ownership.get("claude", {}).get("owned_keys", [])
    for key in owned:
        if key in template:
            out[key] = template[key]
    # `outputStyle` comes from the `voice` stance, not from the template: selecting a variant
    # with no style of its own removes the one an earlier selection installed, and a value the
    # harness is not recorded as having written is left exactly as it is.
    style = voice_output_style(cfg)
    if style:
        out["outputStyle"] = style
    elif installed is not None and out.get("outputStyle") == installed:
        out.pop("outputStyle", None)
    perms = out.setdefault("permissions", {})
    p = posture(cfg)
    if p != "inherit":
        perms["defaultMode"] = POSTURES[p]["claude"]
    allow = [r for r in perms.get("allow", []) if r not in set(retired)]
    for rule in template.get("permissions", {}).get("allow", []):
        if rule not in allow:
            allow.append(rule)
    perms["allow"] = allow
    hooks = out.setdefault("hooks", {})
    plan_variant = cfg["stances"].get("plan-ceremony")
    hook_ids = ownership.get("claude", {}).get("hook_ids", {})
    for event, entries in template.get("hooks", {}).items():
        kept = [e for e in hooks.get(event, []) if not _is_harness_entry(e)]
        for entry in entries:
            hid = _hook_marker(entry)
            spec = hook_ids.get(hid, {})
            if spec.get("stance") and cfg["stances"].get(spec["stance"]) != spec.get("variant"):
                continue
            kept.append(deepcopy(entry))
        if kept:
            hooks[event] = kept
        elif event in hooks:
            del hooks[event]
    # Drop harness entries from events the template no longer defines.
    for event in list(hooks.keys()):
        if event not in template.get("hooks", {}):
            hooks[event] = [e for e in hooks[event] if not _is_harness_entry(e)]
            if not hooks[event]:
                del hooks[event]
    if not hooks:
        out.pop("hooks", None)
    return out


def strip_claude_settings(live: Dict[str, Any], template: Dict[str, Any],
                          installed: Any = UNRECORDED) -> Dict[str, Any]:
    """Undo the harness's settings material. Only reached for a file the reconciliation journal
    does not hold — anything it holds is undone by the store, which restores the prior value.

    `installed` is the output style the journal says was written; `None` means the harness wrote
    none, so whatever style is there is the user's and stays. Left at `UNRECORDED` — no caller
    consulted the journal — the styles this checkout ships are removed, which is what an install
    older than the journal leaves behind.
    """
    out = deepcopy(live) if live else {}
    shipped = set(harness_output_styles().values()) if installed is UNRECORDED else {installed}
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    for key in ownership.get("claude", {}).get("owned_keys", []):
        if key == "outputStyle" and out.get(key) not in shipped:
            continue
        out.pop(key, None)
    perms = out.get("permissions", {})
    if "allow" in perms:
        tmpl = set(template.get("permissions", {}).get("allow", []))
        perms["allow"] = [r for r in perms["allow"] if r not in tmpl]
    hooks = out.get("hooks", {})
    for event in list(hooks.keys()):
        hooks[event] = [e for e in hooks[event] if not _is_harness_entry(e)]
        if not hooks[event]:
            del hooks[event]
    if not hooks:
        out.pop("hooks", None)
    return out


def retired_allow_rules(applied: Dict[str, Any], template: Dict[str, Any]) -> List[str]:
    """Allow rules the last synced template carried that the current template has dropped."""
    previous = (applied.get("template") or {}).get("allow") or []
    current = set(template.get("permissions", {}).get("allow", []))
    return [r for r in previous if r not in current]


def claude_projection(settings: Dict[str, Any], template: Dict[str, Any],
                      installed: Optional[str] = None) -> Dict[str, Any]:
    """The slice of a settings file the harness cares about, for diffing.

    `installed` is the output style the harness wrote, so a style it did not write is left out
    of both the applied record and the drift report rather than counted as harness material.
    """
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    owned = ownership.get("claude", {}).get("owned_keys", [])
    proj: Dict[str, Any] = {"keys": {k: settings.get(k) for k in owned}}
    if installed is None:
        proj["keys"]["outputStyle"] = None
    proj["defaultMode"] = settings.get("permissions", {}).get("defaultMode")
    proj["allow"] = sorted(settings.get("permissions", {}).get("allow", []))
    proj["hooks"] = sorted(
        h for entries in settings.get("hooks", {}).values() for e in entries for h in [_hook_marker(e)] if h
    )
    return proj


# ------------------------------------------------------- native telemetry pass-through
#
# `telemetry.native` asks each runtime to export its own telemetry to the endpoint the ledger
# exporter already uses. Nothing here sends anything: it writes the runtime's settings and
# records what it wrote, so the same key can be updated and taken back out. docs/telemetry.md.

UNMANAGED = object()  # "this caller manages no such key", distinct from "remove the key"
OTEL_HEADERS_HELPER = "otel-headers.py"
# Claude Code offers grpc, http/json and http/protobuf against a base URL and appends the signal
# path itself; protobuf is the one an OTLP/HTTP collector always accepts.
CLAUDE_OTEL_PROTOCOL = "http/protobuf"
# Codex takes a full, signal-specific URL per exporter and `binary` for OTLP/protobuf.
CODEX_OTEL_PROTOCOL = "binary"
# `OTEL_RESOURCE_ATTRIBUTES` is a comma-separated `key=value` list with no escape the runtimes
# agree on, so a label carrying a separator or whitespace is left out and named, never mangled.
OTEL_LABEL_SAFE = re.compile(r"^[A-Za-z0-9_.:/@+-]+$")


def native_runtimes(telemetry: Dict[str, Any]) -> List[str]:
    """The runtimes `telemetry.native` asks to export their own telemetry.

    Resolved by `claude/hooks/telemetry.py`, which both validates the key and owns the list of
    names, rather than by a second copy of that list here: a runtime added there is configurable
    from this side with no further change, and a value it refuses is refused here too, so a
    block assembled by hand means what the same block in a config file means. A checkout with no
    hook file exports nothing natively, so there is nothing for it to name.
    """
    module = load_telemetry()
    if module is None:
        return []
    return list(module.native_runtimes(telemetry.get("native", False)))


def native_labels(cfg: Dict[str, Any], telemetry: Dict[str, Any]) -> Tuple[Dict[str, str], List[str]]:
    """The labels stamped on native telemetry, and the names of any that cannot travel.

    Frozen at sync time: the harness version, one `harness.<dimension>` per resolved stance,
    and the configured labels. A stance switched without a re-sync mislabels native data until
    the next one — the ledger row is still right, because it is written per session.
    """
    labels = {"harness.version": VERSION}
    for name, variant in (cfg.get("stances") or {}).items():
        labels["harness." + str(name)] = str(variant)
    for key, value in ((telemetry.get("labels") or {})).items():
        labels[str(key)] = str(value)
    omitted = sorted(k for k, v in labels.items()
                     if not OTEL_LABEL_SAFE.match(k) or not OTEL_LABEL_SAFE.match(v))
    return {k: v for k, v in sorted(labels.items()) if k not in omitted}, omitted


def resource_attributes(cfg: Dict[str, Any], telemetry: Dict[str, Any]) -> Tuple[str, List[str]]:
    labels, omitted = native_labels(cfg, telemetry)
    return ",".join("{}={}".format(k, v) for k, v in sorted(labels.items())), omitted


def claude_native_values(telemetry: Dict[str, Any], cfg: Dict[str, Any]) -> Tuple[Dict[Tuple[str, ...], str], List[str]]:
    """Every Claude settings field the pass-through sets, by path, and the labels left out."""
    if "claude-code" not in native_runtimes(telemetry):
        return {}, []
    attributes, omitted = resource_attributes(cfg, telemetry)
    values = {("env", "CLAUDE_CODE_ENABLE_TELEMETRY"): "1",
              ("env", "OTEL_METRICS_EXPORTER"): "otlp",
              ("env", "OTEL_LOGS_EXPORTER"): "otlp",
              ("env", "OTEL_EXPORTER_OTLP_PROTOCOL"): CLAUDE_OTEL_PROTOCOL,
              ("env", "OTEL_EXPORTER_OTLP_ENDPOINT"): telemetry.get("endpoint", ""),
              ("env", "OTEL_RESOURCE_ATTRIBUTES"): attributes}
    if telemetry.get("headers_file") or telemetry.get("headers_env"):
        # The helper reads the configured source at run time, so no header value is ever written
        # into a settings file. With no source configured the key is not written at all.
        values[("otelHeadersHelper",)] = str(claude_dir() / "hooks" / "harness" / OTEL_HEADERS_HELPER)
    return values, omitted


# Claude Code loads an `--add-dir` folder's CLAUDE.md and rules only with this set; docs/workspaces.md.
WORKSPACE_ENV = "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD"


def claude_workspace_values(cfg: Dict[str, Any]) -> Dict[Tuple[str, ...], str]:
    """The Claude settings field workspace support sets, while `workspaces_dir` is set."""
    value = cfg.get("workspaces_dir")
    return {("env", WORKSPACE_ENV): "1"} if isinstance(value, str) and value.strip() else {}


def apply_native_claude(merged: Dict[str, Any], live: Dict[str, Any], held: Dict[str, Any],
                        telemetry: Dict[str, Any], cfg: Dict[str, Any],
                        ownership: Dict[str, Any]) -> Tuple[List[List[str]], List[str]]:
    """Fold the runtime's telemetry and workspace settings into `merged`; returns its owned
    paths and notices. The workspace block (`claude.workspaces` in OWNERSHIP.json) is owned by
    exactly the same rules as the telemetry block, while `workspaces_dir` is set.

    Ownership is per variable, never the whole `env` map, because the map is the user's: a
    variable they set is not read, changed or removed, and `held` — the keys `reconcile.Store`
    already records for this file — is what tells the two apart.

    A managed key that already holds a value the harness never wrote is **left as it is** and
    reported: adopting it silently would make `sync` the author of something it did not write,
    and overwriting it would lose a deliberate setting. A key already holding exactly what the
    harness would write is taken over, since there is nothing to lose. Turning `native` off
    restores what each key held before the harness first wrote it.
    """
    telemetry_values, omitted = claude_native_values(telemetry, cfg)
    notices = ["telemetry label {} carries a comma, an equals sign or whitespace, which "
               "OTEL_RESOURCE_ATTRIBUTES cannot; it is left off the native labels and still "
               "travels with the ledger export".format(name) for name in omitted]
    claude = ownership.get("claude", {})
    groups = [("native telemetry", claude.get("native_telemetry", {}), telemetry_values),
              ("workspace support", claude.get("workspaces", {}), claude_workspace_values(cfg))]
    kept: List[List[str]] = []
    for label, block, values in groups:
        paths = ([["env", key] for key in block.get("env_keys", [])]
                 + [[key] for key in block.get("settings_keys", [])])
        kept.extend(_apply_owned(merged, live, held, paths, values, label, notices))
    return kept, notices


def _apply_owned(merged: Dict[str, Any], live: Dict[str, Any], held: Dict[str, Any],
                 paths: List[List[str]], values: Dict[Tuple[str, ...], str], label: str,
                 notices: List[str]) -> List[List[str]]:
    """One ownership block's pass of `apply_native_claude`; appends to `notices`."""
    kept: List[List[str]] = []
    for path in paths:
        record = held.get(json.dumps(path))
        wanted = values.get(tuple(path))
        if wanted is None and record is None:
            continue  # never written by the harness and not wanted now: not ours to touch
        current = reconcile.lookup(live, path)
        if wanted is not None and record is None and current["present"] and current["value"] != wanted:
            notices.append(
                "{} in {} already holds a value the harness did not write; {} "
                "left it alone. Remove it to let `sync` manage it.".format(
                    ".".join(path), claude_dir() / "settings.json", label))
            continue
        item = ({"present": True, "value": wanted} if wanted is not None
                else deepcopy(record.get("prior") or {"present": False, "value": None}))
        if wanted is None and current == item:
            continue  # already back to what it held before; there is nothing left to take out
        reconcile.assign(merged, path, item)
        kept.append(path)
    return kept


def codex_native_otel(telemetry: Dict[str, Any], live: Optional[Dict[str, Any]],
                      owned: bool) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """The `[otel]` table `sync` wants, or `None` to take the harness's table back out.

    Both exporters are set explicitly. Codex's `metrics_exporter` defaults to its own first-party
    sink, and its source keeps an exact-name list of metrics — token usage, turn cost, tool calls
    and API calls among them — that the sink drops client-side, so setting only `exporter` sends
    no token metrics anywhere.

    No header is written. `[otel]` takes a literal header map in `config.toml` and offers no
    environment or command indirection for it, and a credential in a configuration file is what
    the exporter's own rules refuse; native Codex export therefore needs an endpoint that accepts
    unauthenticated traffic from this machine, or one the user authenticates some other way.
    That is why `telemetry.native` can name `claude-code` alone: against a collector that
    requires a header, a Codex table written here would export nothing but 401s.
    """
    if "codex" not in native_runtimes(telemetry):
        return None, []
    base = str(telemetry.get("endpoint", "")).rstrip("/")
    ours = {"exporter": {"otlp-http": {"endpoint": base + "/v1/logs",
                                       "protocol": CODEX_OTEL_PROTOCOL}},
            "metrics_exporter": {"otlp-http": {"endpoint": base + "/v1/metrics",
                                               "protocol": CODEX_OTEL_PROTOCOL}}}
    wanted = deepcopy(live) if isinstance(live, dict) else {}
    clashing = sorted(k for k, v in ours.items()
                      if not owned and k in wanted and wanted[k] != v)
    if clashing:
        return None, ["codex [otel] {} already holds a value the harness did not write; native "
                      "telemetry left the table alone. Remove the key to let `sync` manage it."
                      .format(", ".join(clashing))]
    wanted.update(ours)
    return wanted, []


def codex_otel_in_config(text: str) -> Optional[Dict[str, Any]]:
    try:
        document = reconcile.tomlkit.parse(text)
    except ValueError:
        return None
    return document["otel"].unwrap() if "otel" in document else None


def merge_vscode_settings(live: Dict[str, Any], owned: Dict[str, Any], cfg: Dict[str, Any]) -> Dict[str, Any]:
    out = deepcopy(live) if live else {}
    out.update(owned)
    p = posture(cfg)
    if p != "inherit":
        mode = POSTURES[p]["vscode"]
        if mode is None:
            out.pop("claudeCode.initialPermissionMode", None)
        else:
            out["claudeCode.initialPermissionMode"] = mode
        out["claudeCode.allowDangerouslySkipPermissions"] = (p == "bypass")
    return out


# --------------------------------------------------------------------------- links


class InstallManifest(dict):
    """Persist link/adoption intent before each filesystem mutation."""
    def persist(self):
        write_json_atomic(manifest_path(), self)


def _record(manifest: Dict[str, Any], kind: str, item: Dict[str, Any]) -> None:
    manifest.setdefault(kind, [])
    manifest[kind] = [i for i in manifest[kind] if i.get("path") != item.get("path")]
    manifest[kind].append(item)
    if isinstance(manifest, InstallManifest):
        manifest.persist()


def _adopt(path: Path, manifest: Dict[str, Any], dry: bool) -> Optional[Path]:
    """Move a pre-existing unmanaged path aside so the harness can link there."""
    dest_dir = state_dir() / "pre-harness"
    try:
        rel = path.relative_to(home())
    except ValueError:
        rel = Path("external") / hashlib.sha256(str(path).encode()).hexdigest() / path.name
    dest = dest_dir / rel
    say(f"  adopt   {path}  ->  {dest}")
    if not dry:
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.exists() or dest.is_symlink():
            dest = dest.with_name(dest.name + f".{int(time.time())}")
        _record(manifest, "adopted", {"path": str(path), "moved_to": str(dest)})
        shutil.move(str(path), str(dest))
    return dest


def _leads_to(path: Path, target: Any) -> bool:
    """Whether the symlink at path leads to target: by that spelling, or by an alias of the same file.

    The checkout reaches some directories two ways, so a link made under one spelling and recorded
    under the other is still the harness's link, not a redirect. Every judgment about a managed
    link goes through here; comparing the text alone reports drift that is not there and makes
    uninstall leave the link behind.
    """
    if not target:
        return False
    return Path(os.readlink(path)) == Path(target) or path.resolve() == Path(target).resolve()


def ensure_link(path: Path, target: Path, manifest: Dict[str, Any], dry: bool, adopt: bool,
                report: List[str], over_file: bool = False, root: Optional[str] = None) -> None:
    """Put the harness's symlink at `path`.

    `over_file` says the caller has just retired a harness-owned file there. A real run has
    already removed it; a dry run has not, and without this it would report the file it is
    about to replace as the user's.

    `root` names the registered primitive root the target came from, and is journaled with the
    link so drift, retirement and uninstall can say — and act on — where a file came from.
    """
    def entry(**more: Any) -> Dict[str, Any]:
        item = {"path": str(path), "target": str(target)}
        item.update(more)
        if root:
            item["root"] = root
        return item

    managed = any(l.get("path") == str(path) for l in manifest.get("links", []))
    if path.is_symlink():
        current = Path(os.readlink(path))
        if _leads_to(path, target):
            _record(manifest, "links", entry())
            return
        previous = next((entry for entry in manifest.get("links", []) if entry["path"] == str(path)), None)
        if previous and not (_leads_to(path, previous["target"]) or _leads_to(path, previous.get("pending_from"))):
            report.append(f"{path} was redirected after sync; preserving the user's link")
            return
        if managed or adopt:
            say(f"  relink  {path}")
            if not dry:
                _record(manifest, "links", entry(pending_from=str(current)))
                path.unlink()
                path.symlink_to(target)
            _record(manifest, "links", entry())
            return
        report.append(f"{path} is a symlink to {current}, not managed by the harness; pass --adopt to replace it")
        return
    if path.exists() and not over_file:
        if adopt:
            _adopt(path, manifest, dry)
        else:
            report.append(f"{path} exists and is not a harness link; pass --adopt to move it aside")
            return
    say(f"  link    {path}  ->  {target}")
    _record(manifest, "links", entry())
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)


def link_dir_files(source: Path, dest: Path, manifest: Dict[str, Any], dry: bool, adopt: bool,
                   report: List[str], skip: Optional[Set[str]] = None, off: Optional[Set[str]] = None,
                   over_file: bool = False) -> None:
    """One link per file, so anything the user keeps in the destination directory survives.

    `skip` names files the harness supplies another way; both the link and any retirement of one
    at those paths belong to whoever supplies them, so this leaves them entirely alone. `off`
    names files the selection switched off: not linked, and a link an earlier sync made retires.
    `over_file` is a dry run's word that `dest` is about to stop being a directory link.
    """
    skip = skip or set()
    off = off or set()
    wanted = set()
    if source.is_dir():
        for f in sorted(p_ for p_ in source.iterdir()
                        if p_.is_file() and p_.name not in skip and p_.name not in off):
            link = dest / f.name
            wanted.add(str(link))
            ensure_link(link, f, manifest, dry, adopt, report, over_file=over_file)
    for old in list(manifest.get("links", [])):
        if (Path(old["path"]).parent == dest and old["path"] not in wanted
                and Path(old["path"]).name not in skip):
            say(f"  unlink  {old['path']} (no longer in the harness)")
            path = Path(old["path"])
            if path.is_symlink() and not _leads_to(path, old["target"]):
                report.append(str(path) + ": retired link was redirected; preserved")
                continue
            if not dry and path.is_symlink():
                path.unlink()
            manifest["links"].remove(old)


def retire_link(path: Path, manifest: Dict[str, Any], dry: bool, report: List[str], why: str) -> None:
    """Take back one link the manifest records at `path`; a path it does not record is not ours.

    A link the user pointed elsewhere is preserved and reported, and stays recorded so `diff`
    keeps naming it.
    """
    entry = next((l for l in manifest.get("links", []) if l.get("path") == str(path)), None)
    if entry is None:
        return
    if path.is_symlink() and not _leads_to(path, entry["target"]):
        report.append(str(path) + ": retired link was redirected; preserved")
        return
    say(f"  unlink  {path} ({why})")
    if not dry and path.is_symlink():
        path.unlink()
    manifest["links"].remove(entry)


def switched_off(selection: Dict[str, Any]) -> Dict[str, Set[str]]:
    """`{kind: units the selection switches off}` for every kind in `SYNC_SWITCH_KINDS`."""
    return {kind: {unit for unit, value in (selection.get(kind) or {}).items() if value == "off"}
            for kind in SYNC_SWITCH_KINDS}


def migrate_rules_link(path: Path, target: Path, manifest: Dict[str, Any], dry: bool, adopt: bool,
                       report: List[str]) -> Optional[bool]:
    """Make `path` the real directory the per-rule links go in; None when it cannot be.

    Releases before 0.14.0 linked the whole rules directory here, so one rule could not be
    withheld. That link is the harness's when it leads to `target`, to what the manifest recorded,
    or nowhere because the checkout moved; its prior and applied states are journaled under
    `migrated` before it is removed, and its `links` entry goes in the same write, so an
    interrupted migration never leaves a link recorded that is not there. Anything else at `path`
    is the user's: reported, or moved aside with `--adopt`, which uninstall puts back. True is a
    dry run whose link has not been replaced yet.
    """
    if path.is_symlink():
        entry = next((l for l in manifest.get("links", []) if l.get("path") == str(path)), None)
        ours = _leads_to(path, target) or (entry is not None and (
            not path.exists() or _leads_to(path, entry.get("target"))))
        if not ours:
            if not adopt:
                report.append(f"{path} is a symlink to {os.readlink(path)}, not managed by the "
                              "harness; pass --adopt to move it aside")
                return None
            _adopt(path, manifest, dry)
        else:
            say(f"  migrate {path} (one link per rule replaces the directory link)")
            if not dry:
                if entry is not None:
                    manifest["links"].remove(entry)
                _record(manifest, "migrated", {"path": str(path),
                                               "prior": {"type": "symlink", "target": os.readlink(path)},
                                               "applied": {"type": "directory"}})
                path.unlink()
        if dry:
            return True
    elif path.exists() and not path.is_dir():
        if not adopt:
            report.append(f"{path} exists and is not a directory; pass --adopt to move it aside")
            return None
        _adopt(path, manifest, dry)
        if dry:
            return True
    if not dry:
        # Journaled only when sync makes the directory, so uninstall leaves one the user had.
        if not path.exists() and not any(i.get("path") == str(path) for i in manifest.get("migrated", [])):
            _record(manifest, "migrated", {"path": str(path), "prior": {"type": "absent"},
                                           "applied": {"type": "directory"}})
        path.mkdir(parents=True, exist_ok=True)
    return False


def retire_generated(store: "reconcile.Store", path: Path, why: str) -> None:
    """Undo one generated file a switch withholds, and the directory sync made for it if now empty."""
    if str(path) not in store.data["files"]:
        return
    if store.retire(path):
        say(f"  unlink  {path} ({why})")
        if not store.dry and path.parent.name.startswith("harness-"):
            try:
                path.parent.rmdir()
            except OSError:
                pass


def claim_agent_path(target: Path, committed: Path, manifest: Dict[str, Any], dry: bool,
                     adopt: bool, report: List[str]) -> bool:
    """Free the path a rendered agent definition belongs at; False leaves the role unrendered.

    0.10.0 linked these paths, so a link that still leads to this checkout's projection under any
    spelling, or that dangles because the checkout moved, is the harness's own and retires here.
    A link the user pointed at something real is theirs: preserved and reported, and `--adopt`
    moves it aside by the pre-harness convention rather than deleting it. A symlink the manifest
    never recorded is reported like any other unmanaged file, so no role can end a sync with a
    definition that is neither the harness's nor repairable.
    """
    if not target.is_symlink():
        return True
    entry = next((l for l in manifest.get("links", []) if l.get("path") == str(target)), None)
    ours = _leads_to(target, committed) or (entry is not None and (
        not target.exists() or _leads_to(target, entry.get("target"))))
    if ours:
        say(f"  unlink  {target} (agent definitions are rendered, not linked)")
        if not dry:
            target.unlink()
    elif adopt:
        _adopt(target, manifest, dry)
    else:
        report.append(f"{target} is a symlink to {os.readlink(target)}, not a harness agent "
                      "definition; preserved — pass --adopt to move it aside and render")
        return False
    if entry is not None:
        manifest["links"].remove(entry)
    return True


def adopt_legacy(path: Path, manifest: Dict[str, Any], dry: bool, adopt: bool, report: List[str]) -> None:
    """A plain file the harness now supplies elsewhere; move it aside so it does not load twice."""
    if not path.exists() or path.is_symlink():
        return
    if adopt:
        _adopt(path, manifest, dry)
    else:
        report.append(f"{path} duplicates a harness file and would load twice; pass --adopt to move it aside")


# --------------------------------------------------------------------------- personal file, codex, gitignore


def render_personal(cfg: Dict[str, Any], existing: Optional[str]) -> str:
    template = (REPO / "claude" / "CLAUDE.personal.template.md").read_text(encoding="utf-8")
    identity = {k: cfg.get("identity", {}).get(k, "") for k in IDENTITY_KEYS}
    identity["guidance"] = GUIDANCE.get(identity.get("expertise") or "expert", GUIDANCE["expert"])
    head = template.format_map(identity)
    if existing and PERSONAL_MARKER in existing:
        tail = existing.split(PERSONAL_MARKER, 1)[1]
        head = head.split(PERSONAL_MARKER, 1)[0] + PERSONAL_MARKER + tail
    return head


def _root_slug(path: Path, taken: Dict[str, str]) -> str:
    """A directory name for one root's rules: its own name, kept distinct and path-safe."""
    base = "".join(c if (c.isascii() and c.isalnum()) else "-" for c in path.name).strip("-").lower()
    slug = base or "root"
    if taken.get(slug, str(path)) != str(path):
        slug += "-" + hashlib.sha256(str(path).encode("utf-8")).hexdigest()[:8]
    taken[slug] = str(path)
    return slug


def external_primitive_roots(cfg: Dict[str, Any]) -> Tuple[List[Dict[str, Any]], List[str]]:
    """Every registered root's rules and skills, in configuration order, plus what was skipped.

    A root the configuration names but the disk does not carry is a warning and nothing more:
    an unplugged drive or a checkout moved aside must not stop a sync from projecting the rest.
    """
    found: List[Dict[str, Any]] = []
    warnings: List[str] = []
    taken: Dict[str, str] = {}
    for source in collisions.roots(REPO, cfg)[1:]:
        if not source.is_dir():
            warnings.append("primitive root " + str(source) + " is not a directory; skipped")
            continue
        rules = sorted((source / "rules").glob("*.md")) if (source / "rules").is_dir() else []
        skills = sorted(child for child in (source / "skills").iterdir()
                        if child.is_dir() and (child / "SKILL.md").is_file()) \
            if (source / "skills").is_dir() else []
        found.append({"path": source, "slug": _root_slug(source, taken),
                      "rules": [r for r in rules if r.is_file()], "skills": skills})
    return found, warnings


def retire_external_links(manifest: Dict[str, Any], wanted: Set[str], directories: Iterable[Path],
                          dry: bool, report: List[str]) -> None:
    """Drop links from a root that no longer offers the file, or is no longer registered.

    Only paths under a directory this run actually managed are considered, so a runtime the
    configuration has switched off keeps the links the harness made for it.
    """
    directories = [Path(d) for d in directories]
    for old in list(manifest.get("links", [])):
        path = Path(old["path"])
        if not old.get("root") or old["path"] in wanted:
            continue
        if not any(d == path.parent or d in path.parents for d in directories):
            continue
        say(f"  unlink  {path} (no longer in a registered primitive root)")
        if path.is_symlink() and not _leads_to(path, old["target"]):
            report.append(str(path) + ": retired link was redirected; preserved")
            continue
        if not dry and path.is_symlink():
            path.unlink()
        manifest["links"].remove(old)


def render_codex_agents(stances: Dict[str, Path], personal: Optional[str],
                        externals: Sequence[Dict[str, Any]] = (), off_rules: Iterable[str] = ()) -> str:
    """The Codex `AGENTS.md`; `off_rules` are the repository's rules the selection switched off."""
    off_rules = set(off_rules)
    parts = [CODEX_BANNER, ""]
    parts += [(REPO / "primitives" / "instructions.md").read_text().rstrip(), ""]
    for rule in sorted(r for r in (REPO / "primitives" / "rules").glob("*.md") if r.stem not in off_rules):
        parts += ["---", f"<!-- {rule.name} -->", rule.read_text(encoding="utf-8").rstrip(), ""]
    for entry in externals:
        # A rule from outside the checkout says where it came from, so a reader of the generated
        # file can find the root to edit rather than editing the projection.
        if not entry["rules"]:
            continue
        parts += ["---", "<!-- primitive root: " + str(entry["path"]) + " -->", ""]
        for rule in entry["rules"]:
            parts += [f"<!-- {entry['slug']}/{rule.name} -->",
                      rule.read_text(encoding="utf-8").rstrip(), ""]
    for name, path in stances.items():
        parts += ["---", f"<!-- stance {name}: {path.stem} -->", path.read_text(encoding="utf-8").rstrip(), ""]
    if stances.get("voice") and stances["voice"].stem == "scannable":
        parts += ["Shared presentation: before composing a final response, read and apply `" +
                  str(REPO / "primitives" / "presentation" / "scannable.md") + "`.", ""]
    if personal:
        parts += ["---", "<!-- AGENTS.personal.md -->", personal.rstrip(), ""]
    return "\n".join(parts)


def codex_wanted(cfg: Dict[str, Any], reviewer: Optional[codex_client.Reviewer] = None,
                 otel: Any = UNMANAGED) -> Dict[str, Any]:
    """The Codex config keys this posture wants, `None` meaning a harness key to take back out.

    Codex renamed the approval-reviewer field, and a spelling the installed client does not know
    is dropped without a word — so only the name that client accepts is written, and the other
    one, which an earlier harness may have left behind, is removed. `codex_client` holds the
    evidence and the probe.

    `otel` is the table `codex_native_otel` resolved. Left at `UNMANAGED` the key is not listed
    at all, so a caller that knows nothing about telemetry cannot remove a user's `[otel]`.
    """
    wanted: Dict[str, Any] = {"project_doc_fallback_filenames": ["CLAUDE.md"]}
    p = posture(cfg)
    chosen, value = None, None
    if p != "inherit":
        approval, sandbox = POSTURES[p]["codex"]
        wanted.update(approval_policy=approval, sandbox_mode=sandbox)
        if p != "bypass":
            reviewer = reviewer if reviewer is not None else codex_client.detect()
            chosen, value = reviewer.key, codex_client.REVIEWER_VALUES[p]
    for key in codex_client.REVIEWER_KEYS:
        wanted[key] = value if key == chosen else None
    if otel is not UNMANAGED:
        wanted["otel"] = otel
    return wanted


def update_codex_config(text: str, cfg: Dict[str, Any],
                        reviewer: Optional[codex_client.Reviewer] = None,
                        otel: Any = UNMANAGED) -> str:
    return reconcile.update_toml(text, codex_wanted(cfg, reviewer, otel))


def codex_reviewer_in_config(key: Optional[str]) -> Optional[Any]:
    """What the live Codex config says about approval review, under the key that client reads.

    A value under the other spelling is worth nothing to it, so it is not looked for here.
    """
    path = codex_dir() / "config.toml"
    if key is None or not path.is_file():
        return None
    try:
        document = reconcile.tomlkit.parse(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return document[key].unwrap() if key in document else None


def ensure_gitignore_entries(dry: bool) -> None:
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    entries = ownership.get("gitignore_entries", [])
    path = global_gitignore_path()
    existing = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    missing = [e for e in entries if e not in existing]
    if not missing:
        return
    say(f"  ignore  {path}: + {', '.join(missing)}")
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            if existing and existing[-1] != "":
                fh.write("\n")
            fh.write(IGNORE_MARKER + "\n" + "\n".join(missing) + "\n")


PATH_BLOCK = '# agent-harness: Claude Code native launcher lives here\nexport PATH="$HOME/.local/bin:$PATH"\n'
IGNORE_MARKER = "# agent-harness"


def remove_local_bin_from_path() -> bool:
    """Undo ensure_local_bin_on_path: drop the exact block sync appended, nothing else."""
    f = home() / ".zprofile"
    if not f.exists():
        return False
    text = f.read_text(encoding="utf-8")
    if PATH_BLOCK not in text:
        return False
    f.write_text(text.replace("\n" + PATH_BLOCK, "\n", 1).replace(PATH_BLOCK, "", 1), encoding="utf-8")
    return True


def remove_gitignore_entries() -> bool:
    """Undo ensure_gitignore_entries: drop the marker line and the harness entries that
    follow it, leaving every other line in place."""
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    entries = set(ownership.get("gitignore_entries", []))
    path = global_gitignore_path()
    if not path.exists():
        return False
    lines = path.read_text(encoding="utf-8").splitlines()
    if IGNORE_MARKER not in lines:
        return False
    out, i = [], 0
    while i < len(lines):
        if lines[i] == IGNORE_MARKER:
            i += 1
            while i < len(lines) and lines[i] in entries:
                i += 1
            continue
        out.append(lines[i])
        i += 1
    path.write_text("".join(ln + "\n" for ln in out), encoding="utf-8")
    return True


def ensure_local_bin_on_path(dry: bool) -> None:
    if platform.system() != "Darwin" or "zsh" not in os.environ.get("SHELL", ""):
        return
    for name in (".zprofile", ".zshrc"):
        f = home() / name
        if f.exists() and ".local/bin" in f.read_text(encoding="utf-8"):
            return
    target = home() / ".zprofile"
    say(f"  path    ~/.local/bin added to PATH in {target}")
    if not dry:
        with open(target, "a", encoding="utf-8") as fh:
            fh.write("\n" + PATH_BLOCK)


# --------------------------------------------------------------------------- commands


def cmd_sync(args: argparse.Namespace) -> int:
    if platform.system() == "Windows":
        say(UNSUPPORTED)
        return 1
    try:
        # A dry run reports the same refusal as the real one; it differs in what it writes.
        if args.dry_run:
            return _cmd_sync_unlocked(args)
        with reconcile.lock(state_dir()):
            return _cmd_sync_unlocked(args)
    except ValueError as exc:
        raise SystemExit(str(exc))


def _cmd_sync_unlocked(args: argparse.Namespace) -> int:
    if platform.system() == "Windows":
        say(UNSUPPORTED)
        return 1
    dry = args.dry_run
    defaults = user_defaults_env()
    session_keys = [key for key in os.environ if key not in defaults]
    cfg = load_config(defaults)
    # What the user's layers switch off, which no runtime home receives.
    off = switched_off(load_selection(defaults))
    # A root the caller is about to register, so `import` can show the projection of a root the
    # configuration does not carry yet. Nothing else sets it, and a dry run is the only user.
    for extra in getattr(args, "extra_roots", None) or []:
        roots = cfg.setdefault("primitive_roots", [])
        if str(extra) not in roots:
            roots.append(str(extra))
    if session_keys:
        say("  scope   sync projects user defaults; project/session overrides stay in the session")
    # Before anything is written: a name two roots both define is resolved by the runtime
    # first-wins and silently, so the install is refused rather than made ambiguous.
    refusals = collisions.findings(REPO, cfg)
    if refusals:
        for line in refusals:
            say(line)
        say("sync refused: nothing was written")
        return 2
    stances = resolve_stances(cfg)
    externals, root_warnings = external_primitive_roots(cfg)
    for entry in externals:
        entry["rules"] = [rule for rule in entry["rules"] if rule.stem not in off["rules"]]
        entry["skills"] = [skill for skill in entry["skills"] if skill.name not in off["skills"]]
    p = posture(cfg)
    telemetry = telemetry_settings(cfg)
    table = cost_table(cfg)
    # Render every role for both runtimes before anything is written: a binding that will not
    # resolve is an error the user sees before a half-synced home directory.
    for runtime, key in (("codex", "codex"), ("claude-code", "claude")):
        if not cfg.get(key, {}).get("manage", True):
            continue
        for role in (REPO / "primitives" / "roles").glob("*.md"):
            if role.stem in off["roles"]:
                continue
            primitive_catalog.role_projection(REPO, runtime, role,
                agent_overrides(cfg, table, runtime, role.stem), cfg.get("tiers", {}).get(runtime))
    reviewer = None
    if cfg.get("codex", {}).get("manage", True):
        reviewer = codex_client.detect()
        ctoml = codex_dir() / "config.toml"
        update_codex_config(ctoml.read_text() if ctoml.is_file() else "", cfg, reviewer)
    if cfg.get("claude", {}).get("manage", True):
        read_json(claude_dir() / "settings.json")
    if cfg.get("codex", {}).get("manage", True):
        read_json(codex_dir() / "hooks.json")
    say(f"model-citizen {VERSION} · repo {REPO} · home {home()}{' · DRY RUN' if dry else ''}")
    say("stances: " + ", ".join(f"{k}={v.stem}" for k, v in stances.items()) + f" · permissions={p}")
    for warning in root_warnings:
        say("  notice  " + warning)
    for warning in table.get("warnings", []):
        # A sidecar nobody can read renders the shipped table instead; silence would make that
        # look like a deliberate posture.
        say("  notice  cost variant: " + warning)
    if reviewer is not None and p == "auto" and not reviewer.reliable:
        # The posture promises Codex reviews its own approval requests. A client that will not
        # take the setting resolves that as review by the user, so it is said out loud rather
        # than left to be discovered the next time an approval waits for a human.
        say("  notice  codex approval review: " + reviewer.detail)
        say("          `permissions=auto` will ask you to approve; `citizen doctor` repeats this")
    try:
        project = Path.cwd()
    except OSError:
        project = None
    for line in collisions.shadows(REPO, cfg, project):
        # A project definition is meant to win; it is said so the precedence is not a surprise.
        say("  notice  " + line)
    stale = placeholder_identity(cfg)
    if stale:
        say(f"  notice  identity {', '.join(stale)} still at the example value; the agent reads this")
        say("          as who you are. Fix with `citizen init` or `citizen config set identity.name \"…\"`")
    old_plugin = plugin_install_state()["old"]
    if old_plugin:
        say("  notice  plugin %s is the pre-rename ID and stops loading once its marketplace "
            "updates; run `citizen upgrade`" % ", ".join(old_plugin))
    if args.dry_run and getattr(args, "print_only", False):
        return 0

    manifest = read_json(manifest_path()) or {"version": 1}
    manifest["repo"] = str(REPO)
    if not dry:
        manifest = InstallManifest(manifest)
        manifest.persist()
    report: List[str] = []
    # Links a registered root wants this run, and the directories whose root-owned links are the
    # harness's to retire; both are filled by whichever runtimes this configuration manages.
    wanted_external: Set[str] = set()
    external_dirs: List[Path] = []
    cd = claude_dir()
    applied = read_json(applied_path()) or {}
    store = reconcile.Store(state_dir(), dry)
    if not dry:
        if cfg.get("claude", {}).get("manage", True):
            for sub in ("rules", "skills", "agents", "hooks", "output-styles", "plans"):
                (cd / sub).mkdir(parents=True, exist_ok=True)
            (cd / "rules" / "harness-stances").mkdir(exist_ok=True)
        state_dir().mkdir(parents=True, exist_ok=True)
        if not config_path().exists():
            config_path().parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(REPO / "config.example.json", config_path())
            say(f"  config  created {config_path()} from config.example.json")
            say("          run `citizen init` to fill it in by answering questions")

    if cfg.get("claude", {}).get("manage", True):
        # Legacy plain files that the harness now provides.
        for name in LEGACY_RULES:
            adopt_legacy(cd / "rules" / name, manifest, dry, args.adopt, report)
        for name in HARNESS_HOOK_BASENAMES:
            adopt_legacy(cd / "hooks" / name, manifest, dry, args.adopt, report)

        # Links.
        rules_home = cd / "rules" / RULES_DIR
        pending = migrate_rules_link(rules_home, REPO / "claude" / "rules", manifest, dry, args.adopt, report)
        if pending is not None:
            link_dir_files(REPO / "claude" / "rules", rules_home, manifest, dry, args.adopt, report,
                           off={name + ".md" for name in off["rules"]}, over_file=pending)
        wanted_stance_links = set()
        for name, target in stances.items():
            link = cd / "rules" / "harness-stances" / f"{name}.md"
            wanted_stance_links.add(str(link))
            ensure_link(link, target, manifest, dry, args.adopt, report)
        for old in list(manifest.get("links", [])):
            if "/rules/harness-stances/" in old["path"] and old["path"] not in wanted_stance_links:
                say(f"  unlink  {old['path']} (stance no longer selected)")
                path = Path(old["path"])
                if path.is_symlink() and not _leads_to(path, old["target"]):
                    report.append(str(path) + ": retired stance link was redirected; preserved")
                    continue
                if not dry and path.is_symlink():
                    path.unlink()
                manifest["links"].remove(old)
        for skill in sorted(p_ for p_ in (REPO / "claude" / "skills").iterdir() if p_.is_dir()):
            if skill.name in off["skills"]:
                retire_link(cd / "skills" / skill.name, manifest, dry, report, "skill switched off")
                continue
            ensure_link(cd / "skills" / skill.name, skill, manifest, dry, args.adopt, report)
        # Registered roots, after this checkout's own and in configuration order: their rules one
        # directory per root, their skills beside the repository's, which the collision check has
        # already proved they cannot shadow.
        for entry in externals:
            if not (entry["rules"] or entry["skills"]):
                continue
            say(f"  root    {entry['path']} · {len(entry['rules'])} rule(s), "
                f"{len(entry['skills'])} skill(s)")
            for rule in entry["rules"]:
                link = cd / "rules" / EXTERNAL_RULES_DIR / entry["slug"] / rule.name
                wanted_external.add(str(link))
                ensure_link(link, rule, manifest, dry, args.adopt, report, root=str(entry["path"]))
            for skill in entry["skills"]:
                link = cd / "skills" / skill.name
                wanted_external.add(str(link))
                ensure_link(link, skill, manifest, dry, args.adopt, report, root=str(entry["path"]))
        external_dirs.extend([cd / "rules" / EXTERNAL_RULES_DIR, cd / "skills"])
        # An agent definition the selected posture moves is rendered into the Claude home, because
        # the variant's class and effort have to reach the native file; one it does not move stays
        # the symlink to the committed projection, so the common install is exactly what earlier
        # releases wrote and downgrades cleanly. `baseline` is the same rendering with no
        # overrides, which is that projection. Every role is rendered before the first unlink or
        # write, so a binding that will not resolve cannot leave a role without a definition.
        # Anything else the harness ships in `claude/agents` keeps being linked.
        shipped = sorted((REPO / "primitives" / "roles").glob("*.md"))
        roles = [role for role in shipped if role.stem not in off["roles"]]
        for role in shipped:
            if role.stem in off["roles"]:
                retire_link(cd / "agents" / role.name, manifest, dry, report, "role switched off")
        rendered = {role.stem: (
            primitive_catalog.role_projection(REPO, "claude-code", role,
                agent_overrides(cfg, table, "claude-code", role.stem),
                cfg.get("tiers", {}).get("claude-code")),
            primitive_catalog.role_projection(REPO, "claude-code", role)) for role in roles}
        link_dir_files(REPO / "claude" / "agents", cd / "agents", manifest, dry, args.adopt, report,
                       skip={role.name for role in shipped})
        for role in roles:
            content, baseline = rendered[role.stem]
            target, committed = cd / "agents" / role.name, REPO / "claude" / "agents" / role.name
            if content == baseline:
                # The selected posture does not move this role, so it stays the link the previous
                # release made: a machine on `balanced` can downgrade without a single conflict.
                retired = str(target) in store.data["files"]
                if retired and not store.retire(target):
                    continue  # the user edited what the harness generated; reported, never removed
                if retired:
                    say(f"  unlink  {target} (renders as the committed projection)")
                ensure_link(target, committed, manifest, dry, args.adopt, report, over_file=retired)
                continue
            say("  agent   " + role.stem + "  " + _agent_change(table, role.stem, content))
            if not claim_agent_path(target, committed, manifest, dry, args.adopt, report):
                continue
            if (args.adopt and not target.is_symlink() and target.is_file()
                    and str(target) not in store.data["files"]):
                _adopt(target, manifest, dry)
            # A dry run has not unlinked yet; the write it reports is over the claimed link.
            over_link = target.is_symlink()
            if over_link or not target.is_file() or target.read_text(encoding="utf-8") != content:
                say(f"  render  {target}")
            store.generated(target, content, adopt=args.adopt, over_link=over_link)
        for name in [n for n, r in list(store.data["files"].items())
                     if r.get("kind") == "generated" and Path(n).parent == cd / "agents"
                     and Path(n).stem not in rendered]:
            if store.retire(Path(name)):
                why = "role switched off" if Path(name).stem in off["roles"] else "role no longer in the harness"
                say(f"  unlink  {name} ({why})")
        ensure_link(cd / "hooks" / "harness", REPO / "claude" / "hooks", manifest, dry, args.adopt, report)
        for style in sorted((REPO / "claude" / "output-styles").glob("*.md")):
            ensure_link(cd / "output-styles" / style.name, style, manifest, dry, args.adopt, report)
        link_dir_files(REPO / "claude" / "commands", cd / "commands", manifest, dry, args.adopt, report,
                       off={name + ".md" for name in off["workflows"]})
        if cd == home() / ".claude":
            ensure_link(cd / "CLAUDE.md", REPO / "claude" / "CLAUDE.md", manifest, dry, args.adopt, report)
        else:
            native_instructions = (REPO / "primitives" / "instructions.md").read_text()
            native_instructions += "\n@" + str(cd / "CLAUDE.personal.md") + "\n"
            store.generated(cd / "CLAUDE.md", native_instructions, adopt=args.adopt)

        # Personal file.
        personal = cd / "CLAUDE.personal.md"
        existing = personal.read_text(encoding="utf-8") if personal.exists() else None
        rendered = render_personal(cfg, existing)
        if rendered != existing:
            say(f"  render  {personal}")
            if not dry:
                personal.write_text(rendered, encoding="utf-8")

        # Claude settings.
        template = runtime_template()
        settings_file = cd / "settings.json"
        live = read_json(settings_file) or {}
        mtime = settings_file.stat().st_mtime if settings_file.exists() else None
        applied = read_json(applied_path()) or {}
        held = store.data["files"].get(str(settings_file), {}).get("keys", {})
        was_installed = installed_output_style(held)
        style = voice_output_style(cfg)
        merged = merge_claude_settings(live, template, cfg, retired=retired_allow_rules(applied, template),
                                       installed=was_installed)
        # A built-in style the user had already chosen is theirs, not an install: selecting the
        # variant that maps to it writes nothing, so it is not journaled as harness-applied and a
        # later switch away or an uninstall leaves it where it was.
        owned_style = None if (style in BUILTIN_OUTPUT_STYLES.values() and was_installed != style
                               and live.get("outputStyle") == style) else style
        ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
        # `outputStyle` is listed only while the harness has something to say about it: the
        # style the voice stance selects, or one it installed for an earlier selection and is
        # now taking back out. A style the user chose is neither written nor recorded as owned.
        owned_paths = [[k] for k in ownership.get("claude", {}).get("owned_keys", [])
                       if k != "outputStyle" or owned_style is not None or was_installed is not None]
        owned_paths += [["permissions", "allow"], ["permissions", "defaultMode"]]
        hook_paths = [["hooks", event] for event in template.get("hooks", {})]
        owned_paths += hook_paths
        native_paths, native_notices = apply_native_claude(merged, live, held, telemetry, cfg, ownership)
        owned_paths += native_paths
        report.extend(native_notices)
        if "claude-code" in native_runtimes(telemetry):
            attributes, _ = resource_attributes(cfg, telemetry)
            helper = "headers helper" if ("otelHeadersHelper" in merged) else "no headers"
            say(f"  native  claude-code exports its own telemetry to "
                f"{telemetry.get('endpoint', '')} ({CLAUDE_OTEL_PROTOCOL}, {helper})")
            say(f"          labels {attributes}")
        elif [p for p in native_paths if p != ["env", WORKSPACE_ENV]]:
            say("  native  telemetry.native no longer names claude-code; removing the Claude "
                "telemetry settings sync added")
        store.json(settings_file, merged, owned_paths, hook_lists=hook_paths)
        applied["claude"] = claude_projection(merged, template, installed=owned_style)
        applied["template"] = claude_projection(merge_claude_settings({}, template, cfg), template,
                                                installed=style)

        # VS Code.
        if cfg.get("vscode", {}).get("manage", True):
            vs = vscode_settings_path()
            if vs.exists():
                try:
                    vlive = read_json(vs) or {}
                except SystemExit:
                    vlive = None
                    report.append(f"{vs} is not plain JSON (comments?); VS Code settings left alone")
                if vlive is not None:
                    owned = read_json(REPO / "vscode" / "settings.owned.json") or {}
                    vmerged = merge_vscode_settings(vlive, owned, cfg)
                    store.json(vs, vmerged, [[key] for key in list(owned) +
                               ["claudeCode.initialPermissionMode", "claudeCode.allowDangerouslySkipPermissions"]])
                    applied["vscode"] = {k: vmerged.get(k) for k in list(owned) + ["claudeCode.initialPermissionMode", "claudeCode.allowDangerouslySkipPermissions"]}
            else:
                say("  vscode  no user settings file found; skipping (install VS Code, then re-run sync)")

    # Codex consumes the same policy text, skills and role contracts.
    if cfg.get("codex", {}).get("manage", True):
        personal_codex = codex_dir() / "AGENTS.personal.md"
        ptext = personal_codex.read_text() if personal_codex.exists() else None
        identity = render_personal(cfg, None)
        text = render_codex_agents(stances, identity + ("\n" + ptext if ptext else ""), externals,
                                   off["rules"])
        agents = codex_dir() / "AGENTS.md"
        legacy = agents.is_file() and agents.read_text().startswith(CODEX_BANNER)
        previous = store.data["files"].get(str(agents), {}).get("prior")
        if previous and not previous.startswith(CODEX_BANNER):
            text += "\n---\n<!-- Adopted personal guidance -->\n" + previous
        elif agents.is_file() and not legacy and args.adopt_codex and str(agents) not in store.data["files"]:
            text += "\n---\n<!-- Adopted personal guidance -->\n" + agents.read_text()
        store.generated(agents, text, adopt=args.adopt_codex or legacy)
        config_toml = codex_dir() / "config.toml"
        owned_otel = "otel" in store.data["files"].get(str(config_toml), {}).get("keys", {})
        otel, otel_notices = codex_native_otel(
            telemetry, codex_otel_in_config(config_toml.read_text() if config_toml.is_file() else ""),
            owned_otel)
        report.extend(otel_notices)
        if otel is not None:
            say(f"  native  codex exports logs and metrics to "
                f"{str(telemetry.get('endpoint', '')).rstrip('/')}/v1/{{logs,metrics}}")
            say("          no header is written: Codex takes a literal header map, so the "
                "endpoint must accept this machine unauthenticated or be fronted by the user")
        elif owned_otel:
            say("  native  telemetry.native no longer names codex; restoring the Codex [otel] "
                "table sync replaced")
        store.toml(config_toml, codex_wanted(cfg, reviewer, otel if (otel is not None or owned_otel)
                                             else UNMANAGED))
        hook_file = codex_dir() / "hooks.json"
        hook_live = read_json(hook_file) or {}
        hook_template = lifecycle.registration(REPO, "codex")
        hook_merged = deepcopy(hook_live)
        hook_merged.setdefault("hooks", {})
        for event, entries in hook_template["hooks"].items():
            hook_merged["hooks"][event] = [e for e in hook_live.get("hooks", {}).get(event, [])
                                          if not _is_harness_entry(e)] + entries
        hook_paths = [["hooks", event] for event in hook_template["hooks"]]
        store.json(hook_file, hook_merged, hook_paths, hook_lists=hook_paths)
        say("  codex   hooks registered; native hook trust must be accepted in the client")
        skills_home = home() / ".agents" / "skills"
        for skill in sorted((REPO / "primitives" / "skills").iterdir()):
            if skill.is_dir() and skill.name in off["skills"]:
                retire_link(skills_home / skill.name, manifest, dry, report, "skill switched off")
            elif skill.is_dir():
                ensure_link(skills_home / skill.name, skill, manifest, dry, args.adopt, report)
        for entry in externals:
            for skill in entry["skills"]:
                link = skills_home / skill.name
                wanted_external.add(str(link))
                ensure_link(link, skill, manifest, dry, args.adopt, report, root=str(entry["path"]))
        external_dirs.append(skills_home)
        for role in sorted((REPO / "primitives" / "roles").glob("*.md")):
            if role.stem in off["roles"]:
                retire_generated(store, codex_dir() / "agents" / (role.stem + ".toml"), "role switched off")
                continue
            store.generated(codex_dir() / "agents" / (role.stem + ".toml"),
                            primitive_catalog.role_projection(REPO, "codex", role,
                                                              agent_overrides(cfg, table, "codex", role.stem),
                                                              cfg.get("tiers", {}).get("codex")), adopt=args.adopt)
        for workflow in sorted((REPO / "primitives" / "workflows").glob("*.md")):
            if workflow.stem in off["workflows"]:
                retire_generated(store, skills_home / ("harness-" + workflow.stem) / "SKILL.md",
                                 "workflow switched off")
                continue
            fields, body = primitive_catalog.frontmatter(workflow)
            content = "---\nname: harness-" + workflow.stem + "\ndescription: " + fields["description"] + "\n---\n\n"
            content += body.replace("{{arguments}}", "the arguments supplied with this invocation")
            store.generated(skills_home / ("harness-" + workflow.stem) / "SKILL.md", content, adopt=args.adopt)
    retire_external_links(manifest, wanted_external, external_dirs, dry, report)
    report.extend(store.conflicts)

    ensure_gitignore_entries(dry)
    ensure_local_bin_on_path(dry)
    # The harness checkout lints every commit before it is made.
    if (REPO / ".githooks" / "pre-commit").exists() and not dry:
        subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath", ".githooks"], capture_output=True)

    manifest["synced_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    manifest["config"] = {"stances": cfg["stances"], "permissions": p,
                          "off": {kind: sorted(units) for kind, units in off.items()}}
    if not dry:
        write_json_atomic(manifest_path(), manifest)
        write_json_atomic(applied_path(), applied)
    if report:
        say("\nNeeds your attention:")
        for r in report:
            say("  - " + r)
        return 2
    say("sync complete")
    return 0


def runtime_template():
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    template["hooks"] = lifecycle.registration(REPO, "claude-code")["hooks"]
    return template


def _diff_lines() -> List[str]:
    lines: List[str] = []
    manifest = read_json(manifest_path())
    if not manifest:
        return ["Model Citizen not synced yet (no manifest); run `citizen sync`"]
    for link in manifest.get("links", []):
        p = Path(link["path"])
        # A link from a registered primitive root names it, so drift points at the root to fix.
        origin = " (primitive root " + link["root"] + ")" if link.get("root") else ""
        if not p.is_symlink():
            lines.append(f"missing link {p}{origin}")
        elif not _leads_to(p, link["target"]):
            lines.append(f"redirected link {p} -> {os.readlink(p)}{origin}")
        elif not p.exists():
            lines.append(f"broken link {p}{origin}")
    defaults = user_defaults_env()
    cfg = load_config(defaults)
    template = runtime_template()
    applied = read_json(applied_path()) or {}
    live = read_json(claude_dir() / "settings.json") or {}
    live_p = claude_projection(live, template, installed=installed_output_style())
    applied_p = applied.get("claude", {})
    template_p = claude_projection(merge_claude_settings({}, template, cfg), template,
                                   installed=voice_output_style(cfg))
    if applied_p:
        for k, v in live_p["keys"].items():
            if applied_p.get("keys", {}).get(k) != v:
                lines.append(f"live-only change: settings.{k} = {v!r} (upstream it or re-sync)")
        for rule in live_p["allow"]:
            if rule not in applied_p.get("allow", []) and rule not in template_p["allow"]:
                lines.append(f"live-only allow rule: {rule} (upstream?)")
        for rule in template_p["allow"]:
            if rule not in live_p["allow"]:
                lines.append(f"pending sync: allow rule {rule}")
        for hid in template_p["hooks"]:
            if hid not in live_p["hooks"]:
                lines.append(f"pending sync: hook {hid}")
        if applied.get("template") and applied["template"] != template_p:
            lines.append("pending sync: settings template changed since last sync")
    stances_now = dict(cfg["stances"])
    if manifest.get("config", {}).get("stances") and manifest["config"]["stances"] != stances_now:
        lines.append("pending sync: stance selection changed since last sync")
    if "config" in manifest:
        off_now = {kind: sorted(units) for kind, units in switched_off(load_selection(defaults)).items()}
        recorded = manifest["config"].get("off") or {kind: [] for kind in SYNC_SWITCH_KINDS}
        if recorded != off_now:
            lines.append("pending sync: switch selection changed since last sync")
    lines.extend(reconcile.Store(state_dir(), dry=True).drift())
    return lines


# The plugin and marketplace names this project has shipped under, newest first. Claude Code keys
# an install by `<plugin>@<marketplace>` and keeps the old key until the user reinstalls, so doctor
# recognizes every name here, not only the one in this checkout's manifests.
PLUGIN_NAMES = ("model-citizen", "agent-harness")


def _plugin_names() -> Tuple[str, str, str]:
    """This checkout's plugin name, marketplace name and source repository, from its manifests.

    The repository comes from the manifest rather than the directory name, because a worktree
    is named for its branch.
    """
    manifest = read_json(REPO / ".claude-plugin" / "plugin.json") or {}
    plugin = manifest.get("name", "agent-harness")
    market = (read_json(REPO / ".claude-plugin" / "marketplace.json") or {}).get("name", plugin)
    slug = str(manifest.get("repository", "")).rstrip("/").rsplit("/", 1)[-1]
    return plugin, market, slug[:-4] if slug.endswith(".git") else slug


def plugin_install_state() -> Dict[str, Any]:
    """Which of the two install paths is live: the marketplace plugin, the synced home, or both.

    They are independent. A marketplace install lands in Claude Code's own plugin cache and is
    recorded in `enabledPlugins`; `bin/harness install` writes the ownership manifest instead.
    See docs/runtime-installation.md for what each one covers.
    """
    plugin, market, slug = _plugin_names()
    names = {plugin, *PLUGIN_NAMES}
    slugs = {slug, *PLUGIN_NAMES} - {""}
    state = {"plugin": plugin, "marketplace": market, "registered": [], "enabled": [],
             "cached": [], "doubled": [], "old": [], "synced": manifest_path().is_file()}
    plugins = claude_dir() / "plugins"
    try:
        known = read_json(plugins / "known_marketplaces.json") or {}
        settings = read_json(claude_dir() / "settings.json") or {}
    except (SystemExit, OSError):
        return state
    state["registered"] = sorted(
        name for name, entry in known.items() if isinstance(entry, dict)
        and str((entry.get("source") or {}).get("repo", "")).split("/")[-1] in slugs)
    # The current name first, so the report names the install the manifests describe.
    state["enabled"] = sorted(
        (key for key, value in (settings.get("enabledPlugins") or {}).items()
         if value is not False and str(key).split("@")[0] in names),
        key=lambda key: (str(key).split("@")[0] != plugin, key))
    enabled_names = {str(key).split("@")[0] for key in state["enabled"]}
    state["old"] = [key for key in state["enabled"] if str(key).split("@")[0] in PLUGIN_NAMES[1:]]
    if len(enabled_names) > 1:
        state["doubled"] = [key for key in state["enabled"] if str(key).split("@")[0] != plugin]
    cache = plugins / "cache"
    if cache.is_dir():
        state["cached"] = sorted(str(path.relative_to(cache))
                                 for name in names for path in cache.glob("*/" + name)
                                 if path.is_dir())
    return state


def _plugin_install_line() -> str:
    state = plugin_install_state()
    live = []
    if state["enabled"] or state["cached"]:
        live.append("marketplace plugin " + (state["enabled"] or state["cached"])[0])
    if state["synced"]:
        live.append("synced home (" + str(manifest_path()) + ")")
    if not live:
        detail = "neither; run `bin/harness install` or `/plugin install %s@%s`" % (
            state["plugin"], state["marketplace"])
    else:
        detail = " and ".join(live)
    if state["registered"] and not (state["enabled"] or state["cached"]):
        detail += "; marketplace registered, plugin not installed"
    line = "  install path: " + detail
    if state["doubled"]:
        line += ("\n  plugin warning: %s and %s are both enabled, so every skill loads twice; "
                 "run `citizen upgrade`, or %s in a session" % (
                     ", ".join(state["doubled"]), state["enabled"][0], " and ".join(
                         "`/plugin uninstall %s`" % key for key in state["doubled"])))
    elif state["old"]:
        line += ("\n  plugin upgrade: %s is the pre-rename plugin ID and fails to load once its "
                 "marketplace updates; run `citizen upgrade`" % ", ".join(state["old"]))
    return line


# One step of `citizen upgrade`: the `claude` argv and the directory it runs in, which is a
# project's for a plugin installed at project or local scope and None for a user install.
UpgradeStep = Tuple[List[str], Optional[str]]


def _run_claude(argv: List[str], cwd: Optional[str] = None) -> int:
    """Run one `claude plugin` command and return its exit status; the seam tests stub."""
    try:
        return subprocess.run(argv, cwd=cwd, check=False).returncode
    except OSError as exc:
        say(f"  {exc}")
        return 127


def _marketplace_source(entry: Any) -> Optional[str]:
    """What `claude plugin marketplace add` takes for a recorded marketplace, or None."""
    source = entry.get("source") if isinstance(entry, dict) else None
    if not isinstance(source, dict):
        return None
    field = {"github": "repo", "git": "url", "url": "url", "directory": "path", "file": "path"}
    value = source.get(field.get(str(source.get("source")), ""))
    return str(value) if value else None


def _installed_scopes(key: str) -> List[Tuple[str, Optional[str]]]:
    """The scopes, with their project directory, `installed_plugins.json` records for a plugin."""
    data = read_json(claude_dir() / "plugins" / "installed_plugins.json") or {}
    records = (data.get("plugins") or {}).get(key) if isinstance(data, dict) else None
    if isinstance(records, dict):
        records = [records]
    scopes: List[Tuple[str, Optional[str]]] = []
    for record in records if isinstance(records, list) else []:
        if not isinstance(record, dict):
            continue
        scope = str(record.get("scope") or "user")
        where = record.get("projectPath") if scope != "user" else None
        if (scope, where) not in scopes:
            scopes.append((scope, where))
    return scopes or [("user", None)]


def plugin_upgrade_plan() -> Tuple[List[str], List[UpgradeStep], List[str]]:
    """The old plugin keys found, the `claude` steps that move them, and what blocks the move.

    Claude Code ignores adding a repository whose old marketplace is still registered, so the
    order is fixed: uninstall the old plugin, remove its marketplace, add the marketplace again
    from its recorded source, install the new ID. docs/runtime-installation.md has the detail.
    """
    state = plugin_install_state()
    old = state["old"]
    if not old:
        return [], [], []
    new_name = PLUGIN_NAMES[0]
    new_key = "%s@%s" % (new_name, new_name)
    known = read_json(claude_dir() / "plugins" / "known_marketplaces.json") or {}
    uninstall: List[UpgradeStep] = []
    remove: List[UpgradeStep] = []
    add: List[UpgradeStep] = []
    scopes: List[Tuple[str, Optional[str]]] = []
    problems: List[str] = []
    for key in old:
        market = key.split("@", 1)[1] if "@" in key else key
        for scope, where in _installed_scopes(key):
            uninstall.append((["claude", "plugin", "uninstall", key, "--scope", scope], where))
            if (scope, where) not in scopes:
                scopes.append((scope, where))
        if market == new_name:
            continue
        remove_step: UpgradeStep = (["claude", "plugin", "marketplace", "remove", market], None)
        if remove_step not in remove:
            remove.append(remove_step)
        if new_name in known:
            continue
        source = _marketplace_source(known.get(market))
        if source is None:
            problems.append("no recorded source for the %s marketplace in %s" % (
                market, claude_dir() / "plugins" / "known_marketplaces.json"))
            continue
        add_step: UpgradeStep = (["claude", "plugin", "marketplace", "add", source], None)
        if add_step not in add:
            add.append(add_step)
    install: List[UpgradeStep] = []
    if new_key not in state["enabled"]:
        install = [(["claude", "plugin", "install", new_key, "--scope", scope], where)
                   for scope, where in scopes]
    return old, uninstall + remove + add + install, problems


def _upgrade_step_text(step: UpgradeStep) -> str:
    argv, where = step
    command = " ".join(shlex.quote(part) for part in argv)
    return "cd %s && %s" % (shlex.quote(where), command) if where else command


def _session_step_text(step: UpgradeStep) -> str:
    """The in-session form of a step, for a machine without the `claude` CLI."""
    argv = list(step[0][2:])
    if "--scope" in argv:
        at = argv.index("--scope")
        del argv[at:at + 2]
    return "/plugin " + " ".join(argv)


def cmd_upgrade(args: argparse.Namespace) -> int:
    old, steps, problems = plugin_upgrade_plan()
    if not old:
        say("citizen upgrade: no pre-rename plugin install found; nothing to do")
        return 0
    say("citizen upgrade: %s -> %s@%s" % (", ".join(old), PLUGIN_NAMES[0], PLUGIN_NAMES[0]))
    if problems:
        for problem in problems:
            say("  " + problem)
        say("  nothing was run; add the marketplace by hand, as docs/runtime-installation.md shows")
        return 1
    if args.dry_run:
        say("  would run, in this order:")
        for step in steps:
            say("    " + _upgrade_step_text(step))
        return 0
    if shutil.which("claude") is None:
        say("  the `claude` CLI is not on PATH; run these in a Claude Code session, in this order:")
        for step in steps:
            say("    " + _session_step_text(step))
        return 1
    for index, step in enumerate(steps):
        say("  run  " + _upgrade_step_text(step))
        status = _run_claude(step[0], step[1])
        if status != 0:
            say("  stopped: that step exited %d; these steps did not run:" % status)
            for rest in steps[index + 1:]:
                say("    " + _upgrade_step_text(rest))
            return 1
    say("  done: %s@%s is installed; skills are now /%s:<name>" % (
        PLUGIN_NAMES[0], PLUGIN_NAMES[0], PLUGIN_NAMES[0]))
    return 0


def _checkout_state() -> str:
    try:
        ref = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, timeout=5).stdout.strip()
        dirty = subprocess.run(["git", "-C", str(REPO), "status", "--porcelain"], capture_output=True, text=True, timeout=5).stdout.strip()
        ahead = subprocess.run(["git", "-C", str(REPO), "rev-list", "--count", "@{upstream}..HEAD"], capture_output=True, text=True, timeout=5).stdout.strip()
        parts = [ref or "?"]
        if dirty:
            parts.append(f"{len(dirty.splitlines())} uncommitted file(s)")
        if ahead and ahead != "0":
            parts.append(f"{ahead} unpushed commit(s)")
        return " · ".join(parts)
    except Exception:
        return "unknown"


def cmd_diff(args: argparse.Namespace) -> int:
    lines = _diff_lines()
    # Drift is measured against what a sync would link, the user's layers. A project or session
    # selection is never linked, so `citizen stances` can differ here with nothing drifting.
    if not args.quiet and selection_override():
        say("  scope   diff compares the user defaults; a project or session selection is not drift")
    if not lines:
        if not args.quiet:
            say("no drift")
        return 0
    if args.quiet:
        say(f"{len(lines)} item(s): " + "; ".join(lines[:3]) + (" …" if len(lines) > 3 else ""))
    else:
        for l in lines:
            say("- " + l)
    return 1


def _version_of(cmd: List[str]) -> str:
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return (out.stdout or out.stderr).strip().splitlines()[0] if (out.stdout or out.stderr).strip() else "installed"
    except FileNotFoundError:
        # What a failed exec proves is that nothing by that name is on PATH; an install this
        # shell cannot reach looks identical, so the report says the checkable thing.
        return "not on PATH"
    except Exception as exc:
        return f"error: {exc}"


def hook_commands(settings: Dict[str, Any]) -> List[str]:
    out: List[str] = []
    for entries in (settings.get("hooks") or {}).values():
        for entry in entries if isinstance(entries, list) else []:
            for hook in (entry.get("hooks") or []) if isinstance(entry, dict) else []:
                command = hook.get("command") if isinstance(hook, dict) else None
                if isinstance(command, str) and command.strip():
                    out.append(command)
    return out


def hook_health(settings: Dict[str, Any]) -> Tuple[int, List[str]]:
    """How many hook commands are registered, and what stops them running.

    Claude Code treats a hook that fails to start as non-blocking, so a missing interpreter or an
    unsynced script path turns every hook into a silent no-op. Two of them are guards — the
    command grader that asks before something irreversible, and the stop gate that runs the
    repository's own checks — so the failure mode is the guards disappearing with nothing said.
    """
    commands = hook_commands(settings)
    problems: List[str] = []
    interpreters: Dict[str, bool] = {}
    for command in commands:
        try:
            parts = shlex.split(command)
        except ValueError:
            continue
        if not parts:
            continue
        name = parts[0]
        if name not in interpreters:
            interpreters[name] = _tool(name) is not None or Path(name).is_file()
        for arg in parts[1:]:
            if not arg.endswith(".py"):
                continue
            script = Path(os.path.expanduser(arg))
            note = f"script not found: {arg}"
            if not script.exists() and note not in problems:
                problems.append(note)
    for name, found in interpreters.items():
        if not found:
            problems.append(f"interpreter not found: {name}")
    return len(commands), problems


def pinned_jev_model() -> Optional[str]:
    """The model id a Jev request names, read from the provider module without building one.

    Importing the module reaches nothing: the client is inert until a caller constructs it, so
    `doctor` can name the pinned model on a machine that has never made a call.
    """
    try:
        import importlib

        return importlib.import_module("harness_core.decisions.jev").DEFAULT_MODEL
    except Exception:
        return None


def jev_call_lines() -> List[str]:
    """What the usage ledger says about calls already made: how many, and what answered last.

    A returned model id that is not the requested one is the thing this exists to surface — a
    provider may serve a request on a model the harness did not ask for, and a report priced at
    the pinned model would then be priced at the wrong rate. The last row says which.
    """
    try:
        rows = decision_ledger.rows()
    except Exception:
        return ["    jev calls: the usage ledger is unreadable"]
    if not rows:
        return ["    jev calls: none recorded; `citizen usage --by provider` reports them once "
                "a point is not off"]
    last = max(rows, key=lambda row: str(row.get("ended") or ""))
    returned = last.get("model") or "(none returned)"
    return [f"    jev calls: {len(rows)} recorded; last {last.get('status') or 'unknown'} at "
            f"{last.get('ended') or 'an unknown time'} returned {returned}",
            "    jev call detail: `citizen usage --by provider` prices them per point and mode"]


def known_providers() -> List[str]:
    """Every provider name `governance.provider` may select, local and transport alike."""
    return sorted(set(decisions_provider.PROVIDERS) | set(decisions_provider.TRANSPORT_PROVIDERS))


def policy_files(name: str, root: Optional[Path] = None) -> List[Dict[str, Any]]:
    """The governance policy files provider `name` reads here, lowest precedence first.

    Empty for `none`, which reads no file. `local`, and `jev` over it, read the user-level file
    beside `config.json` and then this repository's `.agent-harness/governance.json`.
    """
    if name == decisions_provider.NullProvider.name or name not in known_providers():
        return []
    root = Path.cwd() if root is None else Path(root)
    files = [(decisions_provider.USER_LAYER, decisions_provider.user_policy_file()),
             (decisions_provider.REPOSITORY_LAYER, root / decisions_provider.POLICY_FILE)]
    return [{"layer": layer, "path": str(path), "present": path.is_file()}
            for layer, path in files]


def policy_file_lines(name: str, root: Optional[Path] = None) -> List[str]:
    """One line per policy file the provider reads, for `decide` and `doctor`."""
    if name not in known_providers():
        return [f"    governance.provider {name!r} is not a provider; known providers are "
                + ", ".join(known_providers()) + "; no policy file is read"]
    files = policy_files(name, root)
    if not files:
        return [f"    policy files: none read by provider {name}"]
    return [f"    {entry['layer']}: {entry['path']} "
            f"({'present' if entry['present'] else 'absent'})" for entry in files]


def governance_lines(cfg: Dict[str, Any]) -> List[str]:
    """What `doctor` reports about the decision provider and what it may send.

    The mode per decision point, whether the kill switch is in place, and whether a credential
    exists — by variable name. A value is a credential and is never printed, here or anywhere.
    """
    block = cfg.get("governance") if isinstance(cfg.get("governance"), dict) else {}
    name = str(block.get("provider") or decisions_provider.NullProvider.name)
    lines = [f"  governance provider: {name}"] + policy_file_lines(name)
    try:
        controls = decision_controls.Controls.from_config(cfg)
    except decisions_provider.PolicyError as exc:
        return lines + [f"    governance.jev is unreadable: {exc}",
                        "    no provider runs on a configuration nobody can honour"]
    status = controls.status()
    if name != "jev" and not any(mode != "off" for mode in status["modes"].values()):
        return lines + ["    decisions are answered on this machine; no provider reaches the "
                        "network"]
    lines.append("    jev modes: " + ", ".join(f"{point}={mode}"
                                               for point, mode in sorted(status["modes"].items())))
    fields = ", ".join(status["state_fields"]) or "none"
    lines.append(f"    jev sends: {', '.join(decision_controls.BASE_FIELDS)}, and {fields} "
                 f"from the context")
    lines.append("    jev kill switch: {} ({})".format(
        status["sentinel"], "present, every call is off" if status["sentinel_present"]
        else f"absent; create it to stop every call without editing {config_path()}"))
    pinned = pinned_jev_model()
    lines.append("    jev model: " + (f"{pinned} requested on every call" if pinned
                                      else "the provider module is not loadable from this "
                                           "checkout"))
    lines.append("    jev credential: " + (
        f"{status['credential']} is set (the value is never printed)" if status["credential"]
        else "none of " + ", ".join(decision_controls.credential_variables())
        + " is set; every call fails open to the deterministic answer"))
    return lines + jev_call_lines()


def cmd_doctor(args: argparse.Namespace) -> int:
    say(f"model-citizen {VERSION}")
    say(f"  repo: {REPO}")
    say(f"  checkout: {_checkout_state()}")
    say(_plugin_install_line())
    for name, cmd in (("claude", ["claude", "--version"]), ("code", ["code", "--version"]), ("codex", ["codex", "--version"]), ("gh", ["gh", "--version"]), ("python3", [sys.executable, "--version"])):
        say(f"  {name}: {_version_of(cmd)}")
    say(f"  gh login: {_version_of(['gh', 'auth', 'status'])}")
    say(f"  claude credentials present (not proof of login): {(claude_dir() / '.credentials.json').exists() or (home() / '.claude.json').exists()}")
    codex_credentials = (codex_dir() / "auth.json").exists()
    say(f"  codex credentials present (not proof of login): {codex_credentials}")
    if codex_credentials and shutil.which("codex") is None:
        say("    credentials with no `codex` on PATH: the client is installed somewhere this shell "
            "does not look, or was removed and left its login behind. Put it on PATH to use it.")
    say("  constrained roles: use `citizen role run`; `citizen role status` reports workers, not native qualification")
    cfg = load_config()
    if cfg.get("codex", {}).get("manage", True):
        reviewer = codex_client.detect()
        live = codex_reviewer_in_config(reviewer.key)
        say(f"  codex approval reviewer: {reviewer.detail}")
        if posture(cfg) == "auto" and (not reviewer.reliable or live != "auto_review"):
            say("    `permissions=auto` promises automatic approval review; this client will ask "
                "you instead. Re-run `citizen sync` after updating Codex.")
    for runtime, path in (("claude", claude_dir() / "settings.json"),
                          ("codex", codex_dir() / "hooks.json")):
        if not cfg.get(runtime, {}).get("manage", True):
            say(f"  {runtime} hooks: unmanaged")
            continue
        try:
            count, problems = hook_health(read_json(path) or {})
        except (SystemExit, OSError) as exc:
            say(f"  {runtime} hooks: unreadable configuration: {exc}")
            continue
        if not count:
            say(f"  {runtime} hooks: none registered in {path.name}; run `citizen sync`")
        elif problems:
            say(f"  {runtime} hooks: {count} registered, {len(problems)} problem(s); affected hooks cannot run:")
            for problem in problems:
                say(f"    {problem}")
            say("    Hook startup failures can fail silently; command grading and the stop gate may be unavailable.")
        else:
            say(f"  {runtime} hooks: {count} registered, script paths exist; native trust and activation unverified")
    table = load_prices(cfg)
    as_of = newest_as_of(table)
    age = price_age_days(as_of) if as_of else None
    if not table:
        say(f"  prices: none; {PRICES_PATH} is missing or unreadable, `usage` reports tokens only")
    elif age is None:
        say(f"  prices: {len(table)} model(s), no readable as_of date; `usage` dollars may be stale")
    else:
        say(f"  prices: {len(table)} model(s), newest as_of {as_of} ({age} day(s) ago)")
        if age > PRICE_STALE_DAYS:
            say(f"    over {PRICE_STALE_DAYS} days old. Prices go stale silently and the report "
                f"keeps printing dollars; re-read each entry's source and update {PRICES_PATH}.")
    for line in governance_lines(cfg):
        say(line)
    telemetry = telemetry_settings(cfg)
    module = load_telemetry()
    if telemetry.get("export") != "otlp" or module is None:
        say("  telemetry export: off; the usage ledger stays on this machine")
    else:
        try:
            # Header names only. A value is a credential and is never printed, here or anywhere.
            names = sorted(module.headers(telemetry))
            detail = "headers " + (", ".join(names) if names else "none configured")
        except ValueError as exc:
            detail = f"headers unavailable: {exc}"
        say(f"  telemetry export: otlp -> {module.endpoint_label(telemetry['endpoint'])}, {detail}")
        say("    the ledger is the record; replay a window with `citizen usage export --since`")
    runtimes = native_runtimes(telemetry)
    if not runtimes:
        say("  native telemetry: off; neither runtime is asked to export its own")
    else:
        host = module.endpoint_label(telemetry["endpoint"]) if module else telemetry["endpoint"]
        say(f"  native telemetry: on -> {host} ({', '.join(runtimes)})")
        attributes, omitted = resource_attributes(cfg, telemetry)
        # Each runtime is reported from its own live file, never from the config key alone: a
        # name in `native` is a request, and a `manage` switch, a value the harness did not
        # write or a sync that has not run yet can all leave it unhonoured.
        if "claude-code" not in runtimes:
            say("    claude-code: not named by telemetry.native; its settings are left alone")
        elif not cfg.get("claude", {}).get("manage", True):
            say("    claude-code: named by telemetry.native, but claude.manage is off, so `sync` "
                "writes nothing for it")
        else:
            live = read_json(claude_dir() / "settings.json") or {}
            current = (live.get("env") or {}).get("OTEL_RESOURCE_ATTRIBUTES")
            if current is None:
                say("    claude-code: not configured in settings.json; run `citizen sync`")
            elif current == attributes:
                say(f"    claude-code: labels match this version and these stances ({attributes})")
            else:
                say("    claude-code: labels are from an earlier sync and mislabel data until the "
                    f"next one; run `citizen sync`. Wanted {attributes}")
            for name in omitted:
                say(f"    label {name} cannot travel in OTEL_RESOURCE_ATTRIBUTES and is left off")
        if "codex" not in runtimes:
            say("    codex: not named by telemetry.native; its [otel] table is left alone, which "
                "is the setting to use against a collector that requires a header")
        elif not cfg.get("codex", {}).get("manage", True):
            say("    codex: named by telemetry.native, but codex.manage is off, so `sync` writes "
                "nothing for it")
        else:
            config_toml = codex_dir() / "config.toml"
            table = codex_otel_in_config(config_toml.read_text()) if config_toml.is_file() else None
            wanted, _ = codex_native_otel(telemetry, {}, True)
            if table is None or not any(key in table for key in wanted):
                say("    codex: [otel] not configured in config.toml; run `citizen sync`")
            elif all(table.get(key) == value for key, value in (wanted or {}).items()):
                say("    codex: [otel] exports logs and metrics to this endpoint. No header is "
                    "written, because [otel] takes a literal header map; its export needs an "
                    "endpoint that accepts this machine unauthenticated")
            else:
                say("    codex: [otel] holds exporters this endpoint did not ask for — an earlier "
                    "sync, or a value the harness did not write and left alone; run "
                    "`citizen sync` and read what it reports")
        say("    a runtime named here attaches its own user and organization identifiers to what "
            "it sends; read docs/telemetry.md before pointing this at a hosted endpoint")
    remote_control_doctor(cfg)
    stale = placeholder_identity(load_config())
    say("  identity: " + (f"{', '.join(stale)} still at the example value, run `citizen init`"
                          if stale else "set"))
    lines = _diff_lines()
    say("  drift: " + ("none" if not lines else f"{len(lines)} item(s), run `citizen diff`"))
    if shutil.which("claude") and keychain.missing():
        say("  claude doctor: skipped, this HOME has no default keychain and a client launch "
            "would raise a macOS dialog")
    elif shutil.which("claude"):
        say("  claude doctor:")
        try:
            out = subprocess.run(["claude", "doctor"], capture_output=True, text=True, timeout=60)
            for l in (out.stdout or out.stderr).strip().splitlines()[:20]:
                say("    " + l)
        except Exception as exc:
            say(f"    could not run: {exc}")
    return 0


def remote_control_doctor(cfg: Dict[str, Any]) -> None:
    """One line per configured host: is it running, on which environment, is its pointer live.

    A pointer that names a dead environment or a live pid is the failure that strands every
    session on the next outage, so it is reported before it costs anything.
    """
    try:
        opts = remote_control.settings(cfg)
    except ValueError as exc:
        say(f"  remote-control: configuration rejected: {exc}")
        return
    if not opts["folders"]:
        return
    if platform.system() != "Darwin":
        say("  remote-control: launchd agents are macOS only; nothing is serving here")
        return
    projects_root = home() / ".claude" / "projects"
    token = claude_oauth_token()
    page = remote_control.fetch_sessions(token) if token else remote_control.SessionPage(
        remote_control.SessionPage.FAILED)
    rows = page.rows if page.ok else None
    for folder in opts["folders"]:
        name = remote_control.label(folder)
        pid = host_pid(name)
        if pid is None:
            say(f"  remote-control {folder}: not running; `citizen remote-control install`")
            continue
        log = remote_control_log_dir() / (name + ".log")
        text = log.read_text(encoding="utf-8", errors="replace") if log.is_file() else ""
        env = remote_control.environment_id(text) or "none yet"
        pointer = remote_control.read_pointer(remote_control.pointer_path(projects_root, folder))
        if pointer is None:
            fresh = "pointer missing"
        elif pointer.get("environmentId") != env:
            fresh = f"pointer stale, names {pointer.get('environmentId')}"
        elif pointer.get("pid") != pid:
            fresh = f"pointer names pid {pointer.get('pid')}, host is {pid}"
        else:
            fresh = "pointer fresh"
        stalled = remote_control.unreachable_seconds(text)
        reach = "reachable" if not stalled else f"unreachable for {stalled}s"
        mine = [r for r in (rows or []) if r.get("environment_id") == env and r.get("status") == "active"]
        lost = len([r for r in mine if r.get("connection_status") == "disconnected"])
        served = ("sessions not checked" if rows is None
                  else f"{len(mine)} session(s), {lost} disconnected")
        say(f"  remote-control {folder}: pid {pid}, env {env}, {fresh}, {reach}, {served}")
    if rows is None:
        why = ("the page did not arrive newest-first"
               if page.status == remote_control.SessionPage.REFUSED
               else "no claude.ai token, or the API call failed")
        say("  remote-control sessions: not checked; " + why)
        return
    stranded = remote_control.disconnected_sessions(rows, host_environment_ids(opts["folders"]))
    if stranded:
        say(f"  remote-control sessions: {len(stranded)} active but disconnected on this Mac's "
            f"environments{page.scope()}; `citizen remote-control status` prints the reattach "
            "command for each")


def cmd_uninstall(args: argparse.Namespace) -> int:
    try:
        with reconcile.lock(state_dir()):
            return _cmd_uninstall_unlocked(args)
    except ValueError as exc:
        raise SystemExit(str(exc))


def _empty_harness_directories() -> List[Path]:
    """Directories the sync creates for its own files, and only those, when nothing is left in them.

    `rmdir` is the check: a directory still holding anything — a file the harness does not own, a
    preserved link, a user's own skill — refuses to go, so this can never take a file with it.
    """
    candidates = [claude_dir() / "rules" / "harness-stances"]
    roots_dir = claude_dir() / "rules" / EXTERNAL_RULES_DIR
    if roots_dir.is_dir():
        candidates.extend(sorted(p for p in roots_dir.iterdir() if p.is_dir() and not p.is_symlink()))
    skills_home = home() / ".agents" / "skills"
    if skills_home.is_dir():
        candidates.extend(sorted(p for p in skills_home.glob("harness-*") if p.is_dir() and not p.is_symlink()))
    empty = [d for d in candidates if d.is_dir() and not d.is_symlink() and not any(d.iterdir())]
    # The per-root directory goes before the directory holding it, and only when every child
    # under it is itself on the way out; `rmdir` still has the final say on both.
    if roots_dir.is_dir() and not roots_dir.is_symlink() and all(c in empty for c in roots_dir.iterdir()):
        empty.append(roots_dir)
    return empty


def _cmd_uninstall_unlocked(args: argparse.Namespace) -> int:
    manifest = read_json(manifest_path()) or {}
    if not manifest and not (state_dir() / "ownership.json").exists():
        say("nothing to uninstall (no manifest)")
        return 0
    conflicts = []
    for link in manifest.get("links", []):
        p = Path(link["path"])
        if p.is_symlink() and (_leads_to(p, link["target"]) or _leads_to(p, link.get("pending_from"))):
            p.unlink()
            say(f"  unlink  {p}")
        elif p.exists() or p.is_symlink():
            conflicts.append(str(p) + ": changed link or replacement preserved")
    # The per-rule directory goes now, before adopted files return, so a path the user had there
    # before the harness comes back instead of reading as occupied. A file the user added keeps it.
    rules_home = claude_dir() / "rules" / RULES_DIR
    made = any(i.get("path") == str(rules_home) and (i.get("applied") or {}).get("type") == "directory"
               for i in manifest.get("migrated", []))
    if made and rules_home.is_dir() and not rules_home.is_symlink():
        try:
            rules_home.rmdir()
            say(f"  remove  {rules_home}")
        except OSError:
            pass
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    sf = claude_dir() / "settings.json"
    live = read_json(sf)
    if live is not None and str(sf) not in reconcile.Store(state_dir()).data["files"]:
        write_json_atomic(sf, strip_claude_settings(live, template, installed_output_style()), backup=True)
        say(f"  strip   {sf}")
    store = reconcile.Store(state_dir())
    store.uninstall()
    # Restore adopted files last: the harness file occupying the destination — a link removed
    # above, or a generated file the store has just undone — is gone by now, so a path the
    # harness took over with `--adopt` comes back instead of being reported as occupied.
    for item in manifest.get("adopted", []):
        src, dst = Path(item["moved_to"]), Path(item["path"])
        if src.exists() or src.is_symlink():
            if dst.exists() or dst.is_symlink():
                conflicts.append(str(dst) + ": adopted backup retained; destination is occupied")
            else:
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(src), str(dst))
                say(f"  restore {dst}")
    store.conflicts.extend(conflicts)
    for conflict in store.conflicts:
        say("  conflict " + conflict)
    if remove_gitignore_entries():
        say(f"  restore {global_gitignore_path()}")
    if remove_local_bin_from_path():
        say(f"  restore {home() / '.zprofile'}")
    # The usage feed's per-session files, the session registry and the write-intent claims are
    # harness state, not the user's: an offset, counts, agent type names, the registry each
    # session started with and the paths it claimed, all written by this install. The usage log and the decision log stay, because they are the
    # measurement history `harness usage` reports and nobody else writes them.
    for name in ("feed", "sessions", "intents"):
        directory = state_dir() / name
        if directory.is_dir():
            shutil.rmtree(str(directory), ignore_errors=True)
            say(f"  remove  {directory}")
    for directory in _empty_harness_directories():
        try:
            directory.rmdir()
        except OSError:
            continue
        say(f"  remove  {directory}")
    if not store.conflicts:
        for f in (manifest_path(), applied_path()):
            if f.exists():
                f.unlink()
    say("uninstalled; personal files, config and the checkout are untouched")
    return 2 if store.conflicts else 0


def lint_files(root: Path, files: List[Path], terms: Optional[Tuple[List[str], List[str]]] = None) -> List[str]:
    """Lint the given files (paths under root). No file is exempt, including this one."""
    hits: List[str] = []
    everywhere, docs_ok = terms if terms is not None else load_lint_terms()
    names = [re.compile(r"(?i)\b" + re.escape(t) + r"\b") for t in maintainer_terms(root)]
    docs_only = [re.compile(r"(?i)\b" + re.escape(t) + r"\b") for t in docs_ok]
    shapes = [(label, re.compile(p)) for label, p in SHAPE_PATTERNS]
    secrets = [re.compile(p) for p in SECRET_PATTERNS]
    retired = retired_names.applies(root)
    if not secrets:
        # An empty list would pass every file silently; say so instead, on every lint path.
        hits.append("secrets: pattern list unavailable, claude/hooks/rule-detectors.py did not import")
    for path in files:
        if not path.is_file() or path.is_symlink():
            continue
        rel = path.relative_to(root)
        if any(part in LINT_SKIP_DIRS for part in rel.parts):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        installed = rel.parts[0] in NAME_FORBIDDEN_DIRS or rel.name in NAME_FORBIDDEN_FILES
        # The project was renamed; retired_names says what stays out and what keeps it on purpose.
        check_retired = retired and retired_names.allowed_path(rel.as_posix()) is None
        released = retired_names.released_lines(rel.as_posix(), text.splitlines()) if check_retired else set()
        for n, line in enumerate(text.splitlines(), 1):
            low = line.lower()
            for term in everywhere:
                if term in low:
                    hits.append(f"{rel}:{n}: personal term from lint-terms file")
            if rel.parts[0] != "docs":
                for rx in docs_only:
                    if rx.search(line):
                        hits.append(f"{rel}:{n}: project name allowed only under docs/")
            if installed:
                for rx in names:
                    if rx.search(line):
                        hits.append(f"{rel}:{n}: maintainer name in installed content")
            for label, rx in shapes:
                if rx.search(line):
                    hits.append(f"{rel}:{n}: {label}")
            for rx in secrets:
                if rx.search(line):
                    hits.append(f"{rel}:{n}: secret pattern {rx.pattern}")
            if check_retired and n not in released:
                for label in retired_names.line_findings(line):
                    hits.append(f"{rel}:{n}: retired-name: the old project {label}")
    return hits


def check_detectors(root: Path) -> List[str]:
    """Fail when a rule file has neither a detector nor an explicit opt-out.

    A rule nobody can measure is a rule nobody can prune; `harness usage --rules` reports
    the hits, and this check is what keeps the registry honest as rules are added.
    """
    rules = sorted(p.stem for p in (root / "claude" / "rules").glob("*.md"))
    if not rules:
        return []
    module = load_detectors(root)
    if module is None:
        return ["detectors: claude/hooks/rule-detectors.py is missing or does not import"]
    measured = {d.rule for d in module.DETECTORS.values()}
    hits = []
    for stem in rules:
        if stem in measured or stem in module.OPT_OUT:
            continue
        hits.append(f"detectors: claude/rules/{stem}.md has no detector and no OPT_OUT entry")
    if hits:
        hits.append("detectors: add a Detector with rule=\"<stem>\" to DETECTORS, or an OPT_OUT "
                    "entry giving the one-line reason nothing in a transcript can decide it")
    return hits


def check_collisions(root: Path) -> List[str]:
    """Fail when one skill, agent or command name is defined in two primitive roots.

    The runtimes pick a winner silently; `harness_core.collisions` says why that is refused.
    """
    try:
        cfg = load_config()
    except Exception:
        cfg = {}
    return collisions.findings(root, cfg)


NUMBER_WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
                "ten", "eleven", "twelve"]


def check_cost_sidecars(root: Path) -> List[str]:
    """Fail when a shipped cost sidecar breaks the schema or disagrees with its own prose.

    A variant is read by a person as prose and by the resolver as data, and only one of the two
    is tested by anything else. Holding `session_effort` and `max_parallel` to words in the `.md`
    is what stops the pair drifting into two different opinions.
    """
    posture = load_posture(root)
    directory = root / "primitives" / "stances" / "cost"
    if posture is None or not directory.is_dir():
        return []
    hits = []
    for path in sorted(directory.glob("*.json")):
        rel = path.relative_to(root)
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except ValueError as exc:
            hits.append(f"{rel}: not readable JSON: {exc}")
            continue
        if not isinstance(data, dict):
            hits.append(f"{rel}: not a JSON object")
            continue
        roles = posture.role_catalog(None, root)[0]
        hits += [f"{rel}: {finding}" for finding in posture.validate_sidecar(data, roles or None)[1]]
        prose = path.with_suffix(".md")
        if not prose.is_file():
            hits.append(f"{rel}: no {prose.name} beside it")
            continue
        text = prose.read_text(encoding="utf-8").lower()
        switches = data.get("switches") if isinstance(data.get("switches"), dict) else {}
        effort = switches.get("session_effort")
        if isinstance(effort, str) and not re.search(r"\b" + re.escape(effort.lower()) + r"\b", text):
            hits.append(f"{rel}: session_effort '{effort}' is not a word in {prose.name}")
        width = switches.get("max_parallel")
        if isinstance(width, int) and not isinstance(width, bool):
            spellings = [str(width)] + ([NUMBER_WORDS[width]] if width < len(NUMBER_WORDS) else [])
            if not any(re.search(r"\b" + s + r"\b", text) for s in spellings):
                hits.append(f"{rel}: max_parallel {width} is not written in {prose.name}")
    return hits


def check_stance_constraints(root: Path) -> List[str]:
    """Fail when the shipped constraints do not load, or the shipped defaults violate one.

    The constraints are the machine-readable half of a claim two variants, or a variant and a
    role contract, otherwise make only in prose. Evaluating them against `config.example.json`
    is what catches a new variant, a new role or a reworded default landing in a contradiction.
    """
    path = root / "primitives" / "constraints.json"
    if not path.is_file():
        return []
    rel = path.relative_to(root)
    cfg = {"stances": (read_json(root / "config.example.json") or {}).get("stances", {}),
           "primitive_roots": []}
    try:
        rules = primitive_catalog.stance_constraints(root, cfg)
        hits = [f"stance-constraints: the default selection violates a constraint: {c}"
                for c in primitive_catalog.stance_conflicts(root, cfg)]
    except ValueError as exc:
        return [f"stance-constraints: {rel}: {exc}"]
    if not rules:
        return [f"stance-constraints: {rel} ships no constraint; delete the file or state one"]
    if hits:
        hits.append("stance-constraints: change the default selection, the variant prose, or the "
                    "constraint that no longer holds; a role a constraint exempts goes in its `allow`")
    return hits


def lint_tree(root: Path, terms: Optional[Tuple[List[str], List[str]]] = None) -> List[str]:
    """Lint everything git would commit: tracked files plus untracked files that are not ignored.
    Outside a git repository, every file.

    Untracked files under `.agent-harness/` are the exception. That directory stays unignored so a
    handoff can read its plans, which leaves every session's local notes one listing away from
    reddening another session's gate; staging one brings it back into the lint before it commits.
    """
    def listed(*flags: str) -> List[str]:
        out = subprocess.run(["git", "-C", str(root), "ls-files", *flags, "-z"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode != 0:
            raise RuntimeError(out.stderr)
        return [f for f in out.stdout.split("\0") if f]
    try:
        tracked = listed("--cached")
        untracked = [f for f in listed("--others", "--exclude-standard")
                     if not f.startswith(LOCAL_WORK_DIR + "/")]
        files = sorted(root / f for f in set(tracked + untracked))
        return lint_files(root, files, terms) + check_detectors(root)
    except Exception:
        pass
    return lint_files(root, sorted(p for p in root.rglob("*") if p.is_file()), terms) + check_detectors(root)


def _line_count(path: Path) -> int:
    return len(path.read_text(encoding="utf-8").splitlines())


def est_tokens(chars: int) -> int:
    """Characters to tokens, the tokenizer-free approximation. See CHARS_PER_TOKEN."""
    return int(round(chars / CHARS_PER_TOKEN))


def always_loaded_groups(root: Path) -> List[Tuple[str, int, int]]:
    """Everything loaded on every turn, as [(group, lines, chars)].

    The stance total is the worst case — the longest variant of each dimension — so the caps hold
    for every selection a user could make, not only the default one.
    """
    groups: List[Tuple[str, int, int]] = []

    def size(path: Path) -> Tuple[int, int]:
        body = path.read_text(encoding="utf-8")
        return len(body.splitlines()), len(body)

    claude_md = root / "claude" / "CLAUDE.md"
    if claude_md.is_file():
        lines, chars = size(claude_md)
        groups.append(("claude/CLAUDE.md", lines, chars))
    rules = sorted((root / "claude" / "rules").glob("*.md"))
    if rules:
        plural = "file" if len(rules) == 1 else "files"
        sizes = [size(p) for p in rules]
        groups.append((f"claude/rules/ ({len(rules)} {plural})",
                       sum(s[0] for s in sizes), sum(s[1] for s in sizes)))
    stances = root / "claude" / "stances"
    if stances.is_dir():
        for d in sorted(p for p in stances.iterdir() if p.is_dir()):
            variants = sorted(d.glob("*.md"))
            if not variants:
                continue
            worst = max(variants, key=lambda p: (_line_count(p), p.name))
            lines, chars = size(worst)
            groups.append((f"claude/stances/{d.name}/ (longest: {worst.name})", lines, chars))
    return groups


def effective_always_loaded_lines(root: Path, selection: Dict[str, Any]) -> int:
    """Lines always loaded under one selection: the set `always_loaded_groups` counts, with the
    rules the selection switches off left out and each stance at its selected variant.

    Information only. The caps stay on the worst case, so no selection moves the lint's figure.
    """
    total = 0
    claude_md = root / "claude" / "CLAUDE.md"
    if claude_md.is_file():
        total += _line_count(claude_md)
    off = switched_off(selection)["rules"]
    total += sum(_line_count(p) for p in sorted((root / "claude" / "rules").glob("*.md"))
                 if p.stem not in off)
    for dimension, variant in sorted((selection.get("stances") or {}).items()):
        path = root / "claude" / "stances" / dimension / (str(variant) + ".md")
        if variant and path.is_file():
            total += _line_count(path)
    return total


def always_loaded_lines(root: Path) -> Tuple[int, List[Tuple[str, int]]]:
    """Line counts of the always-loaded set, as (total, [(group, lines)])."""
    groups = always_loaded_groups(root)
    return sum(g[1] for g in groups), [(name, lines) for name, lines, _ in groups]


def always_loaded_tokens(root: Path) -> Tuple[int, List[Tuple[str, int]]]:
    """Estimated token counts of the always-loaded set, as (total, [(group, tokens)])."""
    groups = always_loaded_groups(root)
    return est_tokens(sum(g[2] for g in groups)), [(name, est_tokens(chars)) for name, _, chars in groups]


def context_summary(root: Path) -> str:
    """One line for `harness lint` naming both measures and both caps, pass or fail."""
    groups = always_loaded_groups(root)
    lines = sum(g[1] for g in groups)
    tokens = est_tokens(sum(g[2] for g in groups))
    return (f"context: always-loaded is ~{tokens} tokens of {ALWAYS_LOADED_TOKEN_CAP} "
            f"and {lines} lines of {ALWAYS_LOADED_CAP} "
            f"(instructions, rules and the longest variant of every stance; "
            f"benchmarks/static.json counts a wider set)")


def check_context_cap(root: Path) -> List[str]:
    """Fail when always-loaded context exceeds either cap, printing the breakdown."""
    groups = always_loaded_groups(root)
    if not groups:
        return []
    lines = sum(g[1] for g in groups)
    tokens = est_tokens(sum(g[2] for g in groups))
    hits = []
    if lines > ALWAYS_LOADED_CAP:
        hits.append(f"context-cap: always-loaded context is {lines} lines, "
                    f"over the {ALWAYS_LOADED_CAP}-line cap")
    if tokens > ALWAYS_LOADED_TOKEN_CAP:
        hits.append(f"context-cap: always-loaded context is ~{tokens} tokens, "
                    f"over the {ALWAYS_LOADED_TOKEN_CAP}-token cap (issue #430)")
    if not hits:
        return []
    for name, n, chars in sorted(groups, key=lambda g: (-g[2], g[0])):
        hits.append(f"context-cap:   {n:4d} lines  ~{est_tokens(chars):5d} tokens  {name}")
    hits.append("context-cap: keep the operative lines in the rule and move the rest into the skill it "
                "points at (see the harness-authoring skill)")
    return hits


def lint_staged(root: Path) -> List[str]:
    out = subprocess.run(["git", "-C", str(root), "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                         capture_output=True, text=True, timeout=10)
    files = [root / f for f in out.stdout.split() if (root / f).is_file()]
    return lint_files(root, files)


def cmd_lint(args: argparse.Namespace) -> int:
    root = Path(args.path).resolve() if args.path else REPO
    if getattr(args, "staged", False):
        hits = lint_staged(root)
        scope = "staged files"
    else:
        hits = lint_tree(root)
        scope = str(root)
    hits = hits + check_context_cap(root) + check_cost_sidecars(root) + check_stance_constraints(root)
    hits += check_collisions(root)
    notes: List[str] = []
    # Fragments are this repository's release process, so the rule uses projection drift's guard.
    if not getattr(args, "staged", False) and (root / "primitives" / "roles").is_dir():
        hits += changelog_fragments.findings(root, notes)
    if (root / "primitives" / "roles").is_dir():
        hits += ["projection drift: " + name + "; run `citizen generate`"
                 for name in primitive_catalog.projection_drift(root)]
    for h in hits + notes:
        say(h)
    if not getattr(args, "staged", False) and always_loaded_groups(root):
        say(context_summary(root))
    everywhere, _ = load_lint_terms()
    note = "" if everywhere else " (no personal lint-terms file; shapes and secrets only)"
    say(f"lint: {len(hits)} finding(s) in {scope}{note}")
    return 1 if hits else 0


def cmd_catalog(args: argparse.Namespace) -> int:
    print(json.dumps(primitive_catalog.catalog(REPO), indent=2))
    return 0


def cmd_generate(args: argparse.Namespace) -> int:
    changed = primitive_catalog.projection_drift(REPO)
    if args.check:
        for name in changed:
            say("projection drift: " + name)
        return 1 if changed else 0
    for name, content in primitive_catalog.projections(REPO).items():
        if name in changed:
            (REPO / name).write_text(content, encoding="utf-8")
            say("generated " + name)
    return 0


def cmd_stances(args: argparse.Namespace) -> int:
    cfg = load_config()
    # Non-strict for the same reason the cost table is: a command whose job is to say what is in
    # force must name the conflict, not die of it. `harness sync` still refuses the selection.
    choices = resolve_stances(cfg, strict=False)
    data = {"schema_version": 1, "precedence": ["defaults", "user", "project", "session"],
            "stances": {name: {"variant": path.stem, "source": str(path),
                                "behavior": path.read_text(encoding="utf-8").strip()}
                        for name, path in choices.items()}}
    data["sources"] = {name: source for name, source in load_selection()["sources"]["stances"].items()
                       if name in data["stances"]}
    data["adapter_coverage"] = compatibility.coverage(REPO, choices)
    data["conflicts"] = stance_conflicts(cfg)
    posture = load_posture()
    # Non-strict: a cost sidecar nobody can read is reported here, not raised as a traceback
    # over a command whose job is to tell you what is in force.
    cost = posture.table_for(cfg["stances"], cfg, strict=False) if posture is not None else None
    if cost is not None:
        data["cost"] = cost
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        for name, choice in data["stances"].items():
            say(name + "=" + choice["variant"] + "\n" + choice["behavior"] + "\n")
        if cost is not None:
            s = cost["switches"]
            say("cost table: " + ", ".join(f"{k}={v}" for k, v in sorted(s.items())) +
                f" · rows={len(cost['rows'])} · default_band={cost['default_band']}" +
                (" · class applies" if cost["class_applies"] else " · class advisory only"))
            say("cost sources: " + " <- ".join(c["source"] for c in cost["extends_chain"]) +
                " (full table: `citizen stances --json`)")
            if cost["warnings"]:
                say(f"cost warnings: {len(cost['warnings'])}; `citizen stances --json` names them")
        for conflict in data["conflicts"]:
            say("stance conflict: " + conflict)
        if data["conflicts"]:
            say("stance conflict: `citizen sync` refuses this selection; change one of the two.")
        say("Native runtime restrictions still apply; stance guidance is not proof of enforcement.")
    return 0


def cmd_selection(args: argparse.Namespace) -> int:
    """Print every unit of every kind with its value and source; the shape is `docs/preferences.md`'s.

    The JSON is a selection document, so it reads back unchanged as a `HARNESS_SESSION_CONFIG`.
    """
    data = load_selection()
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    module = load_posture()
    declared = module.manifests(read_json(config_path()) or {}, REPO)[0]
    say("mode=" + (data["mode"] or "none") + " (" + data["sources"]["mode"] + ")")
    for kind, units in data.get("shadowed", {}).items():
        for unit, source in units.items():
            say("shadowed " + kind + "." + unit + ": the mode's value is overridden by " + source)
    for kind, units in data.items():
        if kind in ("mode", "sources", "shadowed"):
            continue
        for unit, value in units.items():
            # A switch unit reports what measures it; one with no instrument is unmeasured.
            shown = " " + module.measurement(declared[kind].get(unit)) if kind in declared else ""
            say(kind + "." + unit + "=" + str(value) + " (" + data["sources"][kind][unit] + ")" + shown)
    worst, _ = always_loaded_lines(REPO)
    say(f"always-loaded: {effective_always_loaded_lines(REPO, data)} lines for this selection; "
        f"the lint caps the worst case, {worst} of {ALWAYS_LOADED_CAP}")
    return 0


def cmd_decide(args: argparse.Namespace) -> int:
    """Ask the selected decision provider about one action, and print what it answered.

    A reporting command, like `stances`: it changes nothing. The `grade-bash` hook asks the same
    provider about each Bash command the stance lets through (`docs/runtime-controls.md`). It
    exists so a policy file can be checked against the counterparty it will be read under,
    rather than the first time a hook reads it. Changing nothing includes the ledger, so a
    provider that would record its own call is silenced for the length of this question.
    """
    cfg = load_config()
    slug = args.counterparty or decisions_provider.counterparty(str(Path.cwd()))
    try:
        provider = decisions_provider.select_provider(cfg, root=str(Path.cwd()))
        action = decisions_provider.Action(action_class=args.action, grade=args.grade)
        with decisions_provider.events_suppressed():
            answer = provider.decide(action, slug)
    except decisions_provider.PolicyError as exc:
        raise SystemExit(str(exc))
    files = policy_files(provider.name)
    if args.json:
        print(json.dumps({"schema_version": 1, "action": action.as_dict(), "counterparty": slug,
                          "decision": answer.as_dict(), "policy_files": files}, indent=2))
        return 0
    say(f"{args.action} on {slug}: {answer.outcome} "
        f"(level {answer.autonomy_level}, provider {answer.provider})")
    say(answer.reason)
    for match in answer.injected_cognition["rule_matches"]:
        say("  rule: " + match)
    for line in policy_file_lines(provider.name):
        say(line.replace("    ", "  ", 1))
    if answer.injected_cognition["agent_message"]:
        say("  agent: " + answer.injected_cognition["agent_message"])
    say("The grade-bash hook consults this provider for every Bash command the autonomy stance "
        "lets through, and can only add a prompt.")
    return 0


def cmd_workspace(args: argparse.Namespace) -> int:
    if args.action == "list":
        return workspace_list()
    if args.action == "open":
        return workspace_open(args.name, args.passthrough, codex=args.codex, dry_run=args.dry_run)
    name = args.name
    folders = [str(Path(f).expanduser().resolve()) for f in args.folders]
    if not folders:
        raise SystemExit("workspace create needs at least one folder; the first is the root")
    if not args.no_harness and str(REPO) not in folders:
        folders.append(str(REPO))
    out = Path.cwd() / f"{name}.code-workspace"
    if out.exists() and not args.force:
        raise SystemExit(f"{out} exists; pass --force to overwrite")
    template = (REPO / "vscode" / "workspace.template.code-workspace").read_text(encoding="utf-8")
    body = template.replace("__FOLDERS__", json.dumps([{"path": f} for f in folders], indent=2))
    out.write_text(body, encoding="utf-8")
    say(f"wrote {out}")
    # Session store keyed off the first folder; one store, symlinked from every possible root key.
    projects = claude_dir() / "projects"
    stores = claude_dir() / "workspaces"
    store = stores / name
    store.mkdir(parents=True, exist_ok=True)
    (store / "memory").mkdir(exist_ok=True)
    projects.mkdir(parents=True, exist_ok=True)
    for f in folders:
        key = projects / f.replace("/", "-")
        if key.is_symlink():
            continue
        if key.exists():
            say(f"  {key} already holds history; leaving it alone (see docs/workspaces.md to merge it)")
            continue
        os.symlink(os.path.relpath(store, projects), key)
        say(f"  session key {key.name} -> workspaces/{name}")
    say(f"open with: code {out}")
    return 0


WORKSPACES_UNSET = ("workspaces_dir is not set; point it at the folder holding your .code-workspace "
                    "files: citizen config set workspaces_dir ~/path/to/folder")


def workspaces_dir() -> Optional[str]:
    """The configured folder of `.code-workspace` files, or None: unset turns the feature off."""
    value = load_config().get("workspaces_dir")
    return value if isinstance(value, str) and value.strip() else None


def workspace_list() -> int:
    """Every workspace with its members and instruction size, then how each shared folder resolves."""
    directory = workspaces_dir()
    if directory is None:
        print(WORKSPACES_UNSET, file=sys.stderr)
        return 1
    found = workspaces.workspace_map(directory)
    names = {ws["name"] for ws in found["workspaces"]}
    overrides = workspaces.read_overrides(directory, names)
    print(f"workspaces in {found['directory']}")
    if not found["workspaces"]:
        print("  none: no .code-workspace file in this folder")
    for ws in found["workspaces"]:
        sizes = {m: sum(len(text) for _, text in workspaces.member_instructions(m)["files"])
                 for m in ws["members"]}
        print(f"{ws['name']}: {len(ws['members'])} member(s), {sum(sizes.values()):,} characters of instructions")
        for index, folder in enumerate(ws["folders"], 1):
            detail = f"{sizes[folder]:,} characters" if folder in sizes else "missing"
            print(f"  {index}. {folder}  ({detail})")
    counts: Dict[str, int] = {}
    for ws in found["workspaces"]:
        for folder in ws["members"]:
            counts[folder] = counts.get(folder, 0) + 1
    shared = sorted(folder for folder, count in counts.items() if count > 1)
    if shared:
        print("shared folders")
    for folder in shared:
        answer = workspaces.resolve(folder, directory, env={}, ws_map=found, overrides=overrides)
        if answer["workspace"] is not None:
            print(f"  {folder} -> {answer['workspace']['name']} ({answer['rule']})")
        elif answer["rule"] == "override-none":
            print(f"  {folder} -> none (override-none)")
        else:
            print(f"  {folder} -> none: candidates {', '.join(answer['candidates'])}; "
                  f"pin one in {Path(found['directory']) / workspaces.OVERRIDES}")
    ignored = dict(overrides["unknown"])
    for folder, name in overrides["overrides"].items():
        holders = [ws["name"] for ws in found["workspaces"] if folder in ws["members"]]
        if name is not None and name not in holders:
            ignored[folder] = name
    if ignored:
        print("ignored overrides")
    for folder, name in sorted(ignored.items()):
        reason = "no such workspace" if name not in names else "that workspace does not contain it"
        print(f"  {folder} -> {name}: {reason}")
    problems = found["errors"] + overrides["errors"]
    if problems:
        print("unreadable")
    for line in problems:
        print("  " + line)
    return 0


class PassthroughParser(argparse.ArgumentParser):
    """A subcommand parser that hands everything after the first `--` to `passthrough`.

    Python 3.9's argparse fills an optional positional with nothing when an option comes before
    `--`, then rejects what follows, so `open NAME --dry-run -- ARGS` needs the split done here.
    """

    def parse_known_args(self, args=None, namespace=None):  # type: ignore[override]
        args = list(sys.argv[1:] if args is None else args)
        tail: List[str] = []
        if "--" in args:
            at = args.index("--")
            args, tail = args[:at], args[at + 1:]
        namespace, extras = super().parse_known_args(args, namespace)
        if hasattr(namespace, "passthrough"):
            namespace.passthrough = list(namespace.passthrough) + tail
        elif tail:
            extras = extras + ["--"] + tail
        return namespace, extras


def workspace_open(name: str, passthrough: Sequence[str], codex: bool = False, dry_run: bool = False) -> int:
    """Launch Claude Code or Codex in a workspace's first member with the others as `--add-dir`.

    Passthrough arguments go before the `--add-dir` flags: Claude's `--add-dir` is variadic, so a
    prompt after it would be read as one more folder.
    """
    directory = workspaces_dir()
    if directory is None:
        raise SystemExit(WORKSPACES_UNSET)
    path = Path(directory).expanduser() / f"{name}{workspaces.SUFFIX}"
    if not path.is_file():
        raise SystemExit(f"no workspace {name}: {path} does not exist; `citizen workspace list` shows them")
    try:
        ws = workspaces.parse_workspace(str(path))
    except ValueError as exc:
        raise SystemExit(f"workspace {name} is unreadable: {exc}")
    if not ws["members"]:
        raise SystemExit(f"workspace {name} has no existing folder to open")
    first, others = ws["members"][0], ws["members"][1:]
    for folder in ws["missing"]:
        print(f"skipping missing folder {folder}", file=sys.stderr)
    added = [part for folder in others for part in ("--add-dir", folder)]
    command = (["codex"] + list(passthrough) + ["-C", first] + added if codex
               else ["claude"] + list(passthrough) + added)
    if dry_run:
        print("cd " + shlex.quote(first))
        print(f"{workspaces.ENV}={shlex.quote(name)} " + " ".join(shlex.quote(part) for part in command))
        return 0
    env = dict(os.environ)
    env[workspaces.ENV] = name
    os.chdir(first)
    try:
        os.execvpe(command[0], command, env)
    except OSError as exc:
        raise SystemExit(f"could not run {command[0]}: {exc.strerror}")
    return 0


# --------------------------------------------------------------------------- worktrees


WORKTREE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

#: Ignored directories a quality gate writes and a later run rebuilds, so they do not count as
#: work when a checkout is judged. `git worktree remove` deletes ignored files with the checkout,
#: which is why every other ignored entry still refuses.
REGENERABLE_DIRS = ("__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", "node_modules", ".astro")


def worktree_root() -> Path:
    """The dedicated root for disposable task checkouts."""
    configured = os.environ.get("HARNESS_WORKTREE_ROOT")
    return Path(configured).expanduser().resolve() if configured else (home() / "worktrees").resolve()


def git_root(start: str) -> Path:
    probe = subprocess.run(
        ["git", "-C", str(Path(start).expanduser()), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True, timeout=10,
    )
    if probe.returncode != 0:
        raise SystemExit(probe.stderr.strip() or f"{start} is not inside a git repository")
    common = Path(probe.stdout.strip()).resolve()
    if common.name != ".git":
        raise SystemExit(f"unsupported bare repository: {start}")
    return common.parent


def worktree_destination(repo: Path, name: str) -> Path:
    if not WORKTREE_NAME.fullmatch(name):
        raise SystemExit("worktree name must use only letters, numbers, dots, underscores, and hyphens")
    return worktree_root() / repo.name / name


def ensure_worktree_bucket(repo: Path) -> Path:
    bucket = worktree_root() / repo.name
    marker = bucket / ".harness-repository"
    identity = str((repo / ".git").resolve())
    if marker.exists() and marker.read_text(encoding="utf-8").strip() != identity:
        raise SystemExit(f"{bucket} belongs to a different repository; set HARNESS_WORKTREE_ROOT")
    if not marker.exists() and bucket.exists() and any(bucket.iterdir()):
        raise SystemExit(f"refusing to claim non-empty worktree bucket without a repository marker: {bucket}")
    bucket.mkdir(parents=True, exist_ok=True)
    if not marker.exists():
        marker.write_text(identity + "\n", encoding="utf-8")
    return bucket


def _git(repo: Path, *args: str, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo), *args], check=False, capture_output=capture,
        text=True, timeout=120,
    )


def _registered_worktrees(repo: Path) -> List[Dict[str, str]]:
    out = _git(repo, "worktree", "list", "--porcelain", capture=True)
    if out.returncode != 0:
        raise SystemExit(out.stderr.strip() or "git worktree list failed")
    records: List[Dict[str, str]] = []
    current: Dict[str, str] = {}
    for line in out.stdout.splitlines() + [""]:
        if not line:
            if current:
                records.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value
    return records


def classify_worktree_status(text: str, also_clear: Sequence[str] = ()) -> Tuple[List[str], List[str]]:
    """Split `git status --porcelain --ignored --untracked-files=all` output into two lists.

    Returns the regenerable ignored entries, which do not count, and everything else, which blocks a
    removal: tracked changes, untracked files, and ignored entries that are not caches. An entry
    is regenerable only when git marks it `!!` and either one of its path components is a known
    cache name or its first component is an `--also-clear` name: a name the caller typed covers
    that one top-level directory, not every directory of that name. A path git had to quote is
    never treated as regenerable, so an unusual name is refused rather than deleted on a guess.
    """
    known, named = set(REGENERABLE_DIRS), set(also_clear)
    regenerable: List[str] = []
    blocking: List[str] = []
    for line in text.splitlines():
        if not line.strip():
            continue
        code, path = line[:2], line[3:]
        parts = [part for part in path.split("/") if part]
        cache = any(part in known for part in parts) or (bool(parts) and parts[0] in named)
        if code == "!!" and not path.startswith('"') and cache:
            regenerable.append(path)
        else:
            blocking.append(path)
    return regenerable, blocking


def merged_head_refusal(repo: Path, branch: str, tip: str) -> Optional[str]:
    """Why `branch` is not proven merged at `tip`, or None when a merged pull request holds it.

    Ancestry is the wrong test here: the repository squash-merges and deletes the remote branch,
    so the branch's own commits never become ancestors of the default branch. The merged pull
    request's head commit is the proof instead. Anything short of one match refuses.
    """
    gh = shutil.which("gh")
    if gh is None:
        return "gh is not installed, so the merge cannot be proven"
    out = subprocess.run(
        [gh, "pr", "list", "--head", branch, "--state", "merged",
         "--json", "number,headRefOid,isCrossRepository"],
        cwd=str(repo), check=False, capture_output=True, text=True, timeout=60,
    )
    if out.returncode != 0:
        detail = out.stderr.strip().splitlines()
        return detail[-1] if detail else "gh pr list failed"
    try:
        records = json.loads(out.stdout.strip() or "[]")
    except json.JSONDecodeError:
        return "gh pr list did not return JSON"
    # `--head` matches a branch name in any fork, and a fork's branch is not this one.
    records = [record for record in records if not record.get("isCrossRepository")]
    if not records:
        return f"no merged pull request has {branch} as its head branch"
    if any(record.get("headRefOid") == tip for record in records):
        return None
    heads = ", ".join(f"#{record.get('number')} at {str(record.get('headRefOid'))[:12]}" for record in records)
    return f"local tip {tip[:12]} is not the merged head ({heads})"


#: The BMad merge drivers `.gitattributes` names, keyed by driver name: (description, command).
#: The command runs from the worktree's top level, so each checkout uses its own copy of the script.
BMAD_MERGE_DRIVERS = {
    "bmad-issue-map": ("BMad issue map", "python3 scripts/bmad_merge_driver.py map %O %A %B"),
    "bmad-sprint-status": ("BMad sprint status", "python3 scripts/bmad_merge_driver.py sprint-status %O %A %B"),
}


def _git_common_dir(checkout: Path) -> Optional[Path]:
    """The resolved shared git directory of `checkout`, or None outside a git checkout."""
    out = _git(checkout, "rev-parse", "--git-common-dir", capture=True)
    if out.returncode != 0 or not out.stdout.strip():
        return None
    return (checkout / out.stdout.strip()).resolve()


def register_bmad_merge_drivers(checkout: Path, harness_checkout: Optional[Path] = None) -> bool:
    """Register the BMad merge drivers in this harness's own repository; returns whether config changed.

    Only a checkout sharing `harness_checkout`'s git directory qualifies, so another repository
    that ships a script of the same name never has its merges routed through it. Idempotent: a
    key already holding its value is left alone. The config is the repository's, so every
    worktree of it, and the main checkout, merges the issue map through the driver.
    """
    if not (checkout / "scripts" / "bmad_merge_driver.py").is_file():
        return False
    own = _git_common_dir(REPO if harness_checkout is None else harness_checkout)
    if own is None or _git_common_dir(checkout) != own:
        return False
    changed = False
    for name, (description, command) in BMAD_MERGE_DRIVERS.items():
        for key, value in (("name", description), ("driver", command)):
            current = _git(checkout, "config", "--get", f"merge.{name}.{key}", capture=True)
            if current.returncode == 0 and current.stdout.rstrip("\n") == value:
                continue
            _git(checkout, "config", f"merge.{name}.{key}", value, capture=True)
            changed = True
    return changed


def cmd_worktree(args: argparse.Namespace) -> int:
    repo = git_root(args.repo or ".")
    if args.action == "create":
        dest = worktree_destination(repo, args.name)
        if dest.exists():
            raise SystemExit(f"{dest} already exists")
        if not args.no_fetch:
            fetched = _git(repo, "fetch", "origin")
            if fetched.returncode != 0:
                return fetched.returncode
        ensure_worktree_bucket(repo)
        branch = args.branch or args.name
        created = _git(repo, "worktree", "add", "-b", branch, str(dest), args.base, capture=True)
        if created.returncode == 0:
            register_bmad_merge_drivers(dest)
            say(str(dest))
        elif created.stderr:
            say(created.stderr.strip())
        return created.returncode

    if args.action == "remove":
        dest = worktree_destination(repo, args.name)
        registered = {Path(r["worktree"]).resolve() for r in _registered_worktrees(repo)}
        if dest not in registered:
            say(f"not a registered worktree: {dest}")
            return 1
        also_clear = getattr(args, "also_clear", None) or []
        for name in also_clear:
            if not WORKTREE_NAME.fullmatch(name.lstrip(".")) or name in (".", "..", ".git"):
                say(f"--also-clear takes one top-level directory name, not {name!r}")
                return 1
        status = _git(dest, "status", "--porcelain", "--ignored", "--untracked-files=all", capture=True)
        if status.returncode != 0:
            say(status.stderr.strip() or f"git status failed in {dest}")
            return status.returncode
        _, blocking = classify_worktree_status(status.stdout, also_clear)
        if blocking:
            say(f"refusing to remove worktree with modified, untracked, or ignored files: {dest}")
            for entry in blocking[:5]:
                say(f"  {entry}")
            if len(blocking) > 5:
                say(f"  and {len(blocking) - 5} more")
            return 1
        symbolic = _git(dest, "symbolic-ref", "--quiet", "--short", "HEAD", capture=True)
        branch = symbolic.stdout.strip() if symbolic.returncode == 0 else ""
        if not branch:
            head = _git(dest, "rev-parse", "HEAD", capture=True)
            refs = _git(repo, "for-each-ref", "--contains", head.stdout.strip(), "--format=%(refname)", capture=True)
            if head.returncode != 0 or refs.returncode != 0 or not refs.stdout.strip():
                say(f"refusing to remove detached worktree whose HEAD is not contained by a ref: {dest}")
                return 1
        # The merge proof runs before the removal, so a refusal leaves the worktree intact.
        if getattr(args, "merged", False):
            if not branch:
                say(f"refusing to prove a merge for a detached worktree: {dest}")
                return 1
            trunk = _git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", capture=True)
            if branch == trunk.stdout.strip().removeprefix("origin/"):
                say(f"refusing to delete {branch}: it is the default branch")
                return 1
            tip = _git(dest, "rev-parse", "HEAD", capture=True)
            if tip.returncode != 0:
                say(tip.stderr.strip() or f"git rev-parse failed in {dest}")
                return tip.returncode
            refusal = merged_head_refusal(repo, branch, tip.stdout.strip())
            if refusal:
                say(f"refusing to delete {branch}: {refusal}")
                return 1
        # git deletes the ignored caches with the checkout, or refuses and deletes nothing.
        removed = _git(repo, "worktree", "remove", str(dest))
        if removed.returncode != 0 or not getattr(args, "merged", False):
            return removed.returncode
        # Proven merged above, so the branch is gone from the remote and `-d` would refuse it.
        deleted = _git(repo, "branch", "-D", branch, capture=True)
        if deleted.returncode != 0:
            say(f"worktree removed, branch {branch} kept: {deleted.stderr.strip() or 'git branch -D failed'}")
        return deleted.returncode

    dirty = 0
    for record in _registered_worktrees(repo):
        path = Path(record["worktree"])
        if "prunable" in record:
            say(f"prunable\t{path}")
            continue
        status = _git(path, "status", "--porcelain", "--ignored", "--untracked-files=all", capture=True)
        if status.returncode != 0:
            say(f"unknown\t{path}")
            dirty += 1
            continue
        state = "dirty" if classify_worktree_status(status.stdout)[1] else "clean"
        dirty += state == "dirty"
        branch = record.get("branch", "detached").removeprefix("refs/heads/")
        say(f"{state}\t{branch}\t{path}")
    return 1 if dirty else 0


def _tool(name: str) -> Optional[str]:
    """Absolute path to an executable, or None if it cannot be found.

    Searches PATH, then the bin directories of the keg-only Homebrew formulae this installer
    asks for. A keg-only formula is deliberately not linked into the Homebrew prefix, so
    `brew install node@22` leaves `npm` off PATH on a machine that has no other node.
    """
    found = shutil.which(name)
    if found:
        return found
    for opt in KEG_ONLY_BINS:
        candidate = Path(opt) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def _run(cmd: List[str], dry: bool) -> bool:
    """Run a command. A missing executable is reported and skipped, never raised.

    `subprocess.run` raises FileNotFoundError when argv[0] does not exist, and `check=False`
    suppresses a non-zero exit, not a missing binary. An installer that ends in a traceback
    tells the person running it nothing, so every external call goes through here.
    """
    if cmd[0].startswith("/"):
        exe = cmd[0] if Path(cmd[0]).exists() else None  # /bin/bash is absent on some platforms
    else:
        exe = _tool(cmd[0])
    if exe is None:
        say(f"  skip    {cmd[0]} is not installed; skipped `{' '.join(cmd)}`")
        return False
    say("  $ " + " ".join(cmd))
    if not dry:
        subprocess.run([exe] + cmd[1:], check=False)
    return True


def _gh_login_line() -> str:
    if _tool("gh") is None:
        return "not installed; needed only to open pull requests"
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0:
        return "run `gh auth login`"
    return "logged in"


UNSUPPORTED = ("Native Windows is not supported: runtime projections use symlinks and POSIX hooks.\n"
               "WSL2 is a separate, currently unqualified target; see the compatibility catalog.")


def cmd_install(args: argparse.Namespace) -> int:
    if platform.system() == "Windows":
        say(UNSUPPORTED)
        return 1
    dry = args.dry_run
    cfg = load_config()
    mac = platform.system() == "Darwin"
    say(f"model-citizen install{' (dry run)' if dry else ''}")
    if mac and not args.no_brew:
        if not shutil.which("xcode-select") or subprocess.run(["xcode-select", "-p"], capture_output=True).returncode != 0:
            say("  Xcode Command Line Tools missing: run `xcode-select --install`, then re-run")
            return 1
        if not shutil.which("brew"):
            _run(["/bin/bash", "-c", 'curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | bash'], dry)
        _run(["brew", "install"] + BREW_PACKAGES, dry)
    if mac and not args.no_apps and not args.no_vscode:
        if not shutil.which("code"):
            _run(["brew", "install", "--cask", "visual-studio-code"], dry)
        for f in ["extensions.txt"] + (["extensions.optional.txt"] if args.with_optional else []):
            for ext in (REPO / "vscode" / f).read_text().split():
                _run(["code", "--install-extension", ext, "--force"], dry)
    if not args.no_apps:
        if cfg.get("claude", {}).get("manage", True) and not shutil.which("claude"):
            _run(["/bin/bash", "-c", "curl -fsSL https://claude.ai/install.sh | bash"], dry)
        if cfg.get("codex", {}).get("manage", True) and not args.no_codex and not shutil.which("codex"):
            _run(["npm", "install", "-g", "@openai/codex"], dry)
    sync_args = argparse.Namespace(dry_run=dry, adopt=args.adopt, adopt_codex=args.adopt_codex, print_only=False)
    rc = cmd_sync(sync_args)
    say("\nLogins (interactive, cannot be automated):")
    if cfg.get("claude", {}).get("manage", True):
        say("  claude   — run `claude` and complete the browser login")
    if cfg.get("codex", {}).get("manage", True):
        say("  codex    — run `codex login`")
    say("  gh       — " + _gh_login_line())
    return rc


def import_state_path() -> Path:
    """Plans `harness import` has printed but not yet applied, keyed by source file."""
    return state_dir() / "imports.json"


def import_root(args: argparse.Namespace, name: str) -> Path:
    if not args.root:
        return home() / ".config" / "agent-harness" / "imported" / name
    root = Path(args.root).expanduser()
    if not root.is_absolute():
        raise SystemExit("--root must be an absolute directory outside this checkout")
    if root == REPO / "primitives" or REPO / "primitives" in root.parents:
        raise SystemExit("import writes to an external primitive root, never into " + str(REPO / "primitives"))
    return root


def cmd_import(args: argparse.Namespace) -> int:
    """Split an existing instruction file into primitives under an external root.

    Two runs by design: the first prints the rules it would write and the sync projection of the
    root carrying them, the second applies exactly that plan. Adopting somebody's instruction
    file is a decision, and the diff is what makes it one.
    """
    source = Path(args.path).expanduser()
    if not source.is_file():
        raise SystemExit("import: no such file: " + str(source))
    try:
        files, notices = importer.plan(source, args.name)
    except (OSError, ValueError, UnicodeDecodeError) as exc:
        raise SystemExit("import: " + str(exc))
    name = importer.slug(args.name) if args.name else importer.default_name(source, importer.kind_of(source))
    root = import_root(args, name)

    owner = reconcile.Store(state_dir(), dry=True).data["files"].get(str(source.resolve()))
    if owner is not None:
        say("owned: " + str(source.resolve()) + " is a file the harness generated")
        say("       " + json.dumps({k: v for k, v in owner.items() if k != "prior"}))
        say("       edit its primitive and re-run `citizen sync` instead of importing it")
        say("import refused: nothing was written")
        return 2
    cfg = load_config()
    projected = dict(cfg, primitive_roots=list(cfg.get("primitive_roots", [])) + [str(root)])
    refusals = collisions.findings(REPO, projected)
    if refusals:
        for line in refusals:
            say(line)
        say("import refused: nothing was written")
        return 2

    say(f"model-citizen {VERSION} · import {source} · root {root}")
    for item in files:
        say("  write   " + str(root / item["path"]))
    for line in notices:
        say("  notice  " + line)
    fingerprint = importer.digest(root, files)
    state = read_json(import_state_path()) or {"schema_version": 1, "pending": {}}
    pending = state.setdefault("pending", {})
    approved = pending.get(str(source.resolve())) == {"root": str(root), "digest": fingerprint}
    if args.dry_run or not approved:
        pending[str(source.resolve())] = {"root": str(root), "digest": fingerprint}
        write_json_atomic(import_state_path(), state)
        say("")
        try:
            cmd_sync(argparse.Namespace(dry_run=True, adopt=False, adopt_codex=False,
                                        print_only=False, extra_roots=[str(root)]))
        except SystemExit as exc:
            say("  notice  the sync projection did not resolve: " + str(exc))
        say("")
        say("import: nothing written. Re-run without --dry-run to write this plan.")
        return 0
    for item in files:
        reconcile.atomic_text(root / item["path"], item["text"])
    say("  wrote   " + str(len(files)) + " rule(s) under " + str(root))
    roots = list(cfg.get("primitive_roots", []))
    if str(root) not in roots:
        config_set("primitive_roots", json.dumps(roots + [str(root)]))
    del pending[str(source.resolve())]
    write_json_atomic(import_state_path(), state)
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    if args.action == "set":
        return config_set(args.key, args.value)
    cfg = load_config()
    node: Any = cfg
    for part in args.key.split("."):
        if not isinstance(node, dict) or part not in node:
            raise SystemExit(f"no such key: {args.key}")
        node = node[part]
    say(node if isinstance(node, str) else json.dumps(node))
    return 0


BOOL_KEYS = ["vscode.manage", "claude.manage", "codex.manage", "permissions_bypass_acknowledged",
             "core_switches_acknowledged"]


def coerce_config_value(key: str, value: str) -> Any:
    """Validate one dotted key against what sync will accept, before it reaches the file.

    A config that only fails at the next sync is worse than one that fails at the keystroke
    that broke it, because the sync is where the message is least expected.
    """
    if key.startswith("integrations."):
        parts = key.split(".")
        if len(parts) != 3 or parts[1] != integrations.CAPABILITY or parts[2] not in ("implementation", "adapter"):
            raise SystemExit("integration key must select architecture-viewer implementation or adapter")
        if parts[2] == "implementation" and value not in ("builtin", "custom"):
            raise SystemExit("implementation must be builtin or custom")
        if parts[2] == "adapter":
            integrations.identifier(value)
        return value
    if key.startswith("governance."):
        return coerce_governance_value(key, value)
    if key in BOOL_KEYS:
        if value.lower() not in ("true", "false"):
            raise SystemExit(f"{key} is true or false; got '{value}'")
        return value.lower() == "true"
    head, _, tail = key.partition(".")
    if head == "identity":
        if tail not in IDENTITY_KEYS:
            raise SystemExit(f"identity has no field '{tail}'; fields: {', '.join(IDENTITY_KEYS)}")
        if tail == "expertise" and value not in GUIDANCE:
            raise SystemExit(f"identity.expertise is {' or '.join(sorted(GUIDANCE))}; got '{value}'")
        return value
    if head == "stances":
        cfg = load_config(env={})
        cfg["stances"][tail] = value
        resolve_stances(cfg)
        return value
    if key == "mode":
        # Resolved with the mode in place, so an unknown mode or one that fails its own
        # validation is refused here rather than at the next sync.
        user = read_json(config_path()) or {}
        user["mode"] = value
        load_selection(env={}, user=user)
        return value
    if head in CONFIG_SWITCH_KINDS:
        if not tail:
            raise SystemExit(f"a {head} switch names its unit: citizen config set {head}.<name> on|off")
        if value not in ("on", "off"):
            raise SystemExit(f"a {head} unit is on or off; got '{value}'")
        return value
    if key == "primitive_roots":
        roots = json.loads(value)
        if not isinstance(roots, list) or not all(isinstance(item, str) and Path(item).expanduser().is_absolute() for item in roots):
            raise SystemExit("primitive_roots must be a JSON array of absolute directory paths")
        cfg = load_config(env={})
        cfg["primitive_roots"] = roots
        resolve_stances(cfg)
        return roots
    if key == "permissions":
        if value != "inherit" and value not in POSTURES:
            raise SystemExit(f"permissions must be inherit, bypass, auto or manual; got '{value}'")
        return value
    if key == "workspaces_dir":
        folder = Path(value).expanduser()
        if not value.strip() or not folder.is_absolute():
            raise SystemExit("workspaces_dir must be an absolute directory path, or ~/ followed by one")
        return str(folder)
    if key == "plan_allow_tools":
        try:
            globs = json.loads(value)
        except ValueError:
            globs = None
        if not isinstance(globs, list) or not all(isinstance(item, str) and item.strip() for item in globs):
            raise SystemExit("plan_allow_tools must be a JSON array of tool-name globs")
        return [item.strip() for item in globs]
    raise SystemExit(f"{key} is not a key this command sets; try identity.NAME, stances.NAME, "
                     f"mode, rules|skills|workflows|roles|hooks.NAME, permissions, plan_allow_tools, workspaces_dir, "
                     f"governance.provider, governance.jev.*, "
                     f"or one of {', '.join(BOOL_KEYS)}")


def coerce_governance_value(key: str, value: str) -> Any:
    """Validate one governance key by resolving the block it would produce.

    The block is built and handed to the same loader a provider reads, so a mode, a decision
    point or an outbound field this harness does not know fails at the keystroke rather than
    at the first decision that would have sent something.
    """
    parts = key.split(".")
    coerced: Any = value
    if parts[-1] in ("timeout", "max_requests", "max_tokens", "state_fields"):
        try:
            coerced = json.loads(value)
        except ValueError:
            # The value itself is never echoed back: a governance value is whatever a user
            # pasted, and an error message is printed, logged and scrolled past.
            raise SystemExit(f"{key} takes a JSON value")
    if parts[1] == "provider":
        known = sorted(set(decisions_provider.PROVIDERS)
                       | set(decisions_provider.TRANSPORT_PROVIDERS))
        if len(parts) != 2 or coerced not in known:
            raise SystemExit("governance.provider must name one of " + ", ".join(known))
        return coerced
    if parts[1] != "jev" or len(parts) < 3:
        raise SystemExit("governance keys are governance.provider and governance.jev."
                         + "|".join(decision_controls.KEYS))
    block: Any = coerced
    for part in reversed(parts[2:]):
        block = {part: block}
    try:
        decision_controls.Controls.from_config({"governance": {"jev": block}})
    except decisions_provider.PolicyError as exc:
        raise SystemExit(str(exc))
    return coerced


def config_set(key: str, value: Optional[str]) -> int:
    if value is None:
        raise SystemExit(f"config set needs a value: citizen config set {key} VALUE")
    path = config_path()
    try:
        with reconcile.lock(path.parent):
            coerced = coerce_config_value(key, value)
            if path.is_symlink():
                raise ValueError("configuration cannot be a symlink")
            cfg = read_json(path)
            if cfg is None:
                cfg = deepcopy(example_config())
                mark_init_defaults(cfg, cfg.get("stances", {}))
            parts = (key.split(".") if key.startswith(("integrations.", "governance."))
                     else key.split(".", 1))
            reconcile.assign(cfg, parts, {"present": True, "value": coerced})
            if parts[0] == "stances":
                # A stance set by hand is the user's choice from now on, above any mode.
                unmark_init_default(cfg, parts[1])
            if parts[0] in CONFIG_SWITCH_KINDS:
                # Resolved as it will be written: a switch that breaks a module dependency, or turns
                # a core hook off unacknowledged, is refused; one that repairs a selection the
                # resolver already refuses goes in.
                unset = deepcopy(cfg)
                unset[parts[0]].pop(parts[1])
                if parts[1] not in load_selection(env={}, user=unset)[parts[0]]:
                    raise SystemExit(f"{parts[0]} has no unit '{parts[1]}'; `citizen selection` lists every unit")
                load_selection(env={}, user=cfg)
            elif key == "core_switches_acknowledged":
                # Withdrawing the acknowledgement while a core hook is off is refused the same way.
                load_selection(env={}, user=cfg)
            if key.startswith("integrations."):
                selected = integrations.selection(cfg)
                if parts[-1] == "adapter":
                    integrations.resolve(REPO, cfg, implementation="custom")
                if selected["implementation"] == "custom":
                    integrations.require_available(integrations.resolve(REPO, cfg))
            reconcile.atomic_text(path, json.dumps(cfg, indent=2) + "\n")
    except ValueError as exc:
        raise SystemExit(str(exc))
    if key.startswith("governance."):
        # Named, not echoed: the same reason the coercion above refuses to quote a value.
        say(f"{key} set  ({path})")
    else:
        say(f"{key} = {json.dumps(coerced)}  ({path})")
    say("applies to new viewer sessions" if key.startswith("integrations.")
        else "applies from the next hook event" if key.startswith("hooks.") else "run `citizen sync` to apply it")
    return 0


def cmd_integrations(args: argparse.Namespace) -> int:
    try:
        if args.action == "register":
            if not args.file:
                raise ValueError("register requires --file")
            name = integrations.register(config_path(), integrations.read_json(args.file))
            result = {"registered": name, "selection_changed": False}
        else:
            raw = read_json(config_path()) or {}
            integrations.selection(raw, args.capability)
            selected = raw.get("integrations", {}).get(args.capability, {})
            binding = integrations.resolve(REPO, load_config(), args.capability,
                                           source="user" if selected else "distribution")
            result = (integrations.invoke(binding, "describe", timeout=args.timeout)
                      if args.action == "doctor" else binding)
        print(json.dumps(result, indent=2))
        return 0 if result.get("status", "ok") == "ok" else 1
    except (ValueError, OSError) as exc:
        print(json.dumps({"status": "error", "error": {"code": getattr(exc, "code", "invalid-input"),
                                                        "message": str(exc)}}))
        return 1


def cmd_viewer(args: argparse.Namespace) -> int:
    try:
        payload = integrations.read_json(args.input) if args.input else {}
        result = integrations.viewer(REPO, load_config(), state_dir() / "viewer-sessions",
                                     args.action, payload, args.session, args.implementation,
                                     args.adapter, args.request_id, args.timeout)
        print(json.dumps(result, indent=2))
        return 0 if result["status"] == "ok" else 1
    except (ValueError, OSError) as exc:
        result = {"status": "indeterminate" if getattr(exc, "indeterminate", False) else "error",
                  "error": {"code": getattr(exc, "code", "invalid-input"), "message": str(exc)}}
        for field in ("request_id", "persistence_warning"):
            if getattr(exc, field, None):
                result[field] = getattr(exc, field)
        print(json.dumps(result))
        return 1


def _ask(prompt: str, default: str, choices: Optional[List[str]] = None, required: bool = False) -> str:
    return _ask_entry(prompt, default, choices, required)[0]


def _ask_entry(prompt: str, default: str, choices: Optional[List[str]] = None,
               required: bool = False) -> Tuple[str, bool]:
    """`_ask`'s answer, and whether it came from pressing Enter rather than typing it."""
    if choices:
        print(f"  {prompt}: {' · '.join(choices)}")
    label = "  " if choices else f"  {prompt}"
    hint = f" [{default}]" if default else ""
    while True:
        try:
            raw = input(f"{label}{hint}: ").strip()
        except EOFError:
            raw = ""
        value = raw or default
        if required and not value:
            print("    this one is needed")
            continue
        if choices and value not in choices:
            print(f"    not one of: {', '.join(choices)}")
            continue
        return value, not raw


def _detect_timezone() -> str:
    link = Path("/etc/localtime")
    if link.is_symlink():
        head, sep, name = str(link.resolve()).partition("/zoneinfo/")
        if sep and name:
            return name
    return "UTC"


def _detect_github() -> str:
    if _tool("gh") is None:
        return ""
    out = subprocess.run(["gh", "api", "user", "-q", ".login"], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def _detect_git_name() -> str:
    if _tool("git") is None:
        return ""
    out = subprocess.run(["git", "config", "--get", "user.name"], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def mark_init_defaults(cfg: Dict[str, Any], names: Any) -> None:
    """Record `names` as stances init wrote as defaults, which resolve below a mode (AD-2).

    Each name keeps the value init wrote, so a value edited by hand later counts as typed. The
    key and its precedence are `posture.INIT_DEFAULTS`; `docs/modes.md` has the rule.
    """
    stances = cfg.get("stances", {})
    cfg["init_defaults"] = {"stances": {name: stances[name] for name in sorted(names) if name in stances}}


def unmark_init_default(cfg: Dict[str, Any], name: str) -> None:
    listed = cfg.get("init_defaults")
    if isinstance(listed, dict) and isinstance(listed.get("stances"), dict):
        listed["stances"].pop(name, None)


def init_defaults(args: argparse.Namespace, path: Path) -> int:
    """Write the config with no questions, for a scripted first run.

    Every field the machine can answer for itself is answered; anything it cannot is left at the
    example value and named on the way out, because a wrong invented identity is worse than a
    placeholder the next line tells you to replace.
    """
    example = example_config()
    cfg = deepcopy(example)
    identity = cfg.setdefault("identity", {})
    name = getattr(args, "name", None) or _detect_git_name()
    if name:
        identity["name"] = name
    role = getattr(args, "role", None)
    if role:
        identity["role"] = role
    github = getattr(args, "github", None) or _detect_github()
    if github:
        identity["github"] = github
    identity["timezone"] = getattr(args, "timezone", None) or _detect_timezone()
    preset = getattr(args, "preset", None) or "software"
    cfg["stances"] = dict(example.get("stances", {}), **STANCE_PRESETS[preset])
    mark_init_defaults(cfg, cfg["stances"])
    write_json_atomic(path, cfg)
    say(f"wrote {path} ({preset} defaults)")
    left = placeholder_identity(cfg)
    if left:
        say("  still at the example value: " + ", ".join(left))
        for field in left:
            say(f"    citizen config set identity.{field} \"…\"")
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    """Write the config file by asking, so a first run needs no hand-edited JSON."""
    path = config_path()
    if path.exists() and not args.force:
        say(f"{path} already exists.")
        say("  one value:  citizen config set identity.name \"…\"")
        say("  start over: citizen init --force")
        return 1
    if getattr(args, "yes", False):
        return init_defaults(args, path)
    if not sys.stdin.isatty():
        say("citizen init asks questions and needs a terminal.")
        say("Without one, run `citizen init --yes` for defaults, or write the same values")
        say("with `citizen config set KEY VALUE`.")
        return 1
    example = example_config()
    cfg = deepcopy(example)
    print(f"model-citizen {VERSION} — setup. Enter keeps the value in brackets.\n")
    print("Identity. This is rendered into ~/.claude/CLAUDE.personal.md, which stays on this")
    print("machine; nothing here is ever written into the checkout.\n")
    identity = cfg.setdefault("identity", {})
    identity["name"] = _ask("Your name", "", required=True)
    identity["pronouns"] = _ask("Pronouns", example.get("identity", {}).get("pronouns", "they/them"))
    identity["role"] = _ask("One line on what you do, so answers are pitched right", "", required=True)
    identity["github"] = _ask("GitHub handle, blank if you have none", _detect_github())
    identity["timezone"] = _ask("Timezone", _detect_timezone())
    print("\nHow much should answers explain themselves?")
    print("  expert   — skips fundamentals and assumes you know the tools")
    print("  beginner — says what each step and command does, and defines terms")
    identity["expertise"] = _ask("How much to explain", "expert", sorted(GUIDANCE))
    print("\nWhat will you mostly use this for?")
    print("  software — shipping code: tests required, Conventional Commits, one-screen plans")
    print("  general  — everything else: no commit ceremony, no test gate, lighter plans")
    preset = _ask("Mostly", "software", sorted(STANCE_PRESETS))
    defaults = dict(example.get("stances", {}), **STANCE_PRESETS[preset])
    print("\nPreferences. Every one has a default; Enter takes it.")
    print("They are described in docs/preferences.md and can be changed later.\n")
    stances = cfg.setdefault("stances", {})
    entered = []
    for name in STANCE_NAMES:
        variants = stance_variants(name)
        stances[name], took_default = _ask_entry(name, defaults.get(name, variants[0]), variants)
        if took_default:
            entered.append(name)
    # Enter took the offered value, which a mode may replace; a typed answer is a choice, even
    # when it names the offered value.
    mark_init_defaults(cfg, entered)
    write_json_atomic(path, cfg)
    print(f"\nwrote {path}")
    print("next: bin/harness sync")
    return 0


def cmd_keychain(args: argparse.Namespace) -> int:
    """Give a home you built by hand its own default keychain, so a client launched there is silent."""
    home = Path(args.home).expanduser().resolve()
    if not home.is_dir():
        raise SystemExit(f"not a directory: {home}")
    if home == Path.home().resolve():
        raise SystemExit("that is your own home; this command is for a disposable one")
    try:
        created = keychain.provision(home)
    except OSError as exc:
        raise SystemExit(f"{exc}\nDo not launch a client under this home.")
    print(created if created else "nothing to do: a default keychain is present or this host needs none")
    return 0


def cmd_trust(args: argparse.Namespace) -> int:
    """Record (or with --remove, forget) a repository root the stop-gate hook may run a gate in."""
    start = Path(args.path).expanduser() if args.path else Path.cwd()
    probe = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True)
    root = Path(probe.stdout.strip()) if probe.returncode == 0 and probe.stdout.strip() else start.resolve()
    path = trusted_path()
    lines = [ln.strip() for ln in path.read_text(encoding="utf-8").splitlines()] if path.exists() else []
    roots = [ln for ln in lines if ln and not ln.startswith("#")]
    if args.remove:
        roots = [r for r in roots if Path(r) != root]
    elif str(root) not in roots:
        roots.append(str(root))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(r + "\n" for r in roots), encoding="utf-8")
    say(("forgot " if args.remove else "trusted ") + str(root))
    say(f"  {path}: {len(roots)} root(s)")
    return 0


# --------------------------------------------------------------------------- remote control


def launch_agents_dir() -> Path:
    return home() / "Library" / "LaunchAgents"


def remote_control_log_dir() -> Path:
    return state_dir() / "remote-control"


def claude_state_file() -> Path:
    """Where Claude Code records per-folder workspace trust."""
    override = os.environ.get("CLAUDE_CONFIG_DIR")
    return (Path(override) if override else home()) / ".claude.json"


def launchctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["launchctl", *args], capture_output=True, text=True)


def launchd_domain() -> str:
    return f"gui/{os.getuid()}"


def remote_control_unload(name: str, path: Path) -> None:
    launchctl("bootout", f"{launchd_domain()}/{name}")
    if path.exists():
        path.unlink()


def cmd_remote_control(args: argparse.Namespace) -> int:
    """Keep one `claude remote-control` server per configured folder running under launchd."""
    if platform.system() != "Darwin":
        say("remote-control: launchd agents are macOS only; nothing done")
        return 1
    agents = launch_agents_dir()
    if args.action == "uninstall":
        owned = remote_control.installed(agents)
        heal_path = agents / (remote_control.HEAL_LABEL + ".plist")
        if heal_path.exists() or launchctl("print", f"{launchd_domain()}/{remote_control.HEAL_LABEL}").returncode == 0:
            remote_control_unload(remote_control.HEAL_LABEL, heal_path)
            say(f"removed {remote_control.HEAL_LABEL}")
        for name, path in owned.items():
            remote_control_unload(name, path)
            say(f"removed {name}")
        say(f"remote-control: {len(owned)} agent(s) removed")
        return 0
    try:
        opts = remote_control.settings(load_config())
    except ValueError as exc:
        raise SystemExit(f"remote-control: {exc}")
    serve, skipped, stale = remote_control.plan(opts, agents, claude_state_file())
    if args.action == "status":
        for folder in serve:
            name = remote_control.label(folder)
            probe = launchctl("print", f"{launchd_domain()}/{name}")
            found = re.search(r"^\s*state = (\S+)", probe.stdout, re.M) if probe.returncode == 0 else None
            state = found.group(1) if found else "not loaded; run `citizen remote-control install`"
            say(f"{folder}: {state}")
            say(f"  log: {remote_control_log_dir() / (name + '.log')}")
        for folder, reason in skipped:
            say(f"{folder}: skipped, {reason}")
        for name in stale:
            say(f"{name}: installed but no longer configured; `install` removes it")
        lines = []
        if heal_log_path().exists():
            lines = [ln for ln in heal_log_path().read_text(encoding="utf-8").splitlines() if ln.strip()]
        loaded = launchctl("print", f"{launchd_domain()}/{remote_control.HEAL_LABEL}").returncode == 0
        state = "loaded" if loaded else "not loaded; see `citizen remote-control install`"
        say(f"heal: {state}, {len(lines)} action(s) logged"
            + (f", last {lines[-1]}" if lines else ""))
        report_lost_sessions(serve, opts)
        if not (serve or skipped or stale):
            say("remote-control: no folders configured; set remote_control.folders in " + str(config_path()))
        return 0
    claude_bin = shutil.which("claude")
    if not claude_bin:
        raise SystemExit("remote-control: `claude` is not on PATH")
    dry = getattr(args, "dry_run", False)
    for name in stale:
        say(("would remove " if dry else "removed ") + name)
        if not dry:
            remote_control_unload(name, agents / (name + ".plist"))
    failed = 0
    for folder in serve:
        name = remote_control.label(folder)
        path = agents / (name + ".plist")
        body = remote_control.render(folder, opts, claude_bin, home(), remote_control_log_dir())
        loaded = launchctl("print", f"{launchd_domain()}/{name}").returncode == 0
        unchanged = path.exists() and path.read_bytes() == body
        pid = host_pid(name) if loaded and not unchanged else None
        env = remote_control.environment_id(read_host_log(name)) if pid is not None else None
        step = remote_control.install_step(loaded, unchanged, pid, env)
        if step == "unchanged":
            say(f"unchanged {folder}")
            continue
        say(("would serve " if dry else "serving ") + str(folder))
        if step == "adopt":
            adopt_environment(folder, pid, env, dry)
        if dry:
            continue
        agents.mkdir(parents=True, exist_ok=True)
        remote_control_log_dir().mkdir(parents=True, exist_ok=True)
        launchctl("bootout", f"{launchd_domain()}/{name}")
        path.write_bytes(body)
        result = launchctl("bootstrap", launchd_domain(), str(path))
        if result.returncode != 0:
            failed += 1
            say(f"  launchctl bootstrap failed: {result.stderr.strip()}")
    heal_path = agents / (remote_control.HEAL_LABEL + ".plist")
    heal_body = remote_control.render_heal(Path(__file__).resolve(), home(),
                                           remote_control_log_dir(), claude_bin)
    heal_loaded = launchctl("print", f"{launchd_domain()}/{remote_control.HEAL_LABEL}").returncode == 0
    if heal_loaded and heal_path.exists() and heal_path.read_bytes() == heal_body:
        say("unchanged heal agent")
    elif dry:
        say("would install heal agent")
    else:
        agents.mkdir(parents=True, exist_ok=True)
        launchctl("bootout", f"{launchd_domain()}/{remote_control.HEAL_LABEL}")
        heal_path.write_bytes(heal_body)
        result = launchctl("bootstrap", launchd_domain(), str(heal_path))
        if result.returncode != 0:
            failed += 1
            say(f"  launchctl bootstrap failed for heal: {result.stderr.strip()}")
        else:
            say("installed heal agent")
    for folder, reason in skipped:
        # A folder Claude Code has not trusted is a refusal, not a note: launchd would restart
        # the host's trust prompt every minute and nothing would ever serve it.
        say(f"refusing {folder}: {reason}")
        failed += 1
    if not (serve or skipped):
        say("remote-control: no folders configured; set remote_control.folders in " + str(config_path()))
    return 1 if failed else 0


def read_host_log(name: str) -> str:
    try:
        return (remote_control_log_dir() / (name + ".log")).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def claude_projects_root() -> Path:
    """Where Claude Code keeps per-folder state, `bridge-pointer.json` among it."""
    root = claude_state_file().parent / ".claude" / "projects"
    return root if root.is_dir() else home() / ".claude" / "projects"


def adopt_environment(folder: Path, pid: int, env: str, dry: bool) -> None:
    """Hand a running host's environment to its replacement; see `remote_control.install_step`."""
    path = remote_control.pointer_path(claude_projects_root(), folder)
    say(f"  {'would adopt' if dry else 'adopting'} {env} from pid {pid}")
    if dry:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    write_json_atomic(path, remote_control.pointer_payload(
        env, None, None, remote_control.read_pointer(path)))
    host = claude_host_pid(pid)
    if host is None:
        say(f"  warning: no `claude` process under pid {pid}; reloading without the kill")
        return
    try:
        os.kill(host, signal.SIGKILL)
    except OSError as exc:
        say(f"  warning: SIGKILL to pid {host} failed: {exc}")


def report_lost_sessions(folders: List[Path], opts: Dict[str, Any]) -> int:
    """List sessions still active but disconnected, with the manual command that recovers each.

    Heal re-queues these through `bridge/reconnect`; the `--session-id` reattach printed here
    stays manual, because such a host registers the lost environment a second time as a
    single-session environment and the client then routes new chats to it. The count is
    returned so `doctor` can report it without asking twice.
    """
    page = lost_sessions(folders)
    if page.status == remote_control.SessionPage.REFUSED:
        say("lost sessions: not checked (page order unknown)")
        return 0
    if not page.ok:
        say("lost sessions: not checked; no claude.ai token in the keychain, or the API call failed")
        return 0
    rows = page.rows
    if not rows:
        say("lost sessions: none" + page.scope())
        return 0
    say(f"lost sessions: {len(rows)} active but disconnected{page.scope()}; reattach by hand, "
        "one at a time")
    say(f"  warning: {remote_control.REATTACH_WARNING}")
    for row in rows:
        say(f"  {row.get('id')} · {row.get('title') or 'untitled'} · env {row.get('environment_id')}")
        say("    " + remote_control.reattach_command(row, opts["permission_mode"]))
    return len(rows)


def heal_log_path() -> Path:
    return remote_control_log_dir() / "heal.log"


def heal_say(line: str, dry: bool) -> None:
    """One line per action, to the heal log and to the terminal."""
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    record = f"{stamp} {'would ' if dry else ''}{line}"
    say(record)
    if dry:
        return
    path = heal_log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(record + "\n")


def host_pid(name: str) -> Optional[int]:
    """The live pid of a folder's launchd agent, or None when it is not running."""
    probe = launchctl("print", f"{launchd_domain()}/{name}")
    if probe.returncode != 0:
        return None
    found = re.search(r"^\s*pid = (\d+)", probe.stdout, re.M)
    return int(found.group(1)) if found else None


def proc_start(pid: int) -> Optional[str]:
    """`ps -o lstart=`, the same string the client stores and compares against."""
    probe = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True)
    value = probe.stdout.strip()
    return value or None


def claude_host_pid(pid: int) -> Optional[int]:
    """The `claude` process of a launchd job: the job pid, or the child caffeinate wraps."""
    for candidate in [pid] + child_pids(pid):
        probe = subprocess.run(["ps", "-o", "command=", "-p", str(candidate)],
                               capture_output=True, text=True)
        if remote_control.is_host_process(probe.stdout.strip()):
            return candidate
    return None


def child_pids(pid: int) -> List[int]:
    probe = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True)
    return [int(line) for line in probe.stdout.split() if line.isdigit()]


def supervisor_state_path() -> Path:
    return remote_control_log_dir() / remote_control.STATE_NAME


def host_environment_ids(folders: Iterable[Path]) -> List[str]:
    """Every environment id this Mac's hosts have registered, newest last, from their logs."""
    found: List[str] = []
    for folder in folders:
        log = remote_control_log_dir() / (remote_control.label(folder) + ".log")
        try:
            text = log.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for env in remote_control.ENV_ID.findall(text):
            if env not in found:
                found.append(env)
    return found


def claude_oauth_token() -> Optional[str]:
    """The claude.ai token from the login keychain. Returned to the caller, never printed."""
    probe = subprocess.run(["security", "find-generic-password", "-s",
                            remote_control.KEYCHAIN_SERVICE, "-w"],
                           capture_output=True, text=True)
    return remote_control.oauth_token(probe.stdout) if probe.returncode == 0 else None


def lost_sessions(folders: Iterable[Path]) -> "remote_control.SessionPage":
    """Sessions still active but disconnected on an environment this Mac registered.

    The page's status carries through, because three answers read differently and only one of
    them is a count: the question could not be asked, the page could not be trusted under its
    cap, or here are the rows — of which an empty list is a real answer.
    """
    token = claude_oauth_token()
    if not token:
        return remote_control.SessionPage(remote_control.SessionPage.FAILED)
    page = remote_control.fetch_sessions(token)
    if not page.ok:
        return page
    return page.with_rows(remote_control.disconnected_sessions(
        page.rows, host_environment_ids(folders)))


def default_base_branch(root: Path) -> str:
    """The branch a recreated session worktree starts from: origin's HEAD, else `main`."""
    probe = subprocess.run(["git", "-C", str(root), "symbolic-ref", "--short",
                            "refs/remotes/origin/HEAD"], capture_output=True, text=True)
    head = probe.stdout.strip()
    return head.split("/", 1)[1] if probe.returncode == 0 and "/" in head else "main"


def recreate_worktree(root: Path, path: Path, dry: bool) -> str:
    """Put a worktree the give-up cleanup deleted back at its path and branch.

    A lease-pickup worker needs its directory to exist; the branch is reattached when it
    survived, so any commits the session made are still its history.
    """
    if Path(path).is_dir():
        return "exists"
    branch = remote_control.worktree_branch(path)
    if dry:
        return f"would recreate on {branch}"
    subprocess.run(["git", "-C", str(root), "worktree", "prune"], capture_output=True, text=True)
    exists = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "--quiet", branch],
                            capture_output=True, text=True).returncode == 0
    argv = remote_control.worktree_add_argv(root, path, branch, default_base_branch(root), exists)
    done = subprocess.run(argv, capture_output=True, text=True)
    return f"recreated on {branch}" if done.returncode == 0 else f"failed: {done.stderr.strip()}"


def dirty_bridge_worktrees(folder: Path) -> List[Path]:
    """Spawned session worktrees with uncommitted changes, which host cleanup would delete."""
    out = []
    for tree in sorted((folder / ".claude" / "worktrees").glob("bridge-cse_*")):
        probe = subprocess.run(["git", "-C", str(tree), "status", "--porcelain"],
                               capture_output=True, text=True)
        if probe.returncode == 0 and probe.stdout.strip():
            out.append(tree)
    return out


def wip_commit(tree: Path, dry: bool) -> bool:
    """Commit a dirty session worktree in place. Never `git stash`: the stack is shared."""
    if dry:
        return True
    add = subprocess.run(["git", "-C", str(tree), "add", "-A"], capture_output=True, text=True)
    if add.returncode != 0:
        return False
    done = subprocess.run(["git", "-C", str(tree), "commit", "-m",
                           "chore(wip): preserve work before reconnect"], capture_output=True, text=True)
    return done.returncode == 0


def cmd_remote_control_heal(args: argparse.Namespace) -> int:
    """Keep each running host's bridge pointer live, so a relaunch re-adopts its environment.

    Claude Code only asks the server to reuse an environment when the folder's
    `bridge-pointer.json` is younger than its four-hour TTL and names a pid that is no longer
    running. A host that started without a pointer never writes one, so the file expires and
    every relaunch registers a fresh environment that adopts nothing. Each pass then re-queues
    this Mac's disconnected sessions; see `reconnect_lost_sessions`.
    """
    if platform.system() != "Darwin":
        say("remote-control heal: launchd agents are macOS only; nothing done")
        return 0
    dry = getattr(args, "dry_run", False)
    try:
        opts = remote_control.settings(load_config())
    except ValueError as exc:
        raise SystemExit(f"remote-control heal: {exc}")
    projects_root = claude_projects_root()
    state = remote_control.read_state(supervisor_state_path())
    state_changed = False
    for folder in opts["folders"]:
        name = remote_control.label(folder)
        pid = host_pid(name)
        if pid is None:
            heal_say(f"skip {folder}: host not running", dry)
            continue
        log = remote_control_log_dir() / (name + ".log")
        try:
            text = log.read_text(encoding="utf-8", errors="replace")
        except OSError:
            heal_say(f"skip {folder}: no log at {log}", dry)
            continue
        env = remote_control.environment_id(text)
        if not env:
            heal_say(f"skip {folder}: log names no environment yet", dry)
            continue
        started = proc_start(pid)
        if started is None:
            heal_say(f"skip {folder}: pid {pid} vanished", dry)
            continue
        path = remote_control.pointer_path(projects_root, folder)
        previous = remote_control.read_pointer(path)
        wanted = remote_control.pointer_payload(env, pid, started, previous)
        # An unchanged pointer is not a reason to stop reading the log: the stop and the
        # worktree recreation below matter most during the outage that leaves it unchanged.
        if not remote_control.pointer_is_current(previous, wanted, path):
            heal_say(f"pointer {path} -> {env} pid {pid}", dry)
            if not dry:
                path.parent.mkdir(parents=True, exist_ok=True)
                write_json_atomic(path, wanted)
        stalled = remote_control.unreachable_seconds(text)
        if stalled and stalled < remote_control.STOP_AT_SECONDS:
            heal_say(f"warn {folder}: unreachable for {stalled}s; stop at "
                     f"{remote_control.STOP_AT_SECONDS}s, give-up at {remote_control.GIVE_UP_SECONDS}s", dry)
        elif remote_control.stop_is_due(stalled, name, pid, state):
            # The host's own give-up at ten minutes archives every session, deregisters the
            # environment and deletes the worktrees. A SIGTERM before it takes the preserving
            # branch instead, and launchd's KeepAlive relaunch reads the pointer just written.
            host = claude_host_pid(pid)
            if host is None:
                heal_say(f"skip {folder}: no `claude` process under pid {pid} to stop", dry)
            else:
                if not dry:
                    try:
                        os.kill(host, signal.SIGTERM)
                    except OSError as exc:
                        heal_say(f"warn {folder}: SIGTERM to pid {host} failed: {exc}", dry)
                        host = None
                if host is not None:
                    heal_say(f"stop {folder}: SIGTERM to claude pid {host} after {stalled}s "
                             f"unreachable; launchd relaunches it", dry)
                    remote_control.record_stop(state, name, pid)
                    state_changed = True
        for stamp, tree in remote_control.unseen_worktrees(remote_control.removed_worktrees(text), state):
            outcome = recreate_worktree(Path(folder), Path(tree), dry)
            heal_say(f"worktree {tree}: {outcome}", dry)
            remote_control.record_worktree(state, stamp, tree)
            state_changed = True
        if getattr(args, "preserve_worktrees", False):
            for tree in dirty_bridge_worktrees(Path(folder)):
                ok = wip_commit(tree, dry)
                heal_say(f"wip {tree}: {'committed' if ok else 'commit failed'}", dry)
    if reconnect_lost_sessions(opts["folders"], projects_root, state, dry):
        state_changed = True
    if state_changed and not dry:
        supervisor_state_path().parent.mkdir(parents=True, exist_ok=True)
        write_json_atomic(supervisor_state_path(), state)
    return 0


def reconnect_lost_sessions(folders: List[Path], projects_root: Path, state: Dict[str, Any],
                            dry: bool) -> bool:
    """Re-queue each active but disconnected session on an environment this Mac holds.

    One sessions read per pass, and each session at most once per ten minutes. A missing token
    or a failed read is not an action and is not logged. Returns whether `state` changed.
    """
    token = claude_oauth_token()
    if not token:
        return False
    page = remote_control.fetch_sessions(token)
    if not page.ok:
        return False
    pointers = [remote_control.read_pointer(remote_control.pointer_path(projects_root, f))
                for f in folders]
    owned = remote_control.owned_environments(host_environment_ids(folders), pointers)
    changed, now = False, time.time()
    for row in remote_control.disconnected_sessions(page.rows, owned):
        session, env = row.get("id"), row.get("environment_id")
        if not session or not remote_control.reconnect_is_due(session, state, now):
            continue
        if dry:
            heal_say(f"reconnect {session} on {env}: not sent", dry)
            continue
        status = remote_control.reconnect(token, env, session)
        heal_say(f"reconnect {session} on {env}: {status}", dry)
        remote_control.record_reconnect(state, session, now)
        changed = True
    return changed


# A rule that trips in more than this share of sessions is prose the agent keeps walking past,
# and wants to be a hook; one with no hit at all over a full window can leave the 200 lines.
# Both need a window wide enough for the share to mean anything.
RULE_PROMOTE_SHARE = 0.30
RULE_MIN_SESSIONS = 20


def renamed_ids() -> Dict[str, str]:
    """Old detector id → the id that replaced it, from the registry's own `RENAMED` map."""
    module = load_detectors()
    mapping = getattr(module, "RENAMED", {}) or {}
    return {k: v for k, v in mapping.items() if isinstance(k, str) and isinstance(v, str)}


def folded_rules(row: Dict[str, Any], renamed: Dict[str, str]) -> Dict[str, int]:
    """One record's hits, with a renamed detector counted under its successor.

    A rename would otherwise split one measurement across two lines, and the older half would
    look like a detector that stopped firing. The ledger file is never rewritten for it: the
    fold is done on every read, so a record keeps the id it was written under.
    """
    out: Dict[str, int] = {}
    for did, n in (row.get("rules") or {}).items():
        if not isinstance(did, str):
            continue
        try:
            count = int(n or 0)
        except (TypeError, ValueError):
            count = 0
        key = renamed.get(did, did)
        out[key] = out.get(key, 0) + count
    return out


def rule_ids(rows: List[Dict[str, Any]]) -> List[str]:
    """Every detector id to report on: the registry's, so a rule with no hit is still a line,
    plus any id a record carries that the registry no longer defines — under its current name
    when the registry says it was renamed."""
    module = load_detectors()
    renamed = renamed_ids()
    ids = set(getattr(module, "DETECTORS", {}) or {})
    for row in rows:
        ids.update(renamed.get(k, k) for k in (row.get("rules") or {}) if isinstance(k, str))
    return sorted(ids)


def rule_report(rows: List[Dict[str, Any]], by: str, days: int) -> int:
    """`usage --rules`: hits per detector, or per repo or stance variant.

    Only a record that carries a `rules` map is evidence. One written before the detectors
    existed, or one whose registry would not import, is absent from every count and from the
    denominator: counting it as a session with no hit would turn a gap into a clean bill.

    Every grouping counts `folded_rules`, not the raw map, so a detector that was renamed is one
    line and one series in all three: by rule, by repo and by stance.
    """
    measured = [r for r in rows if isinstance(r.get("rules"), dict) and not r.get("rules_errors")]
    legacy = sum(1 for r in rows if not isinstance(r.get("rules"), dict) and not r.get("rules_error"))
    errored = sum(1 for r in rows if r.get("rules_error") or r.get("rules_errors"))
    if legacy or errored:
        say(f"{legacy + errored} session(s) in the window carry no rule data "
            f"({legacy} recorded before detectors, {errored} rules_error); run --rescan to backfill")
    if not measured:
        say(f"no measured sessions in the last {days} day(s)")
        return 0
    renamed = renamed_ids()
    counted = [(r, folded_rules(r, renamed)) for r in measured]

    if by == "rule":
        total = len(counted)
        head = f"{'detector':<38}{'hits':>7}{'sessions':>10}{'of':>6}{'share':>8}  note"
        say(head)
        say("-" * len(head))
        for did in rule_ids(measured):
            hits = sum(hits_of.get(did, 0) for _, hits_of in counted)
            seen = sum(1 for _, hits_of in counted if hits_of.get(did, 0) > 0)
            share = seen / total if total else 0.0
            note = ""
            if total >= RULE_MIN_SESSIONS:
                note = "promote?" if share > RULE_PROMOTE_SHARE else ("unobserved" if not hits else "")
            say(f"{did[:38]:<38}{hits:>7}{seen:>10}{total:>6}{share:>8.0%}  {note}".rstrip())
        return 0

    if by == "stance":
        # A rescan stamps the stances of the minute it ran, not of the session it read, so a
        # session grouped by them would be filed under a variant it may never have run under.
        guessed = [r for r in measured if r.get("stances_source") == "rescan"]
        if guessed:
            say(f"{len(guessed)} rescanned session(s) excluded: stance not known at the time")
        counted = [(r, h) for r, h in counted if r.get("stances_source") != "rescan"]
        if not counted:
            say(f"no sessions with a known stance in the last {days} day(s)")
            return 0

    groups: Dict[str, List[Any]] = {}
    for row, hits_of in counted:
        if by == "stance":
            stances = row.get("stances") if isinstance(row.get("stances"), dict) else {}
            keys = [f"{k}={v}" for k, v in sorted(stances.items())] or ["(no stances)"]
        else:
            keys = [row.get("repo") or "(no repo)"]
        for key in keys:
            acc = groups.setdefault(key, [0, {}])
            acc[0] += 1
            for did, n in hits_of.items():
                acc[1][did] = acc[1].get(did, 0) + n
    head = f"{by:<42}{'sessions':>9}{'hits':>7}  top detectors"
    say(head)
    say("-" * len(head))
    for key in sorted(groups):
        sessions, counts = groups[key]
        top = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:3]
        say(f"{key[:42]:<42}{sessions:>9}{sum(counts.values()):>7}  "
            + (", ".join(f"{d} {n}" for d, n in top) or "-"))
    return 0


# --------------------------------------------------------------------------- telemetry


def usage_ledger(path: Path) -> List[Dict[str, Any]]:
    """The usage ledger's rows, oldest first, read by the hook that writes them.

    `ledger_rows` folds renamed fields and carries fields and schema versions it does not know,
    so a row from a newer writer is read rather than refused; see `SCHEMA_VERSION` in
    `usage-log.py`. An absent file is no rows.
    """
    if not path.exists():
        return []
    text = path.read_text(encoding="utf-8")
    return load_hook_module("usage-log", required=True).ledger_rows(text)


def load_hook_module(name: str, root: Path = REPO, required: bool = False):
    """A module from `root`'s hook directory, or None when it has none.

    The hooks are standalone scripts: they are reached through `~/.claude/hooks/harness` and
    nothing above that directory resolves from them. So a module both the CLI and a hook need
    lives beside the hooks and is loaded from its file here, rather than imported from a library
    the hook could not reach — and neither side gets its own copy of the behaviour.
    """
    import importlib.util

    path = root / "claude" / "hooks" / (name + ".py")
    if not path.is_file():
        if required:
            raise SystemExit(f"this checkout has no {path}; reinstall or re-clone it")
        return None
    try:
        spec = importlib.util.spec_from_file_location("harness_" + name, str(path))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except Exception:
        if required:
            raise SystemExit(f"{path} could not be loaded; reinstall or re-clone this checkout")
        return None


def load_telemetry(root: Path = REPO):
    """The exporter the usage hook runs, or None when this checkout has none.

    Loaded from the hook's own file rather than reimplemented here, so the CLI validates a
    `telemetry` block with the same code that will send the rows.
    """
    return load_hook_module("telemetry", root)


def telemetry_settings(cfg: Dict[str, Any]) -> Dict[str, Any]:
    """The validated `telemetry` block. A block that cannot be honoured stops the command."""
    module = load_telemetry()
    if module is None:
        return {"export": "off"}
    try:
        return module.settings(cfg)
    except ValueError as exc:
        raise SystemExit(str(exc))


def _valid_date(value: str, flag: str) -> str:
    try:
        time.strptime(value, "%Y-%m-%d")
    except ValueError:
        raise SystemExit(f"{flag} takes a date as YYYY-MM-DD; got '{value}'")
    return value


def cmd_usage_export(args: argparse.Namespace) -> int:
    """Replay a window of ledger rows to the configured OTLP endpoint.

    Delivery is at-least-once: a batch that fails is reported and left for the next replay,
    and a backend de-duplicates on `harness.row_key`. The ledger is the record; the backend is
    a copy that can be rebuilt from it. See docs/telemetry.md.
    """
    module = load_telemetry()
    if module is None:
        raise SystemExit("this checkout has no claude/hooks/telemetry.py; nothing can be exported")
    if not getattr(args, "since", None):
        raise SystemExit("usage export needs --since YYYY-MM-DD")
    since = _valid_date(args.since, "--since")
    until = _valid_date(args.until, "--until") if getattr(args, "until", None) else "9999-12-31"
    settings = telemetry_settings(load_config())
    if settings.get("export") != "otlp" and not args.dry_run:
        raise SystemExit(
            "telemetry.export is off; set it to \"otlp\" in ~/.config/agent-harness/config.json "
            "to send rows, or re-run with --dry-run to count what a replay would send")
    path = state_dir() / "usage.jsonl"
    rows = [row for row in usage_ledger(path) if since <= (row.get("ended") or "")[:10] <= until]
    batch_count = sum(1 for _ in module.batches(rows))
    window = f"{since}..{until if until != '9999-12-31' else 'today'}"
    if args.dry_run:
        target = module.endpoint_label(settings.get("endpoint", "")) or "no endpoint configured"
        state = "" if settings.get("export") == "otlp" else " (export is off)"
        say(f"{len(rows)} row(s) in {window} would be sent in {batch_count} batch(es) "
            f"to {target}{state}")
        return 0
    sent, failed = module.export_rows(
        rows, config=settings, version=VERSION, prices=load_prices(load_config()),
        errors_path=state_dir() / "usage.errors.jsonl")
    say(f"{window}: sent {sent} row(s) in {batch_count} batch(es) to "
        f"{module.endpoint_label(settings['endpoint'])}, {failed} row(s) failed")
    if failed:
        say(f"  failures are recorded in {state_dir() / 'usage.errors.jsonl'}; re-run the same "
            f"window to retry, and de-duplicate on harness.row_key")
    return 1 if failed else 0


# --------------------------------------------------------------------------- prices

PRICES_PATH = REPO / "policy" / "prices.json"

# Every rate, every id spelling and the session/subagent join live in `policy/hooks/pricing.py`
# and are bound here rather than reimplemented: the exporter runs as a standalone hook and has
# to reach the same code, so the dollars a report prints and the dollars an exported row carries
# cannot drift apart. `PRICES_PATH` stays the CLI's own, and every call site below passes it, so
# this checkout's price file is the one the CLI reads whatever else is installed.
pricing = load_hook_module("pricing", required=True)
RATE_FIELDS = pricing.RATE_FIELDS
TOKEN_TIERS = pricing.TOKEN_TIERS
PRICE_STALE_DAYS = pricing.PRICE_STALE_DAYS
shipped_prices = pricing.shipped_prices
normalise_model = pricing.normalise_model
usable_rate = pricing.usable_rate
price_for = pricing.price_for
row_tokens = pricing.row_tokens
tokens_cost = pricing.tokens_cost
breakdown_cost = pricing.breakdown_cost
row_model = pricing.row_model
row_cost = pricing.row_cost
session_children = pricing.session_children
newest_as_of = pricing.newest_as_of
price_age_days = pricing.price_age_days


def load_prices(cfg: Dict[str, Any], path: Optional[Path] = None) -> Dict[str, Dict[str, Any]]:
    """The shipped table with the user's `prices` block merged over it. See `pricing.py`."""
    return pricing.load_prices(cfg, PRICES_PATH if path is None else path)


def percentile(values: List[Any], share: float) -> Any:
    """The nearest-rank percentile of a sorted sample: the smallest value at or above `share`."""
    if not values:
        return 0
    index = math.ceil(share * len(values)) - 1
    return values[min(max(index, 0), len(values) - 1)]


# The `--by profile` group of a row that carries no profile fingerprint (AD-23).
UNATTRIBUTED = "(unattributed)"


def stance_key(row: Dict[str, Any], dimension: str) -> str:
    """The group a row belongs to under `--by stance --stance <dimension>`.

    A row whose stances were stamped by a rescan is grouped as unknown rather than under a
    variant it may never have run under — the rescan reads this minute's environment, not the
    session's. Unknown is a group of its own and is counted: dropping those rows would make a
    newly stamped variant look like the whole history of the ledger.
    """
    if row.get("stances_source") == "rescan":
        return "(unknown)"
    stances = row.get("stances") if isinstance(row.get("stances"), dict) else {}
    value = stances.get(dimension)
    return f"{dimension}={value}" if isinstance(value, str) and value else "(unknown)"


def decision_report(days: int) -> int:
    """`usage --by decision`: what each hook decided, and how often the session said.

    The log is append-only, so an outcome is its own record and the join happens here rather
    than in the file; `decisions.py` holds both halves. Counts, the outcomes seen per point and
    the unlabelled share, because the share is the number that says whether a point's labels
    can be trusted yet — a rate over the two decisions that happened to be labelled is not
    evidence about the point.
    """
    module = load_hook_module("decisions")
    if module is None:
        raise SystemExit("this checkout has no claude/hooks/decisions.py; reinstall or re-clone it")
    path = state_dir() / "decisions.jsonl"
    cutoff = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - max(days, 0) * 86400))
    rows = [r for r in module.joined(module.read_rows(path)) if (r.get("ts") or "") >= cutoff]
    if not rows:
        say(f"no hook decisions recorded in the last {days} day(s); looked in {path}")
        return 0
    groups: Dict[str, List[Dict[str, Any]]] = {}
    for row in rows:
        # A sampled allow is a negative nobody graded, so it groups apart from the judgments at
        # the same point: folded in, it would read as one more unlabelled decision and drag the
        # point's unlabelled share towards the sampling rate.
        point = str(row.get("point") or "(unnamed)") + (" (sampled)" if row.get("sampled") else "")
        groups.setdefault(point, []).append(row)
    head = f"{'decision':<24}{'rows':>7}{'labelled':>10}{'unlabelled':>12}  outcomes"
    say(head)
    say("-" * len(head))
    for point in sorted(groups):
        group = groups[point]
        labelled = [r for r in group if r.get("outcome") is not None]
        counts: Dict[str, int] = {}
        for row in labelled:
            key = str(row["outcome"])
            counts[key] = counts.get(key, 0) + 1
        share = (len(group) - len(labelled)) / len(group)
        detail = ", ".join(f"{name} {n} ({n / len(labelled):.0%})"
                           for name, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])))
        say(f"{point[:24]:<24}{len(group):>7}{len(labelled):>10}{share:>11.0%}   {detail or '-'}")
    return 0


PROVIDER_STATUSES = ("ok", "unknown", "unavailable", "error")


def provider_report(rows: List[Dict[str, Any]], days: int,
                    table: Optional[Dict[str, Dict[str, Any]]] = None) -> int:
    """`usage --by provider`: what each decision point spent asking a provider, per mode.

    A judgment that costs dollars and is never priced reads as free, and one that adds a second
    to every hook reads as a slow machine, so the two figures are reported together: tokens and
    dollars from the same price table every other row is priced with, and the latency
    distribution beside them. Latency is a distribution for `role_report`'s reason — a mean
    hides the timeout that held a turn — and the tail is the figure a timeout is set from.

    Statuses are counted separately rather than summed into a success rate. `unknown` is an
    answer the provider gave and abstained from, `unavailable` is no answer at all, and a rate
    that mixed them would say the provider was working when it was unreachable.
    """
    table = {} if table is None else table
    if not rows:
        say(f"no decision-provider calls recorded in the last {days} day(s); "
            "`citizen doctor` says whether any point is configured to make one")
        return 0
    groups: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}
    for row in rows:
        groups.setdefault((str(row.get("point") or "(unset)"), str(row.get("mode") or "?")),
                          []).append(row)
    head = (f"{'point':<20}{'mode':<8}{'calls':>7}" + "".join(f"{name:>12}" for name in PROVIDER_STATUSES)
            + f"{'input':>10}{'usd':>9}{'ms p50':>9}{'ms p90':>9}")
    say(head)
    say("-" * len(head))
    unpriced = 0
    for key in sorted(groups):
        group = groups[key]
        costs = [row_cost(r, table) for r in group]
        unpriced += sum(1 for c in costs if c is None)
        usd = sum(c for c in costs if c is not None)
        latency = sorted(float(r["ms"]) for r in group if isinstance(r.get("ms"), (int, float)))
        tokens = sum(int(r["input"]) for r in group if isinstance(r.get("input"), int))
        counts = [sum(1 for r in group if r.get("status") == name) for name in PROVIDER_STATUSES]
        cells = "".join(f"{n:>12,}" for n in counts)
        tail = "".join(f"{percentile(latency, share):>9.0f}" if latency else f"{'-':>9}"
                       for share in (0.5, 0.9))
        say(f"{key[0][:20]:<20}{key[1][:8]:<8}{len(group):>7}{cells}{tokens:>10,}{usd:>9.4f}{tail}")
    say(f"unpriced: {unpriced} call(s), unknown model or no reported usage" if unpriced
        else "unpriced: none")
    if not table:
        say(f"no price table: {PRICES_PATH} is missing or unreadable")
    return 0


ROLE_MIN_RUNS = 30
# The `--by role` bucket for Workflow-tool agents, which the tool launched rather than a spawn:
# no spawn hook routed them and no brief budgeted them, so a role name they carry is not a run
# of that role, and counting it as one would move the percentiles a budget is re-seeded from.
WORKFLOW_BUCKET = "(workflow)"


def measured_share(rows: List[Dict[str, Any]], field: str, value: Any,
                   among: Optional[Tuple[Any, ...]] = None) -> Optional[float]:
    """The share of `rows` whose `field` is `value`, over the rows the question applies to.

    None when it applies to none of them. A row written before the field existed, a runtime
    that reports no return and a return nothing could be joined to all record `null`, and
    counting those as the absence of the property would report a measurement the ledger never
    made. `among` narrows the denominator further: the share of returns that resolved is asked
    of the returns that carried a path at all, since a return that named none — a one-line
    verdict owes no file — is not a return whose path went nowhere.
    """
    seen = [row.get(field) for row in rows if row.get(field) is not None]
    counted = [value_ for value_ in seen if among is None or value_ in among]
    if not counted:
        return None
    return sum(1 for value_ in counted if value_ == value) / len(counted)


def role_report(rows: List[Dict[str, Any]], days: int,
                table: Optional[Dict[str, Dict[str, Any]]] = None) -> int:
    """Output tokens, dollars and tool calls per agent type, over the subagent and worker rows.

    Spend per delegated task is a distribution, not a mean: a budget set at the mean is wrong
    for most of the sample, which is why the report prints three points on the curve instead.
    Dollars get two points rather than three, because a role's dollar curve is its output curve
    read through one model and the tail says nothing the tokens have not already said.

    A role with fewer than `ROLE_MIN_RUNS` runs is marked `n<30`, because a p90 over eight runs
    is the second-largest of eight and a budget re-seeded from it is a guess wearing a number.

    `path` and `over` are the two measured facts about the returns themselves: of the returns
    that named a path, the share whose path resolved; and of the returns measured against a
    cap, the share that ran past it. A return that named no path is in neither figure, so a
    role whose returns are all one-line verdicts prints `-` for `path` rather than `0%`, which
    would read as a role that wrote paths and got them all wrong. A row from before the
    measurement existed, a Codex row and a return nothing could be joined to are `-` too.

    A row with a `workflow` directory is grouped under `WORKFLOW_BUCKET`, printed last, whatever
    its `agent_type` says, and never priced against that role's budget. That holds for a row
    written before the ledger marked such rows `unconfined`, since the directory is the evidence.
    """
    table = {} if table is None else table
    groups: Dict[str, List[Dict[str, Any]]] = {}
    for row in rows:
        key = WORKFLOW_BUCKET if row.get("workflow") else (row.get("agent_type") or "(unnamed)")
        groups.setdefault(key, []).append(row)
    if not groups:
        say(f"no subagent or worker runs recorded in the last {days} day(s); "
            "run `citizen usage --rescan` to backfill them from transcripts")
        return 0
    head = (f"{'role':<30}{'runs':>6}{'out p50':>10}{'out p75':>10}{'out p90':>10}"
            f"{'usd p50':>9}{'usd p75':>9}"
            f"{'tools p50':>11}{'tools p75':>11}{'tools p90':>11}"
            f"{'path':>5}{'over':>5}{'unmeasured':>12}{'sample':>8}")
    say(head)
    say("-" * len(head))
    unpriced = 0
    for key in sorted(groups, key=lambda name: (name == WORKFLOW_BUCKET, name)):
        group = groups[key]
        output = sorted(int(r["output"]) for r in group if isinstance(r.get("output"), int))
        tools = sorted(int(r["tool_calls"]) for r in group if isinstance(r.get("tool_calls"), int))
        # A delegated run is priced at the model it ran on, alone: a subagent has no children
        # of its own in the ledger, so nothing is subtracted and nothing is added.
        costs = [row_cost(r, table) for r in group]
        unpriced += sum(1 for c in costs if c is None)
        usd = sorted(c for c in costs if c is not None)
        # A run whose runtime reported no tool-call count is named, never averaged in as a
        # zero; the percentiles are taken over the runs that do report one.
        gaps = sum(1 for r in group if not isinstance(r.get("tool_calls"), int))
        cells = [f"{percentile(output, s):>10,}" if output else f"{'-':>10}" for s in (0.5, 0.75, 0.9)]
        cells += [f"{percentile(usd, s):>9.4f}" if usd else f"{'-':>9}" for s in (0.5, 0.75)]
        cells += [f"{percentile(tools, s):>11,}" if tools else f"{'-':>11}" for s in (0.5, 0.75, 0.9)]
        cells += [f"{share:>5.0%}" if share is not None else f"{'-':>5}"
                  for share in (measured_share(group, "return_path", "resolvable",
                                               among=("resolvable", "unresolvable")),
                                measured_share(group, "return_over_budget", True))]
        mark = f"n<{ROLE_MIN_RUNS}" if len(group) < ROLE_MIN_RUNS else ""
        say(f"{key[:30]:<30}{len(group):>6}" + "".join(cells) + f"{gaps or '-':>12}{mark:>8}")
    say(f"unpriced: {unpriced} run(s), unknown model or partial tokens" if unpriced
        else "unpriced: none")
    if WORKFLOW_BUCKET in groups:
        say(f"{WORKFLOW_BUCKET}: {len(groups[WORKFLOW_BUCKET])} Workflow-tool run(s), unconfined; "
            "not counted as spawns of any role and priced against no role budget")
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    """Summarize the records the usage-log hook writes. Local file only.

    Every row names its `kind`. A Claude Code session's totals already include its subagents',
    so the token groupings sum session and worker rows and never a Claude Code subagent's; a
    role-run worker has no session row, so leaving workers out would hide their spend entirely.
    `--by role` reads the subagent and worker rows, which for Claude Code carry the same tokens
    a second time, attributed.

    Codex is the other way round and its subagent rows are summed. A Codex thread's
    `total_token_usage` counts that thread alone: over the 21 parent threads on one machine
    that have both a typed total and children with one, four parents report fewer tokens than
    their own children sum to — 2.0M against 30.6M in the widest case — which a total that
    included them could not do. So a Codex parent plus its children is the session's bill, and
    dropping the children would undercount it.

    `--by day` reads a row's `days` slices when it carries them and falls back to its end date
    when it does not, so a session that ran for a fortnight is spread over the days it spent on
    rather than charged whole to the day it ended. The `--days` window then applies to the slice
    date: a long session contributes only its in-window days.

    `--by decision` is a different file and a different question — what the hooks decided, not
    what the session spent — and is `decision_report` above.

    Dollars come from `policy/prices.json` through `row_cost`, which prices a session's own
    tokens at the session's model and its subagents' at theirs. A row with an unknown model or
    partial tokens is counted as unpriced in the footer and contributes nothing to the column:
    it is not free, and a zero would say it was.
    """
    if getattr(args, "action", None) == "export":
        return cmd_usage_export(args)
    path = state_dir() / "usage.jsonl"
    by = getattr(args, "by", "day")
    if getattr(args, "conflicts", False):
        # Landing merges and intent overlaps per week, from the decision log: lib/harness_core/intents.py.
        if by != "day" or getattr(args, "rules", False) or getattr(args, "stance", None):
            print("usage --conflicts reports landing merges per week; --by, --rules and --stance "
                  "do not apply", file=sys.stderr)
            return 2
        for line in intents.conflict_report(args.days):
            say(line)
        return 0
    if by == "decision":
        # A different file and a different question: what the hooks decided, not what the
        # session spent. Neither `--rules` nor `--stance` says anything about it.
        if getattr(args, "rules", False) or getattr(args, "stance", None):
            print("usage --by decision reports hook decisions; --rules and --stance do not apply",
                  file=sys.stderr)
            return 2
        return decision_report(args.days)
    stance = getattr(args, "stance", None)
    # `--by stance` means one of two reports, and which one is said rather than inferred:
    # `--rules` asks for detector hits per variant, `--stance <name>` for tokens grouped by that
    # dimension's value. Neither is a report this cannot guess at, so it refuses.
    rules_mode = getattr(args, "rules", False) or by == "rule"
    if by == "stance" and not rules_mode and not stance:
        print("usage --by stance needs --stance <dimension> for tokens, or --rules for hits",
              file=sys.stderr)
        return 2
    if rules_mode and by in ("model", "role", "profile"):
        # Reporting something else silently would be worse than refusing: a rule hit belongs
        # to a session, and a session's hits cannot be attributed to one of its models, nor to
        # a subagent whose conduct the session's detectors never measured.
        print(f"usage --rules groups by rule, repo or stance; --by {by} is not one of them",
              file=sys.stderr)
        return 2
    if by == "provider" and (rules_mode or stance):
        # A provider call is not a session: it ran under no stance and no detector measured it.
        print("usage --by provider reports decision-provider calls; --rules and --stance do "
              "not apply", file=sys.stderr)
        return 2
    if by == "prefix" and (rules_mode or stance):
        # A detector hit belongs to a session's conduct and a stance groups its tokens; a
        # cache prefix is a property of the session's context, and neither of those reports
        # answers its question. Refused rather than accepted and ignored.
        print("usage --by prefix reports cache-prefix stability; --rules and --stance do not apply",
              file=sys.stderr)
        return 2
    if rules_mode and by == "day":
        by = "rule"
    if getattr(args, "rescan", False):
        hook = REPO / "claude" / "hooks" / "usage-log.py"
        out = subprocess.run([sys.executable, str(hook), "--rescan", str(args.days)], capture_output=True, text=True)
        say((out.stdout or out.stderr).strip() or "rescan found no transcripts")
    cutoff = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - max(args.days, 0) * 86400))
    cutoff_day = cutoff[:10]
    sliced = by == "day" and not rules_mode
    groups: Dict[str, List[Any]] = {}
    kept: List[Dict[str, Any]] = []
    delegated: List[Dict[str, Any]] = []
    unknown_metrics = set()
    unpriced = 0
    # The measured inflation of the counted totals, weighted by the deduplicated tokens each
    # run contributed to them, so the footer figure is the window's raw sum over its counted
    # sum and a long session moves it more than a short one. A run whose row carries no
    # measured ratio — a Codex row, which says `unknown`, a worker row, or a row written
    # before the field existed, which carries no key at all — is counted as unknown.
    dedup_raw, dedup_counted, dedup_runs, dedup_unknown = 0.0, 0, 0, 0
    ledger = usage_ledger(path)
    if by == "prefix":
        # Read-only and retrospective: `cache_prefix` derives the miss ratio from the cache
        # fields these rows already carry and names where it stepped. Nothing is priced.
        return cache_prefix.report(ledger, cutoff, args.days, say)
    table = load_prices(load_config())
    if by == "provider":
        return provider_report([row for row in ledger
                                if row.get("kind") == decision_ledger.KIND
                                and (row.get("ended") or "") >= cutoff],
                               args.days, table)
    # A session is priced with its subagent rows in hand, so the whole ledger is indexed before
    # anything is summed; a child outside the window still belongs to its parent's bill.
    children = session_children(ledger)
    for row in ledger:
        ended = row.get("ended") or ""
        days_map = row.get("days") if isinstance(row.get("days"), dict) else {}
        # A session that ran for a fortnight ended on one date and spent on fourteen. Grouped
        # by day it is read through its slices, so it is kept when any of them is in the window
        # even though its end date is not; every other grouping still turns on the end date.
        if ended < cutoff and not (sliced and any(day >= cutoff_day for day in days_map)):
            continue
        # A row written before `kind` existed is a session, which is all there was to record.
        kind = row.get("kind") or "session"
        if kind == decision_ledger.KIND:
            # A provider call is priced on its own report. Its tokens were spent by the harness
            # asking a question, not by the session, and adding them to a day's totals would
            # charge a session for a bill it did not run up.
            continue
        if kind != "session" and ended >= cutoff:
            delegated.append(row)
        # A Claude Code subagent's tokens are already in its session's row; a Codex subagent's
        # are in no row but its own, and a worker's are in no session's because a role-run
        # worker has no session. So the totals are sessions, workers and Codex subagents.
        if by == "role" or (kind == "subagent" and row.get("runtime") != "codex"):
            continue
        if rules_mode:
            # Only a session's own conduct was measured by the detectors.
            if kind == "session":
                kept.append(row)
            continue
        cost = row_cost(row, table, children.get(row.get("session_id") or "")
                        if kind == "session" and row.get("runtime") != "codex" else None)
        # The ratio is reported over exactly what TOTAL counts: a run where the runs column
        # counts one, and tokens where the token columns add them, which under `--by day` is
        # the in-window slices and not the whole row.
        ratio = row.get("raw_vs_deduped")
        measured = isinstance(ratio, float)
        if sliced and days_map:
            # The run is counted on the day the session ended, once; its tokens are counted on
            # the days they were spent. So the run column still counts sessions rather than
            # session-days, and TOTAL runs stays the number of sessions in the window.
            if ended >= cutoff:
                groups.setdefault(ended[:10], [0, 0, 0, 0, 0, 0.0])[0] += 1
                if cost is None:
                    unpriced += 1
                if measured:
                    dedup_runs += 1
                else:
                    dedup_unknown += 1
            # A slice carries tokens and no model, so a multi-day session's cost is allocated
            # across its days by each day's share of its tokens. For the single-day session,
            # which is nearly all of them, the share is one and the allocation is exact; for a
            # long one it is an allocation and not a measurement, and a day whose tokens were
            # spent on a dearer model carries less than it cost.
            spent = sum(max(int(row.get(name) or 0), 0) for name in RATE_FIELDS)
            for date, slice_ in days_map.items():
                if date < cutoff_day or not isinstance(slice_, dict):
                    continue
                acc = groups.setdefault(date, [0, 0, 0, 0, 0, 0.0])
                share = 0
                for i, name in enumerate(RATE_FIELDS):
                    try:
                        value = int(slice_.get(name) or 0)
                    except (TypeError, ValueError):
                        value = 0
                    acc[i + 1] += value
                    share += value
                if measured:
                    dedup_raw += ratio * share
                    dedup_counted += share
                if cost is not None and spent:
                    acc[5] += cost * share / spent
            continue
        if by == "repo":
            key = row.get("repo") or "(no repo)"
        elif by == "model":
            # A session names every model it ran on; a subagent or worker row names the one it
            # ran on, so both are read rather than the second falling to "(unknown)".
            key = ("+".join(row.get("models") or []) or row.get("model") or "(unknown)")
        elif by == "stance":
            key = stance_key(row, stance)
        elif by == "profile":
            # A row from before the fingerprint, or one whose profile could not be resolved, is
            # unattributed: it is never grouped under a fingerprint it was not written with. A
            # value that is not a string is unattributed too, rather than an unhashable key.
            value = row.get("profile_fingerprint")
            key = value if isinstance(value, str) and value else UNATTRIBUTED
        else:
            key = ended[:10]
        acc = groups.setdefault(key, [0, 0, 0, 0, 0, 0.0])
        acc[0] += 1
        if cost is None:
            unpriced += 1
        counted = sum(v for v in (row.get(name) for name in RATE_FIELDS)
                      if isinstance(v, int) and not isinstance(v, bool) and v > 0)
        if measured:
            dedup_raw += ratio * counted
            dedup_counted += counted
            dedup_runs += 1
        else:
            dedup_unknown += 1
        if cost is not None:
            acc[5] += cost
        for i, name in enumerate(RATE_FIELDS):
            if row.get(name) is None:
                unknown_metrics.add(name)
            try:
                acc[i + 1] += int(row.get(name) or 0)
            except (TypeError, ValueError):
                pass
    if by == "role":
        return role_report(delegated, args.days, table)
    if rules_mode:
        return rule_report(kept, by, args.days)
    if not groups:
        say(f"no sessions recorded in the last {args.days} day(s); looked in {path}")
        return 0

    def line_for(label: str, acc: List[Any]) -> str:
        served = acc[1] + acc[3] + acc[4]
        hit = acc[3] / served if served else 0.0
        return (f"{label[:34]:<34}{acc[0]:>9}{acc[1]:>12,}{acc[2]:>12,}"
                f"{acc[3]:>14,}{acc[4]:>14,}{hit:>7.0%}{acc[5]:>11.2f}")

    # Said once, or not at all: when a run's missing counts left it unpriced, the footer below
    # already reports it, and the two lines read as two different problems — one that figures
    # were dropped from the totals, one that they were counted as unpriced. A report with no
    # unpriced run still needs the warning, because nothing else says a column is short.
    if unknown_metrics and not unpriced:
        say("Partial totals: unavailable metrics are excluded: " + ", ".join(sorted(unknown_metrics)))
    head = (f"{by:<34}{'runs':>9}{'input':>12}{'output':>12}"
            f"{'cache_read':>14}{'cache_write':>14}{'hit':>7}{'usd':>11}")
    say(head)
    say("-" * len(head))
    total = [0, 0, 0, 0, 0, 0.0]
    for key in sorted(groups):
        total = [t + a for t, a in zip(total, groups[key])]
        say(line_for(key, groups[key]))
    say("-" * len(head))
    say(line_for("TOTAL", total))
    # Named on every report, priced or not: a dollar column with nothing under it reads as a
    # cheap window unless the runs it could not price are counted somewhere.
    say(f"unpriced: {unpriced} run(s), unknown model or partial tokens" if unpriced
        else "unpriced: none")
    # The size of the deduplication, said rather than silently applied: the columns above are
    # the corrected figures, and this is how much larger counting every transcript line would
    # have made them. See docs/usage.md.
    if dedup_counted:
        say(f"raw_vs_deduped: raw totals were {dedup_raw / dedup_counted:.2f}x the counted "
            f"totals over {dedup_runs} run(s), weighted by counted tokens"
            + (f"; {dedup_unknown} run(s) unknown" if dedup_unknown else ""))
    else:
        say("raw_vs_deduped: unknown, no run in this window recorded a raw figure")
    if not table:
        say(f"no price table: {PRICES_PATH} is missing or unreadable")
    return 0


# --------------------------------------------------------------- framework integrations


def toml_surface(text: str) -> Tuple[set, set]:
    """Read declared customization keys and keyed layer ids structurally."""
    doc = reconcile.tomlkit.parse(text).unwrap()
    keys, entries = set(), set()
    def visit(value, prefix=""):
        for key, child in value.items():
            name = prefix + key
            if isinstance(child, dict):
                visit(child, name + ".")
            elif isinstance(child, list) and child and isinstance(child[0], dict):
                for item in child:
                    ident = item.get("id", item.get("code"))
                    if ident:
                        entries.add((name, ident))
            else:
                keys.add(name)
    visit(doc)
    return keys, entries


def integration_install(name: str) -> dict:
    """The install block of the declared integration `name`, or an error naming what is declared."""
    data = frameworks.installable(name)
    if data is None or not data.get("install"):
        known = sorted(d["id"] for d in frameworks.descriptors() if d.get("install"))
        raise ValueError(f"no installable integration `{name}`; declared: {', '.join(known) or 'none'}")
    return data


def _repo_root(path: Optional[str]) -> Path:
    start = Path(path).expanduser() if path else Path.cwd()
    probe = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True)
    return Path(probe.stdout.strip()) if probe.returncode == 0 and probe.stdout.strip() else start.resolve()


def integration_surface(install: dict, root: Path, skill: str) -> Path:
    """Where the framework's installed skill declares the surface a template relies on."""
    candidates = [root / folder / skill / install["skill_surface"] for folder in install["skill_roots"]]
    present = [path for path in candidates if path.is_file()]
    if len(present) == 2 and present[0].read_bytes() != present[1].read_bytes():
        raise ValueError("skill projections disagree: " + skill)
    return present[0] if present else candidates[0]


def integration_templates(install: dict) -> List[Path]:
    return sorted((REPO / install["templates"]).glob("*" + install["suffix"]))


def integration_drift(template_text: str, base_text: str, surface: str = "customize.toml") -> List[str]:
    """Every key and layer id the template relies on that the installed skill no longer declares."""
    want_keys, want_entries = toml_surface(template_text)
    have_keys, have_entries = toml_surface(base_text)
    drift = [f"key `{key}` is not in the installed {surface}" for key in sorted(want_keys - have_keys)]
    drift += [f"`{array}` has no entry `{ident}` in the installed {surface}"
              for array, ident in sorted(want_entries - have_entries)]
    return drift


def integration_projection_findings(install: dict, root: Path) -> List[str]:
    """Check mirrored source files and literal skill invocations, without executing workflows."""
    findings: List[str] = []
    surfaces = [root / folder for folder in install["skill_roots"]]
    inventories = [{p.name: p for p in surface.iterdir() if p.is_dir()}
                   if surface.is_dir() else {} for surface in surfaces]
    for name in sorted(set.intersection(*[set(i) for i in inventories]) if inventories else set()):
        sources = [{str(p.relative_to(skills[name])): p.read_bytes()
                    for p in skills[name].rglob("*") if p.is_file() and p.suffix in (".md", ".toml")}
                   for skills in inventories]
        if any(source != sources[0] for source in sources[1:]):
            findings.append(f"{name}: mirrored Markdown/TOML sources disagree")
    pattern = re.compile(r"Invoke via the `([a-z0-9-]+)` skill")
    for surface, skills in zip(surfaces, inventories):
        for name, directory in sorted(skills.items()):
            for source in sorted(directory.rglob("*.md")):
                for dependency in sorted(set(pattern.findall(source.read_text(encoding="utf-8")))):
                    if not (surface / dependency / "SKILL.md").is_file():
                        findings.append(f"{source.relative_to(root)}: invoked skill `{dependency}` is missing")
    return findings


def integration_check(data: dict, root: Path) -> Tuple[List[str], List[str]]:
    """Status lines and drift findings, one template at a time, for the skills the repo has."""
    install = data["install"]
    lines: List[str] = []
    drift: List[str] = integration_projection_findings(install, root)
    for template in integration_templates(install):
        skill = template.name[: -len(install["suffix"])]
        base = integration_surface(install, root, skill)
        if not base.exists():
            lines.append(f"  {skill}: not installed here, skipped")
            continue
        text = template.read_text(encoding="utf-8")
        drift += [f"{skill}: {d}" for d in integration_drift(text, base.read_text(encoding="utf-8"),
                                                              install["skill_surface"])]
        installed = root / install["destination"] / template.name
        if not installed.exists():
            state = f"template not installed (citizen integration apply {data['id']})"
        elif installed.read_text(encoding="utf-8") == text:
            state = "installed"
        else:
            state = "installed, differs from the template"
        lines.append(f"  {skill}: {state}")
    return lines, drift


def integration_apply(data: dict, root: Path, force: bool) -> List[str]:
    """Install each template whose skill the repo has and whose surface still matches.

    One line per action taken or refused; nothing for a template already in place. A drifting
    template is skipped rather than written, so an upstream rename never adds a second layer."""
    install = data["install"]
    actions: List[str] = []
    dest_dir = root / install["destination"]
    for template in integration_templates(install):
        skill = template.name[: -len(install["suffix"])]
        base = integration_surface(install, root, skill)
        if not base.exists():
            continue
        text = template.read_text(encoding="utf-8")
        dest = dest_dir / template.name
        rel = dest.relative_to(root)
        drift = integration_drift(text, base.read_text(encoding="utf-8"), install["skill_surface"])
        if drift:
            actions.append(f"  skipped {rel}: {len(drift)} drift finding(s), "
                           f"see citizen integration check {data['id']}")
            continue
        if dest.exists() and dest.read_text(encoding="utf-8") == text:
            continue
        if dest.exists() and not force:
            actions.append(f"  kept {rel}: differs from the template (--force replaces it)")
            continue
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest.write_text(text, encoding="utf-8")
        actions.append(f"  wrote {rel}")
    return actions


def cmd_integration(args: argparse.Namespace) -> int:
    """`check` compares a declared integration's override templates with the framework's installed
    skills; `apply` installs the ones those skills declare and still match, never replacing a
    differing override without --force, then checks. The framework is named by the descriptor in
    policy/integrations/, so no framework is named here."""
    try:
        data = integration_install(getattr(args, "name", None) or "bmad")
    except ValueError as error:
        say(str(error))
        return 1
    install = data["install"]
    root = _repo_root(args.path)
    if not (root / install["detect"]).is_dir():
        say(f"no {install['detect']}/ directory under {root}")
        return 1
    if args.action == "apply":
        for line in integration_apply(data, root, args.force):
            say(line)
    lines, drift = integration_check(data, root)
    for line in lines:
        say(line)
    for finding in drift:
        say("  drift: " + finding)
    say(f"{data['id']}: {len(drift)} drift finding(s) in {root}")
    return 1 if drift else 0


def cmd_compatibility(args):
    """One command shows both levels: the client's status and, beside it, the per-capability
    state derived from that runtime's adapter. Neither is hand-written twice."""
    data = compatibility.catalog(REPO)
    clients = [dict(row, capabilities=compatibility.capability_states(REPO, data, row),
                    tier_restriction=compatibility.tier_restriction(REPO, row))
               for row in data["clients"]]
    if args.json:
        print(json.dumps(dict(data, clients=clients), indent=2))
    else:
        say("Model provider and agent runtime are separate from the client you run.")
        for client in clients:
            say(client["id"] + ": " + client["status"])
            for name, capability in client["capabilities"].items():
                say("  " + name + ": " + capability["state"]
                    + (" (" + ", ".join(capability["cases"]) + ")" if capability["cases"] else ""))
            say("  tier restriction: " + client["tier_restriction"]["state"]
                + (" (" + client["tier_restriction"]["mechanism"] + ")"
                   if client["tier_restriction"]["mechanism"] else ""))
        for limitation in data["limitations"]:
            say(limitation)
        if compatibility.source_drift(REPO, data):
            say("Current runtime source differs from this released qualification; qualify it before release.")
    if args.release_check:
        errors = compatibility.release_errors(REPO)
        for error in errors:
            print("release blocked: " + error, file=sys.stderr)
        return 1 if errors else 0
    return 0


def cmd_freeze(args):
    """Print the drift check a release handoff otherwise records by hand."""
    try:
        data = compatibility.freeze_record(REPO)
        result = compatibility.freeze_drift(REPO, data, args.against)
        refusals = compatibility.merge_refusal(REPO, data, args.merge_check) if args.merge_check else []
    except (OSError, ValueError) as exc:
        print("freeze: " + str(exc), file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(dict(result, merge_check=args.merge_check, refusals=refusals), indent=2))
    elif result["state"] != "frozen":
        say("No release branch is frozen; qualify on a release branch cut at the freeze commit.")
    else:
        say(result["branch"] + " is frozen at " + result["commit"][:12] + "; compared with " + result["ref"])
        say(result["stat"] or "  no runtime source change; this round's evidence still describes " + result["ref"])
    for refusal in refusals:
        print("freeze: merge refused: " + refusal, file=sys.stderr)
    if refusals:
        return 1
    return 1 if result["paths"] else 0


def cmd_task(args):
    root = tasks.repository(Path(args.path or Path.cwd()))
    if args.action == "save":
        if not args.input:
            raise SystemExit("task save requires --input with a task contract JSON file")
        try:
            result = tasks.save(root, json.loads(Path(args.input).read_text()), args.runtime, args.revision)
        except ValueError as exc:
            # The concurrency guard is a routine refusal, not a crash: every other refusal in this
            # CLI is one line, and a traceback here would print the checkout path as well.
            raise SystemExit(str(exc))
    else:
        result = tasks.read(root)
    print(json.dumps(result, indent=2))
    return 0


def cmd_role(args):
    state = home() / ".local/state/agent-harness/workers"
    try:
        if args.action == "status":
            records = workers.status(state, args.name)
            print(json.dumps(records, indent=2))
            for record in records:
                if record.get("status") == "orphaned":
                    print("role worker " + str(record.get("id")) + ": " + workers.ORPHANED, file=sys.stderr)
            return 0
        if not args.name or not args.runtime or not args.prompt_file:
            raise ValueError("role run requires a role, --runtime and --prompt-file (use - for stdin)")
        if args.prompt_file == "-":
            prompt = sys.stdin.read(workers.LIMIT + 1)
        else:
            if not Path(args.prompt_file).is_file():
                raise ValueError("--prompt-file must name a regular file")
            with Path(args.prompt_file).open(encoding="utf-8") as stream:
                prompt = stream.read(workers.LIMIT + 1)
        record = workers.run(REPO, load_config(), args.runtime, args.name, args.workspace, prompt, state,
                             model=args.model, artifact=args.artifact, timeout=args.timeout, read_dirs=args.read_dir)
        print(json.dumps(record, indent=2))
        return int(record["status"] != "completed")
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print("role worker: " + str(exc), file=sys.stderr)
        return 1


DEFAULT_EVAL_REPORT = "jev-eval.json"


def _eval_client(args, jev, evaluation, cfg):
    """`(client, allowlist, budget, source)` for this run. Only `--live` may reach the network.

    A live run is refused without a request ceiling, and it sends under the user's own
    `governance.jev.state_fields`: an evaluation that could send a field no hook is allowed to
    send would be a way round the allowlist rather than a measurement of the provider.
    """
    if args.live and args.replay:
        raise SystemExit("--replay and --live are two sources for one run; name one")
    if not args.live:
        if not args.replay:
            raise SystemExit("decisions eval needs --replay FILE, or --live with a budget")
        # `shadow_controls` and not the user's: a replay makes no request, so the kill switch
        # and the outbound allowlist have nothing to gate. What the state may carry is still
        # the provider's own builder, and the recorded request hashes are keyed to it.
        return (jev.ReplayClient.from_file(args.replay),
                evaluation.shadow_controls(),
                jev.Budget(),
                {"client": "replay", "replay": str(args.replay)})
    if not args.max_requests:
        raise SystemExit("decisions eval --live needs --max-requests N; a live run without a "
                         "ceiling is an unbounded bill against a service this repository has "
                         "never called")
    if args.budget_usd is not None and args.usd_per_mtok is None:
        raise SystemExit("--budget-usd needs --usd-per-mtok: no price for this provider is "
                         "published in this repository, so dollars cannot be turned into a "
                         "token ceiling without one")
    tokens = args.max_tokens
    if args.budget_usd is not None:
        tokens = int(args.budget_usd / args.usd_per_mtok * 1e6)
    configured = decision_controls.Controls.from_config(cfg)
    if not configured.state_fields:
        raise SystemExit("governance.jev.state_fields is empty, so every request this run made "
                         "would carry the same four base fields and differ in nothing; set the "
                         "allowlist a hook would send under before measuring one")
    if configured.disabled():
        raise SystemExit("the jev kill switch is in place at " + str(configured.sentinel_path())
                         + "; remove it before making live requests")
    allowlist = evaluation.shadow_controls(state_fields=configured.state_fields, configured=True,
                                           timeout=configured.timeout,
                                           max_requests=args.max_requests, max_tokens=tokens)
    return (jev.JevClient(live=True, timeout=configured.timeout),
            allowlist,
            jev.Budget(args.max_requests, tokens),
            {"client": "live", "max_requests": args.max_requests, "max_tokens": tokens,
             "state_fields": list(configured.state_fields)})


def cmd_decisions(args: argparse.Namespace) -> int:
    """`decisions eval`: replay the decision log through a versioned pack and report the fit.

    The provider is only imported here. Reading the report of an opt-in network provider must
    not be the thing that loads it, and `--replay` never opens a socket at all.
    """
    from harness_core.decisions import evaluation, jev, packs
    module = load_hook_module("decisions")
    if module is None:
        raise SystemExit("this checkout has no claude/hooks/decisions.py; reinstall or re-clone it")
    if args.bins < 1:
        raise SystemExit("--bins is the number of confidence bins and is at least 1")
    if not 0 < args.dev_share < 1:
        raise SystemExit("--dev-share is a fraction strictly between 0 and 1")
    log = Path(args.log) if args.log else state_dir() / "decisions.jsonl"
    rows = module.joined(module.read_rows(log))
    out = Path(args.out) if args.out else state_dir() / DEFAULT_EVAL_REPORT
    cfg = load_config()
    try:
        pack = packs.resolve(args.pack)
        client, allowlist, budget, source = _eval_client(args, jev, evaluation, cfg)
        data = evaluation.report(rows, client, pack, point=args.point, dev_share=args.dev_share,
                                 bins=args.bins, repeats=args.repeat, allowlist=allowlist,
                                 budget=budget, usd_per_mtok=args.usd_per_mtok,
                                 source=dict(source, log=str(log)))
    except (evaluation.EvalError, jev.PackError, decisions_provider.PolicyError, OSError) as exc:
        print("decisions eval: " + str(exc), file=sys.stderr)
        return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    evaluation.write(data, out)
    for line in evaluation.render(data, args.split):
        say(line)
    say("report: " + str(out))
    return 0


def cmd_tiers(args: argparse.Namespace) -> int:
    """Check each adapter's class table against the model catalog its provider publishes."""
    cfg = load_config()
    try:
        _, claude = primitive_catalog.adapter_tiers(REPO, "claude-code", cfg.get("tiers", {}).get("claude-code"))
        _, codex = primitive_catalog.adapter_tiers(REPO, "codex", cfg.get("tiers", {}).get("codex"))
    except ValueError as exc:
        print("tiers: " + str(exc), file=sys.stderr)
        return 1
    say("claude-code: " + ", ".join(claude.values()) + " — version-free aliases, nothing to go stale")
    cache = codex_dir() / "models_cache.json"
    try:
        models = json.loads(cache.read_text(encoding="utf-8"))["models"]
    except (OSError, ValueError, KeyError, TypeError):
        say("codex: unverified — no readable model catalog at " + str(cache) + "; run Codex once to fetch it")
        return 0
    findings = primitive_catalog.tier_findings(codex, models)
    for name, model, problem in findings:
        say("codex: " + name + " -> " + model + ": " + problem)
    if not findings:
        say("codex: " + ", ".join(codex.values()) + " — current in the catalog")
    return 1 if findings else 0


def program_name(argv0: Optional[str] = None) -> str:
    """The name usage text shows: `citizen` or its alias `harness` as invoked, else `citizen`."""
    name = os.path.basename(sys.argv[0] if argv0 is None else argv0)
    return name if name in ("citizen", "harness") else "citizen"


