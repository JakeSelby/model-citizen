    create.add_argument("name")
    create.add_argument("repo", nargs="?")
    create.add_argument("--branch")
    create.add_argument("--base", default="origin/main")
    create.add_argument("--no-fetch", action="store_true")
    create.set_defaults(func=cmd_worktree)
    audit = worktree_sub.add_parser("audit", help="report clean, dirty, detached, and stale worktrees")
    audit.add_argument("repo", nargs="?")
    audit.set_defaults(func=cmd_worktree)
    remove = worktree_sub.add_parser("remove", help="remove a clean managed task checkout")
    remove.add_argument("name")
    remove.add_argument("repo", nargs="?")
    remove.add_argument("--merged", action="store_true",
                        help="delete the local branch too, once a merged pull request holds its tip")
    remove.add_argument("--also-clear", action="append", metavar="NAME", default=[],
                        help="one more top-level ignored directory that does not block removal; repeatable")
    remove.set_defaults(func=cmd_worktree)

    p = sub.add_parser("remote-control", help="keep a Claude Code Remote Control server running per configured folder (macOS)")
    rc_sub = p.add_subparsers(dest="action", required=True)
    rc_install = rc_sub.add_parser("install", help="write and load one launchd agent per remote_control.folders entry")
    rc_install.add_argument("--dry-run", action="store_true")
    rc_install.set_defaults(func=cmd_remote_control)
    rc_sub.add_parser("status", help="report each configured folder's agent").set_defaults(func=cmd_remote_control)
    rc_sub.add_parser("uninstall", help="unload and remove every agent").set_defaults(func=cmd_remote_control)
    rc_heal = rc_sub.add_parser("heal", help="refresh each running host's bridge pointer so a relaunch re-adopts its sessions")
    rc_heal.add_argument("--once", action="store_true", help="one pass and exit (what the launchd agent runs)")
    rc_heal.add_argument("--dry-run", action="store_true", help="report what would change, write nothing")
    rc_heal.add_argument("--preserve-worktrees", action="store_true",
                         help="WIP-commit dirty bridge-cse_* worktrees so host cleanup cannot delete them")
    rc_heal.set_defaults(func=cmd_remote_control_heal)

    p = sub.add_parser("init", help="write the config file by answering questions")
    p.add_argument("--force", action="store_true", help="replace an existing config file")
    p.add_argument("--yes", action="store_true",
                   help="ask nothing: take the defaults, for a scripted first run")
    p.add_argument("--preset", choices=sorted(STANCE_PRESETS), help="stance preset for --yes")
    p.add_argument("--name", help="identity.name for --yes (default: git config user.name)")
    p.add_argument("--role", help="identity.role for --yes")
    p.add_argument("--github", help="identity.github for --yes (default: the gh login)")
    p.add_argument("--timezone", help="identity.timezone for --yes (default: detected)")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("config", help="read or write one config value, e.g. `config get identity.name`")
    p.add_argument("action", choices=["get", "set"])
    p.add_argument("key")
    p.add_argument("value", nargs="?")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("import", help="read an existing CLAUDE.md, AGENTS.md or .cursorrules into "
                                      "primitives under an external root")
    p.add_argument("path", help="the instruction file to split; never executed")
    p.add_argument("--root", help="absolute external primitive root to write into "
                                  "(default ~/.config/agent-harness/imported/NAME)")
    p.add_argument("--name", help="identifier for the import; default is the directory it came from")
    p.add_argument("--dry-run", action="store_true", help="print the plan and the sync projection only")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("integrations", help="inspect or register interchangeable implementation adapters")
    p.add_argument("action", choices=["show", "register", "doctor"])
    p.add_argument("capability", nargs="?", default=integrations.CAPABILITY)
    p.add_argument("--file", help="registration JSON containing id and descriptor")
    p.add_argument("--json", action="store_true", help="emit JSON (the default)")
    p.add_argument("--timeout", type=float, default=30)
    p.set_defaults(func=cmd_integrations)

    p = sub.add_parser("viewer", help="invoke the selected viewer; existing sessions retain their adapter")
    p.add_argument("action", choices=sorted(integrations.OPERATIONS))
    p.add_argument("--input", help="operation input JSON; no executable selection")
    p.add_argument("--session", help="pinned harness session reference UUID")
    p.add_argument("--implementation", choices=["builtin", "custom"])
    p.add_argument("--adapter", help="registered adapter for a new custom session")
    p.add_argument("--request-id", help="idempotency UUID; retain it when inspecting an uncertain result")
    p.add_argument("--timeout", type=float, default=30)
    p.set_defaults(func=cmd_viewer)

    p = sub.add_parser("integration", help="check or apply a declared framework integration's override templates in a repository (default: the current repo)")
    p.add_argument("action", choices=["check", "apply"])
    p.add_argument("name", help="the integration id declared in policy/integrations/")
    p.add_argument("path", nargs="?")
    p.add_argument("--force", action="store_true", help="apply: replace an override that differs from the template")
    p.set_defaults(func=cmd_integration)

    # Kept because it is the surface users already know; it names the integration for them.
    p = sub.add_parser("bmad", help="alias for `citizen integration check|apply bmad`")
    p.add_argument("action", choices=["check", "apply"])
    p.add_argument("path", nargs="?")
    p.add_argument("--force", action="store_true", help="apply: replace an override that differs from the template")
    p.set_defaults(func=cmd_integration, name="bmad")

    p = sub.add_parser("compatibility", help="show versioned native qualification and adapter gaps")
    p.add_argument("--json", action="store_true")
    p.add_argument("--release-check", action="store_true", help="fail unless every release target has native evidence")
    p.set_defaults(func=cmd_compatibility)

    p = sub.add_parser("freeze", help="show runtime source drift from the frozen release commit")
    p.add_argument("--json", action="store_true")
    p.add_argument("--against", default="origin/main", help="revision to compare the frozen commit with")
    p.add_argument("--merge-check", metavar="REF",
                   help="fail when merging REF into the frozen branch would change the qualified source")
    p.set_defaults(func=cmd_freeze)

    p = sub.add_parser("task", help="save or inspect a shared task continuation contract")
    p.add_argument("action", choices=["save", "show"])
    p.add_argument("path", nargs="?")
    p.add_argument("--input", metavar="FILE", help="path to a JSON task contract; never executed")
    p.add_argument("--runtime", choices=["claude-code", "codex"], default=os.environ.get("HARNESS_RUNTIME", "codex"))
    p.add_argument("--revision", type=int, default=0, help="expected current revision; rejects stale writers")
    p.set_defaults(func=cmd_task)

    p = sub.add_parser("role", help="run a constrained shared role in an isolated CLI worker, or inspect worker status")
    p.add_argument("action", choices=["run", "status"])
    p.add_argument("name", nargs="?", help="run: shared role name; status: optional worker id")
    p.add_argument("--runtime", choices=["claude-code", "codex"])
    p.add_argument("--workspace", default=str(Path.cwd()), help="project to inspect read-only")
    p.add_argument("--read-dir", action="append", default=[], help="additional directory containing input artifacts")
    p.add_argument("--prompt-file", help="brief file, or - for stdin; its content is never executed")
    p.add_argument("--model", help="override the model the role's class resolves to; required only when the adapter maps none")
    p.add_argument("--artifact", help="artifact-write roles only: new Markdown filename under .agent-harness/plans/")
    p.add_argument("--timeout", type=int, default=300, help="worker deadline in seconds (1–3600)")
    p.set_defaults(func=cmd_role)

    p = sub.add_parser("decisions", help="evaluate a decision provider against the recorded decision log")
    decisions_sub = p.add_subparsers(dest="action", required=True)
    ev = decisions_sub.add_parser("eval", help="replay labelled decision-log rows through a versioned question pack")
    ev.add_argument("--point", choices=list(decision_controls.POINTS), help="one decision point (default: every point in the log)")
    ev.add_argument("--split", choices=["dev", "heldout"], default="heldout", help="which split the printed rates come from; only held-out is evidence, and the file carries both")
    ev.add_argument("--replay", help="a recorded fixture of responses keyed by request hash; no socket is opened")
    ev.add_argument("--live", action="store_true", help="call the service instead of replaying; needs --max-requests")
    ev.add_argument("--max-requests", type=int, help="ceiling on live requests")
    ev.add_argument("--max-tokens", type=int, help="ceiling on live tokens")
    ev.add_argument("--budget-usd", type=float, help="ceiling in dollars; needs --usd-per-mtok")
    ev.add_argument("--usd-per-mtok", type=float, help="the price this run is costed at, per million tokens")
    ev.add_argument("--log", help="the decision log to read (default: the recorded one)")
    ev.add_argument("--pack", help="pack id or id:version (default: the newest decision pack)")
    ev.add_argument("--out", help="where the report is written")
    ev.add_argument("--dev-share", type=float, default=0.5, help="fraction of cases in the dev split, strictly between 0 and 1")
    ev.add_argument("--bins", type=int, default=10, help="confidence bins in the calibration table")
    ev.add_argument("--repeat", type=int, default=1, help="replay passes, for the flip rate")
    ev.set_defaults(func=cmd_decisions)

    p = sub.add_parser("tiers", help="check the adapters' class-to-model tables against their providers' model catalogs")
    p.add_argument("action", choices=["check"])
    p.set_defaults(func=cmd_tiers)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
