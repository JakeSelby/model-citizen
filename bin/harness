    p = sub.add_parser("upgrade", help="move a Claude Code plugin install from its pre-rename ID to the current one")
    p.add_argument("--dry-run", action="store_true", help="print the `claude plugin` commands without running them")
    p.set_defaults(func=cmd_upgrade)

    p = sub.add_parser("uninstall", help="remove links and owned settings, restore adopted files")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("lint", help="scan for personal-data shapes, lint terms, secret patterns, and the context cap")
    p.add_argument("path", nargs="?")
    p.add_argument("--staged", action="store_true", help="only the files staged in git (used by the pre-commit hook)")
    p.set_defaults(func=cmd_lint)

    p = sub.add_parser("usage", help="summarize recorded session tokens and cache hit rate")
    p.add_argument("action", nargs="?", choices=["export"],
                   help="export: replay recorded rows to the configured OTLP endpoint")
    p.add_argument("--since", help="with export, the first day to replay, as YYYY-MM-DD")
    p.add_argument("--until", help="with export, the last day to replay, as YYYY-MM-DD")
    p.add_argument("--dry-run", action="store_true",
                   help="with export, count what would be sent and open no connection")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("--by", choices=["day", "repo", "model", "role", "rule", "stance", "decision",
                                    "provider", "prefix", "profile"],
                   default="day")
    p.add_argument("--stance", choices=STANCE_NAMES,
                   help="with --by stance, the dimension whose variants group the tokens")
    p.add_argument("--rules", action="store_true",
                   help="report rule-detector hits instead of tokens (--by rule, repo or stance)")
    p.add_argument("--rescan", action="store_true", help="re-read transcripts from the window first, then report")
    p.add_argument("--conflicts", action="store_true",
                   help="landing merge conflicts and intent overlaps per week, from the decision log")
    p.set_defaults(func=cmd_usage)

    p = sub.add_parser("intent", help="claim the paths this session will write, so a sibling's overlap is caught")
    intent_sub = p.add_subparsers(dest="intent_action", required=True)
    q = intent_sub.add_parser("claim", help="claim paths or globs, existing or planned, in this worktree")
    q.add_argument("paths", nargs="+")
    q.add_argument("--session", help="session id (default: the runtime's)")
    q.add_argument("--pid", type=int, help="runtime process id (default: detected)")
    q = intent_sub.add_parser("release", help="drop this session's claim")
    q.add_argument("--session")
    q = intent_sub.add_parser("check", help="exit 1 when a path overlaps a live sibling's claim (default: changed files)")
    q.add_argument("paths", nargs="*")
    q.add_argument("--session")
    q = intent_sub.add_parser("list", help="live claims in this repository")
    q.add_argument("--all", action="store_true", help="every repository")
    intent_sub.add_parser("sweep", help="remove claims whose process is dead")
    q = intent_sub.add_parser("merge", help="record whether merging the base branch conflicted, for usage --conflicts")
    q.add_argument("result", nargs="?", choices=list(intents.MERGE_RESULTS),
                   help="the observed result (default: probe with git merge-tree)")
    q.add_argument("--base", default="origin/main")
    p.set_defaults(func=lambda a: intents.command(a, say))

