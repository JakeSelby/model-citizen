{
  "schema_version": 1,
  "suites": [
    {
      "id": "unit-tests",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "unit-tests", "--root", "{param:root}", "--case", "{param:case}"],
      "parameters": {
        "root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096},
        "case": {"kind": "pattern", "pattern": "^(all|[A-Za-z0-9_.]+)$", "max_length": 512, "default": "all"}
      },
      "cost_class": "free",
      "expected_duration_seconds": 300,
      "timeout_seconds": 1800,
      "targets": ["installed"],
      "cases": []
    },
    {
      "id": "lint",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "lint", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 5,
      "timeout_seconds": 120,
      "targets": ["installed"],
      "cases": ["lint"]
    },
    {
      "id": "static-context",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "static-context", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 5,
      "timeout_seconds": 120,
      "targets": ["installed"],
      "cases": ["static-context"]
    },
    {
      "id": "detector-corpus",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "detector-corpus", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 15,
      "timeout_seconds": 180,
      "targets": ["installed"],
      "cases": ["detector-corpus"]
    },
    {
      "id": "lifecycle-acceptance",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "lifecycle-acceptance", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 30,
      "timeout_seconds": 600,
      "targets": ["installed"],
      "cases": ["lifecycle-acceptance"]
    },
    {
      "id": "native-acceptance",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.native_runner", "--root", ".", "--source-commit", "{param:source_commit}", "--client", "{param:client}", "--cases", "{param:cases}", "--model", "{param:model}", "--progress-id", "{param:progress_id}", "--progress", "{param:progress}", "--out", "{param:out}", "--retry-source", "{param:retry_source}", "--retry-case", "{param:retry_case}"],
      "parameters": {
        "source_commit": {"kind": "pattern", "pattern": "^(?:[0-9a-f]{40}|resolve-at-launch)$", "max_length": 40},
        "client": {"kind": "pattern", "pattern": "^[a-z0-9-]{1,64}$", "max_length": 64},
        "cases": {"kind": "pattern", "pattern": "^[a-z0-9-]+(?:,[a-z0-9-]+)*$", "max_length": 4096},
        "model": {"kind": "pattern", "pattern": "^[A-Za-z0-9._:/+-]{1,200}$", "max_length": 200},
        "progress_id": {"kind": "pattern", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "max_length": 64},
        "progress": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096},
        "out": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096},
        "retry_source": {"kind": "pattern", "pattern": "^(?:fresh|[a-z0-9][a-z0-9-]{0,63})$", "max_length": 64},
        "retry_case": {"kind": "pattern", "pattern": "^(?:fresh|[a-z0-9-]{1,64})$", "max_length": 64}
      },
      "cost_class": "spends_usage",
      "expected_duration_seconds": 900,
      "timeout_seconds": 7200,
      "targets": ["installed", "release", "branch", "worktree", "draft"],
      "cases": ["native-acceptance"]
    }
  ]
}
