{
  "schema_version": 1,
  "suites": [
    {
      "id": "unit-tests",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "unit-tests", "--root", "{param:root}", "--case", "{param:case}"],
      "parameters": {
        "root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096},
        "case": {"kind": "pattern", "pattern": "^(all|[A-Za-z0-9_.]+)$", "max_length": 512, "default": "all"}
      },
      "cost_class": "free",
      "expected_duration_seconds": 300,
      "timeout_seconds": 1800,
      "targets": ["installed"],
      "cases": []
    },
    {
      "id": "lint",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "lint", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 5,
      "timeout_seconds": 120,
      "targets": ["installed"],
      "cases": ["lint"]
    },
    {
      "id": "static-context",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "static-context", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 5,
      "timeout_seconds": 120,
      "targets": ["installed"],
      "cases": ["static-context"]
    },
    {
      "id": "detector-corpus",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "detector-corpus", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 15,
      "timeout_seconds": 180,
      "targets": ["installed"],
      "cases": ["detector-corpus"]
    },
    {
      "id": "lifecycle-acceptance",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.free_suites", "lifecycle-acceptance", "--root", "{param:root}"],
      "parameters": {"root": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}},
      "cost_class": "free",
      "expected_duration_seconds": 30,
      "timeout_seconds": 600,
      "targets": ["installed"],
      "cases": ["lifecycle-acceptance"]
    },
    {
      "id": "native-acceptance",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.native_runner", "--root", ".", "--source-commit", "{param:source_commit}", "--client", "{param:client}", "--cases", "{param:cases}", "--model", "{param:model}", "--progress-id", "{param:progress_id}", "--progress", "{param:progress}", "--out", "{param:out}", "--retry-source", "{param:retry_source}", "--retry-case", "{param:retry_case}"],
      "parameters": {
        "source_commit": {"kind": "pattern", "pattern": "^(?:[0-9a-f]{40}|resolve-at-launch)$", "max_length": 40},
        "client": {"kind": "pattern", "pattern": "^[a-z0-9-]{1,64}$", "max_length": 64},
        "cases": {"kind": "pattern", "pattern": "^[a-z0-9-]+(?:,[a-z0-9-]+)*$", "max_length": 4096},
        "model": {"kind": "pattern", "pattern": "^[A-Za-z0-9._:/+-]{1,200}$", "max_length": 200},
        "progress_id": {"kind": "pattern", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "max_length": 64},
        "progress": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096},
        "out": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096},
        "retry_source": {"kind": "pattern", "pattern": "^(?:fresh|[a-z0-9][a-z0-9-]{0,63})$", "max_length": 64},
        "retry_case": {"kind": "pattern", "pattern": "^(?:fresh|[a-z0-9-]{1,64})$", "max_length": 64}
      },
      "cost_class": "spends_usage",
      "expected_duration_seconds": 900,
      "timeout_seconds": 7200,
      "targets": ["installed", "release", "branch", "worktree", "draft"],
      "cases": ["native-acceptance"]
    },
    {
      "id": "live-replay",
      "version": 1,
      "argv": ["python3", "-m", "harness_core.studio.replay_runner", "--request-json", "{param:request_json}", "--repository", "{param:repository}"],
      "parameters": {
        "request_json": {"kind": "pattern", "pattern": "^\\{.+\\}$", "max_length": 4096},
        "repository": {"kind": "pattern", "pattern": "^/.+$", "max_length": 4096}
      },
      "cost_class": "spends_usage",
      "expected_duration_seconds": 3600,
      "timeout_seconds": 21600,
      "targets": ["branch", "draft", "installed", "release", "worktree"],
      "cases": []
    },
    {
      "id": "rule-detection",
      "version": 1,
      "argv": [
        "python3",
        "-m",
        "harness_core.studio.eval_tiers",
        "rule-detection",
        "--root",
        "{param:root}",
        "--raw",
        "{param:raw}"
      ],
      "parameters": {
        "root": {
          "kind": "pattern",
          "pattern": "^/.+$",
          "max_length": 4096
        },
        "raw": {
          "kind": "pattern",
          "pattern": "^/.+$",
          "max_length": 4096
        }
      },
      "cost_class": "free",
      "expected_duration_seconds": 30,
      "timeout_seconds": 600,
      "targets": [
        "installed"
      ],
      "cases": [
        "rule-detection"
      ]
    },
    {
      "id": "hook-matrix",
      "version": 1,
      "argv": [
        "python3",
        "-m",
        "harness_core.studio.eval_tiers",
        "hook-matrix",
        "--root",
        "{param:root}"
      ],
      "parameters": {
        "root": {
          "kind": "pattern",
          "pattern": "^/.+$",
          "max_length": 4096
        }
      },
      "cost_class": "free",
      "expected_duration_seconds": 60,
      "timeout_seconds": 600,
      "targets": [
        "installed"
      ],
      "cases": [
        "hook-matrix"
      ]
    },
    {
      "id": "micro-tier",
      "version": 1,
      "argv": [
        "python3",
        "-m",
        "harness_core.studio.eval_tiers",
        "micro-tier",
        "--repository",
        "{param:repository}",
        "--revision",
        "{param:revision}"
      ],
      "parameters": {
        "repository": {
          "kind": "pattern",
          "pattern": "^/.+$",
          "max_length": 4096
        },
        "revision": {
          "kind": "pattern",
          "pattern": "^[0-9a-f]{40}$",
          "max_length": 40
        }
      },
      "cost_class": "spends_usage",
      "expected_duration_seconds": 1800,
      "timeout_seconds": 14400,
      "targets": [
        "branch",
        "draft",
        "installed",
        "release",
        "worktree"
      ],
      "cases": [
        "micro-tier"
      ]
    },
    {
      "id": "unit-eval",
      "version": 1,
      "argv": [
        "python3",
        "-m",
        "harness_core.studio.eval_tiers",
        "unit-eval",
        "--repository",
        "{param:repository}",
        "--revision",
        "{param:revision}",
        "--unit",
        "{param:unit}",
        "--model",
        "{param:model}"
      ],
      "parameters": {
        "repository": {
          "kind": "pattern",
          "pattern": "^/.+$",
          "max_length": 4096
        },
        "revision": {
          "kind": "pattern",
          "pattern": "^[0-9a-f]{40}$",
          "max_length": 40
        },
        "unit": {
          "kind": "pattern",
          "pattern": "^rules\\.[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "max_length": 134
        },
        "model": {
          "kind": "pattern",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,199}$",
          "max_length": 200
        }
      },
      "cost_class": "spends_usage",
      "expected_duration_seconds": 3600,
      "timeout_seconds": 43200,
      "targets": [
        "branch",
        "draft",
        "installed",
        "release",
        "worktree"
      ],
      "cases": [
        "unit-eval"
      ]
    }
  ]
}
